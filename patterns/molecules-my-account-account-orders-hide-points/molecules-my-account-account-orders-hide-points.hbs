<h3 class="text-md md:text-lg font-semibold uppercase mr-3 mb-10">{{Label}}<span class="to-md:hidden">:</span></h3>
<div class="xl:flex xl:mb-50">
  {{#each Recent}}
    <div class="mb-30 xl:w-1_2">
      {{#with Date}}
        <p class="text-gray-120">
          {{Label}}: <span class="font-medium text-green-100 font-semibold">{{Date}}</span>
        </p>
      {{/with}}

      <p class="font-medium text-gray-150">
        {{#each Details}}
          <span aria-label="{{AriaText}}">{{Text}}</span>
          {{#unless @last}}<span class="text-sm mx-4" aria-hidden="true">|</span>{{/unless}}
        {{/each}}
      </p>

      {{#with Status}}
        <p class="text-gray-100 text-md italic">{{.}}</p>
      {{/with}}

      {{#with Arrival}}
        <p class="text-gray-150">
          {{Label}}: <span class="font-medium font-semibold">{{Date}}</span>
        </p>
      {{/with}}

      {{#with TrackCode}}
        {{#if MultipleTrackCodes}}
          <div class="mt-10 {{#if IsFirstEmpty}} -hidden-first {{/if}}" data-tracking-select>
            {{> atoms-select}}
          </div>
        {{else}}
          <p class="text-gray-150">
            {{Label}}: <span class="font-medium text-green-100 font-semibold">{{{Code}}}</span>
          </p>
        {{/if}}
      {{/with}}

      {{#with TrackCta}}
        {{> (lookup . "Partial")}}
      {{/with}}
    </div>

  {{else}}{{!-if empty --}}
    <span class="text-gray-100 text-md italic">{{EmptyText}}</span>
  {{/each}}
</div>