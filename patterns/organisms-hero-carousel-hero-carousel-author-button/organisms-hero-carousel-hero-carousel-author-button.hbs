<section>
  <div class="o-heroCarousel">
    <div class="o-heroCarousel__actions">
      <div class="o-heroCarousel__dots">
        <button class="o-heroCarousel__playPause" type="button" data-play-pause data-gtm-playpause='{"gtmId": 23, "gtmText": "Play/Pause"}' data-testid="button-heroCarouselPause">
          <span class="o-heroCarousel__label sr-only" data-label-stop="{{StopAutomaticSlideShow}}" data-label-start="{{StartAutomaticSlideShow}}" data-label-carousel="{{CarouselDescription}}">
          </span>
        </button>
      </div>
    </div>
    <div class="o-heroCarousel__slider" id="carousel-{{UniqueID}}" data-speed="{{AutoPlaySpeed}}">
      {{#each Slides}}
        {{#if ../IsCarouselWithBg}}
          {{#if LargeBanner}}
            {{> molecules-cmn-large-banner }}
          {{/if}}
        {{else}}
          {{#if ../IsPremiumStampEnabled}}
            {{#with CmnFullWidthBanner}}
              {{#> atoms-badge}}
                {{> molecules-cmn-full-width-banner }}
              {{/atoms-badge}}
            {{/with}}
          {{else}}
            {{#if FWBanner.Has.VideoToggle}}
              {{> molecules-full-width-banner-vue-video }}
            {{else}}
              {{> molecules-cmn-full-width-banner }}
            {{/if}}
          {{/if}}
        {{/if}}
      {{/each}}

    </div>
    <div class="o-heroCarousel__arrows" data-gtm-id="{{GtmId}}" data-next-text="{{NextText}}" data-previous-text="{{PreviousText}}" data-arrow-color="{{ArrowColor}}" data-arrow-size="{{ArrowSize}}" data-testid="container-heroCarouselArrows">
    </div>
  </div>
</section>

{{!-- This is for showing Premium Badge Modal --}}
{{#if BadgeModal}}
  {{#with BadgeModal}}
    {{> organisms-badge-modal}}
  {{/with}}
{{/if}}