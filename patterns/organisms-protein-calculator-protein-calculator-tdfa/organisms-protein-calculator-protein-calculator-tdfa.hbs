<div class="o-proteinCalc" data-is-tdfa="{{ProteinCalculatorForm.IsTdfa}}">
  <h2 class="o-proteinCalc__title">{{{Title}}}</h2>
  <p class="o-proteinCalc__description">{{{Description}}}</p>
  <div class="o-proteinCalc__content">
    <img class="o-proteinCalc__image" src={{Image}} />
    <form id="proteinCalculatorForm" class="o-proteinCalc__form" name="proteinCalculatorForm" action="" method="post">
      {{#ProteinCalculatorForm.GoalDropdown}}
        {{> molecules-form-field-select}}
      {{/ProteinCalculatorForm.GoalDropdown}}
      {{#ProteinCalculatorForm.PreferenceDropdown}}
        {{> molecules-form-field-select}}
      {{/ProteinCalculatorForm.PreferenceDropdown}}
      <div class="o-proteinCalc__inputHalf">
        {{#ProteinCalculatorForm.AgeDropdown}}
          {{> molecules-form-field-select}}
        {{/ProteinCalculatorForm.AgeDropdown}}
        {{#ProteinCalculatorForm.WeightInput }}
          {{> molecules-form-field-basic }}
        {{/ProteinCalculatorForm.WeightInput}}
      </div>
      <div>
        {{#ProteinCalculatorForm.CTA}}
          {{> atoms-button}}
        {{/ProteinCalculatorForm.CTA}}
      </div>
      <div class="o-proteinCalc__wrapper" aria-live="assertive">
        <div class="o-proteinCalc__error -dropdown hidden">
          <p>{{{ProteinCalculatorForm.EmptyFieldMessage}}}</p>
        </div>
        <div class="o-proteinCalc__error -number hidden">
          <p>{{{ProteinCalculatorForm.ErrorNumberMessage}}}</p>
        </div>
      </div>
      <div class="o-proteinCalc__wrapper" aria-live="polite">
        <div class="o-proteinCalc__result {{#if ProteinCalculatorForm.WeightInput.Metric}}-metric{{else}}-imperial{{/if}} hidden" role="text">
          <p class="o-proteinCalc__text -protein">{{{ProteinCalculatorForm.Results.Protein}}}</p>
          <p class="o-proteinCalc__text -recommended" id="elevateProtein">{{{ProteinCalculatorForm.Results.ElevateProtein}}}</p>
          <p class="o-proteinCalc__text -recommended" id="proflex">{{{ProteinCalculatorForm.Results.Proflex}}}</p>
          <p class="o-proteinCalc__text -recommended" id="veganProtein">{{{ProteinCalculatorForm.Results.VeganProtein}}}</p>
        </div>
      </div>

    </form>
  </div>

</div>