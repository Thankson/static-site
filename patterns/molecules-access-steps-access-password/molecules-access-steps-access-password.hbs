<m-access-password confirm-password-placeholder="{{ConfirmPasswordField.Placeholder}}" new-password-placeholder="{{NewPasswordField.Placeholder}}" :password-criteria='{{toJson PasswordCriteria}}' :handler="() => true">

  <template v-slot:heading>
    {{{Title}}}
  </template>

  <template v-slot:new-password-label>
    {{{NewPasswordField.Label}}}
  </template>

  <template v-slot:new-password-error>
    {{{NewPasswordField.ErrorMessage}}}
  </template>

  <template v-slot:criteria-error>
    {{{NewPasswordField.CriteriaError}}}
  </template>

  <template v-slot:confirm-password-label>
    {{{ConfirmPasswordField.Label}}}
  </template>

  <template v-slot:confirm-password-error>
    {{{ConfirmPasswordField.ErrorMessage}}}
  </template>

  <template v-slot:match-error>
    {{{ConfirmPasswordField.MatchError}}}
  </template>

  <template v-slot:api-error>
    {{{ApiErrorMessage}}}
  </template>

  <template v-slot:button-label>
    {{Button.CTA}}
  </template>

  <template v-slot:skip-text>
    {{SkipText}}
  </template>

  <template v-slot:skip-tooltip>
    {{SkipTooltip}}
  </template>

  {{#if Note}}
    <template v-slot:note>
      {{{Note}}}
    </template>
  {{/if}}
</m-access-password>