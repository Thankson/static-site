<section class="o-resourcesCarousel">
  {{#if Title}}
    <h2 class="o-resourcesCarousel__title">
      {{ Title }}
    </h2>
  {{/if}}
  <div class="o-resourcesCarousel__wrapper {{ CarouselType }}" aria-label="{{ CarouselAdaDescription }}" role="complementary" aria-roledescription="{{ Labels.Carousel }}">
    <!--Support labels for ADA-->
    {{> organisms-cmn-card-carousel-aria-labels}}

    <div class="o-resourcesCarousel__slider" id="carousel-{{ UniqueID }}">
      {{#each Cards}}
        {{> molecules-cmn-resources-card}}
      {{/each}}
    </div>
    <nav class="o-resourcesCarousel__actions">
      <div class="o-resourcesCarousel__dots"></div>
      <div class="o-resourcesCarousel__arrows"></div>
    </nav>
    <p class="o-resourcesCarousel__count" id="carousel-count-{{ UniqueID }}" aria-live="polite">
      {{ Labels.Showing }} <span class="slick-ada-from"></span>
      {{ Labels.To }}
      <span class="slick-ada-to"></span> {{ Labels.OutOf }}
      <span class="slick-ada-length"></span>.
    </p>
  </div>
</section>