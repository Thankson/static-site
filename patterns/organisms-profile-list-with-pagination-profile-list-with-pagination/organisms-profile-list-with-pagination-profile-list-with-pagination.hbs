<div class="o-profileList" data-component="o-profilelist__pagination">
  <div id="o-profilelist__content">
    <div class="o-profilelist__wrapper">
      <div class="o-profilelist__items-container">
        {{#if People}}
          <ul class="o-profilelist__items-group border-gray-200 border-0 flex-1 rounded-sm mx-15 bg-white md:border md:p-30">
            {{#each People}}
              {{#ifCond @index '<' 20}}
                <li class="o-profilelist__items flex items-center justify-between mb-3 p-4">
                  <div class="o-profilelist__item flex flex-1 items-center justify-between">
                    <div class="o-profilelist__title">
                      <h3 class="text-sm text-gray-900">{{CustomerName}}</h3>
                    </div>
                    <div class="o-profilelist__state w-20">
                      <p class="text-sm text-gray-600 text-left">{{StateShortName}}</p>
                    </div>
                  </div>
                </li>
              {{/ifCond}}
            {{/each}}
          </ul>
          <ul class="o-profilelist__items-group border-gray-200 border-0 flex-1 rounded-sm mx-15 bg-white md:border md:p-30">
            {{#each People}}
              {{#ifCond @index '>=' 20}}
                {{#ifCond @index '<' 40}}
                  <li class="o-profilelist__items flex items-center justify-between mb-3 p-4">
                    <div class="o-profilelist__item flex flex-1 items-center justify-between">
                      <div class="o-profilelist__title">
                        <h3 class="text-sm text-gray-900">{{CustomerName}}</h3>
                      </div>
                      <div class="o-profilelist__state w-20">
                        <p class="text-sm text-gray-600">{{StateShortName}}</p>
                      </div>
                    </div>
                  </li>
                {{/ifCond}}
              {{/ifCond}}
            {{/each}}
          </ul>
          <ul class="o-profilelist__items-group border-gray-200 border-0 flex-1 rounded-sm mx-15 bg-white md:border md:p-30">
            {{#each People}}
              {{#ifCond @index '>=' 40}}
                {{#ifCond @index '<' 60}}
                  <li class="o-profilelist__items flex items-center justify-between mb-3 p-4">
                    <div class="o-profilelist__item flex flex-1 items-center justify-between">
                      <div class="o-profilelist__title">
                        <h3 class="text-sm text-gray-900">{{CustomerName}}</h3>
                      </div>
                      <div class="o-profilelist__state w-20">
                        <p class="text-sm text-gray-600">{{StateShortName}}</p>
                      </div>
                    </div>
                  </li>
                {{/ifCond}}
              {{/ifCond}}
            {{/each}}
          </ul>
        {{/if}}
      </div>
    </div>
    <!-- Pagination Section -->
    {{#if Pagination}}
      <div class="o-profilelist__pagination mt-30">
        <m-pagination ref="pagination" :tabs-in-view="{{Pagination.TabsInView}}" :items-per-page="{{Pagination.ItemsPerPage}}" :total-items="{{Pagination.TotalItems}}" script-id="GrowPagination">
        </m-pagination>
      </div>
      <script type="application/json" id="GrowPagination">
      {{toJson GrowPaginationLocalization}}
      </script>
    {{/if}}
  </div>
</div>