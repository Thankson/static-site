<form class="o-masterForm max-w-contain mx-10 xl:mx-auto my-15" id="master-form" name="master-form" action="" method="post">
  <h1 class="text-3xl pb-10">Master Form</h1>
  <p class="text-gray text-sm pb-20">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
  <div class="">
    <div>
      {{#Field.FirstName}}
        {{> molecules-form-field-basic}}
      {{/Field.FirstName}}
    </div>
    <div>
      {{#Field.LastName}}
        {{> molecules-form-field-basic}}
      {{/Field.LastName}}
    </div>
    <div>
      {{#Field.AddressLine1}}
        {{> molecules-form-field-basic}}
      {{/Field.AddressLine1}}
    </div>
    <div>
      {{#Field.AddressLine2}}
        {{> molecules-form-field-basic}}
      {{/Field.AddressLine2}}
    </div>
    <div>
      {{#Field.City}}
        {{> molecules-form-field-basic}}
      {{/Field.City}}
    </div>
    <div>
      {{#Field.Zipcode}}
        {{> molecules-form-field-basic}}
      {{/Field.Zipcode}}
    </div>
    <div>
      {{#Field.State}}
        {{> molecules-form-field-select}}
      {{/Field.State}}
    </div>
    <div>
      {{#Field.Email}}
        {{> molecules-form-field-basic}}
      {{/Field.Email}}
    </div>
    <div>
      {{#Field.Telephone}}
        {{> molecules-form-field-basic}}
      {{/Field.Telephone}}
    </div>

    <div>
      {{#Field.Date}}
        {{> molecules-form-field-date}}
      {{/Field.Date}}
    </div>
    <div class="pb-20">
      <p class="text-sm uppercase font-bold pb-5 text-gray-120">{{Field.RadioListTitle}}</p>
      {{#Field.RadioList}}
        {{> molecules-form-field-radio}}
      {{/Field.RadioList}}
    </div>
    <div class="pb-20">
      <p class="text-sm uppercase font-bold pb-5 text-gray-120">{{Field.CheckboxListTitle}}</p>
      {{#Field.CheckboxList}}
        {{> molecules-form-field-checkbox}}
      {{/Field.CheckboxList}}
    </div>
    <div>
      {{#Field.Password}}
        {{> molecules-form-field-pwd}}
      {{/Field.Password}}
    </div>
    <div>
      {{#Field.ConfirmPassword}}
        {{> molecules-form-field-pwd}}
      {{/Field.ConfirmPassword}}
    </div>
    <div>
      {{#Field.TextArea}}
        {{> molecules-form-field-textarea}}
      {{/Field.TextArea}}
    </div>
    <div class="flex to-xs:justify-between">
      <div class="xs:mr-30 text-center to-xs:w-1_2 to-xs:mr-10">
        <input type="reset" value="Cancel" name="cancel" class="o-masterForm__reset">
      </div>
      <div class="xs:mr-30 text-center to-xs:w-1_2">
        {{#Field.Submit}}
          {{> atoms-button}}
        {{/Field.Submit}}
      </div>
    </div>
  </div>
</form>