<div class="o-videoGroup">
  <div class="o-videoGroup__banner">
    {{> molecules-cmn-large-banner }}
  </div>

  <ul class="o-videoGroup__smallGroup {{#if CollapseEmptyBanner}}-collapseBanner{{/if}} {{#if AllowCustomRowLength}}-customRowLength{{/if}} grid-cols-{{ColsMobile}} md:grid-cols-{{ColsTablet}} lg:grid-cols-{{ColsDesktop}}">
    {{#with SmallVideos}}
      {{#each .}}
        <li class="o-videoGroup__listItem">
          {{> molecules-cmn-resources-card }}
        </li>
      {{/each}}
    {{/with}}
  </ul>
</div>