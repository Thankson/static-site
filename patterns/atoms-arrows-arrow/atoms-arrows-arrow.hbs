{{#with Arrow}}
  <span class="a-arrow {{Size}} {{Direction}} {{OtherMods}}" aria-hidden="true">
    <span class="a-arrow__icon border-{{TailwindColor}} text-{{TailwindColor}} {{#if IsIconMods}} -icon-adjustments {{/if}}" style="border-color:{{TextColor}}"></span>
  </span>
  {{else}}
    <span class="a-arrow {{Size}} {{Direction}} {{OtherMods}}" aria-hidden="true">
      <span class="a-arrow__icon border-{{TailwindColor}} text-{{TailwindColor}} {{#if IsIconMods}} -icon-adjustments {{/if}}" style="border-color:{{TextColor}}"></span>
    </span>
{{/with}}