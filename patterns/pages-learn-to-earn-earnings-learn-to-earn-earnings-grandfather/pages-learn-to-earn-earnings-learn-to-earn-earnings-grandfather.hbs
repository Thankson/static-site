{{> organisms-site-header }}

<div class="bg-gray-25 pb-40">
  <div class="md:mb-44 pt-15">
    {{#Breadcrumb}}
      {{> molecules-breadcrumb }}
    {{/Breadcrumb}}
  </div>

  {{#with LearnToEarnEarnings}}
    <div class="mx-auto max-w-contain">
      <h1 class="text-3xl text-gray-150 font-bold mb-6 px-8 md:px-15 md:mb-40 xl:px-0">
        {{PageTitle}}
      </h1>
    </div>

    <div class="mb-10 md:mb-30">
      {{!-- Dollar Balance --}}
      <o-ltee-dollar-balance script-id="{{DynamicId}}"></o-ltee-dollar-balance>
    </div>

    <div class="mb-10 md:mb-30 md:px-15">
      {{!-- Breakdown Bar --}}
      <o-ltee-breakdown-bar script-id="{{DynamicId}}"></o-ltee-breakdown-bar>
    </div>

    <div class="mb-10 md:mb-80 md:px-15">
      {{!-- History --}}
      <o-ltee-history script-id="{{DynamicId}}"></o-ltee-history>
    </div>

    <script type="application/json" id="{{DynamicId}}">
    {{toJson Localization}}
    </script>
  {{/with}}

</div>

<script id="data-shelf-configurator-localization" type="application/json">
{{toJson Localization}}
</script>

{{> organisms-site-footer }}