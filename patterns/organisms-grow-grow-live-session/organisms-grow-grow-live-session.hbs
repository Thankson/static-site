<div class="o-growLiveSession">
  <h2 class="o-growLiveSession__heading" style="color: {{HeaderTextColor}};">
    {{HeaderText}}
  </h2>

  <ul class="o-growLiveSession__list">
    {{#each Sessions}}
      {{> molecules-grow-live-session-card}}
    {{/each}}
  </ul>

  {{#if ScheduleNote}}
    <p class="o-growLiveSession__scheduleNote">{{ScheduleNote}}</p>
  {{/if}}
</div>