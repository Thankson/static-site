{{> molecules-popup}}

{{!

    Use the `BodyDynamic` property in the JSON file to reference the inline partial below

}}

{{#*inline "PopUpBodyContent"}}
  {{#PopUpBodyContent}}
    <div class="{{#unless @last}}border-b{{/unless}} p-20">
      {{#TrackingNumbers}}
        <div class="leading-tight pt-10">
          <p class="text-gray-100 text-sm">{{Package.Title}}</p>
          <p class="text-green-100 font-bold text-sm">{{Package.Number}}</p>
          <div class="pt-15 pb-10 {{Package.DisplayBtn}}">
            <button class="px-25 py-7 bg-green-100 text-white text-xs uppercase rounded">
              {{Package.TrackBtnText}}
            </button>
          </div>
        </div>
      {{/TrackingNumbers}}

      <div class="pt-10 {{DisplayDesc}}">
        <p class="text-sm text-gray-100">{{{Desc}}}</p>
      </div>
    </div>
  {{/PopUpBodyContent}}
{{/inline}}