{{#with LTEHero}}
  <article class="m-LTEHero {{Modifier}}">
    <div class="m-LTEHero__media">
      <div class="m-LTEHero__background -mobile" style="background-image:url('{{Background.Mobile}}')"></div>
      <div class="m-LTEHero__background -desktop" style="background-image:url('{{Background.Desktop}}')"></div>
    </div>
    <div class="m-LTEHero__content">
      <div class="m-LTEHero__title m-rte">{{{Title}}}</div>
      <p class="m-LTEHero__description">{{{Description}}}</p>
      {{#with GreenBanner}}
        {{> molecules-lte-green-banner}}
      {{/with}}
    </div>
  </article>
{{/with}}