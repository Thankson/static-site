{{#MyAccountDefaultAddress}}
  <div class="o-myAccountDfAdd">
    <h2 class="o-myAccountDfAdd__title -mobile">{{Title}}</h2>
    <div class="o-myAccountDfAdd__container">
      <h2 class="o-myAccountDfAdd__title -pc">{{Title}}</h2>
      <div class="o-myAccountDfAdd__content">
        <div class="o-myAccountDfAdd__rteContent">{{{RteContent}}}</div>
        <div class="o-myAccountDfAdd__link">
          <a class="a-authorBtn text-center bg-white rounded py-10 px-36 text-sm font-semibold md:px-48" href="{{Link.Url}}">
            {{Link.Text}}
          </a>
        </div>

      </div>
    </div>
  </div>
{{/MyAccountDefaultAddress}}