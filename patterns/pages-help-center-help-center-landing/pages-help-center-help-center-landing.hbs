{{> organisms-site-header }}

<section class="pt-10 md:pt-75 md:pb-40 bg-gray-25 relative z-1">
  {{#Corner.Outer}}
    {{> atoms-corner-imagery }}
  {{/Corner.Outer}}

  <h1 class="w-full mx-auto text-2xl font-bold tracking-tight text-gray-150 max-w-contain font-global-sans md:text-3xl md:mb-18 to-md:px-10">{{PageTitle}}</h1>

  <div class="w-full px-10 py-10 mx-auto mt-10 mb-10 bg-white border max-w-contain md:mb-40 border-gray-50 text-gray-150 text-0 md:px-40 md:py-36 md:rounded relative z-1">
    {{#Corner.Inner}}
      {{> atoms-corner-imagery }}
    {{/Corner.Inner}}
    <h2 class="text-3xl font-light leading-tight mb-18 md:mb-50 md:text-5xl">{{PageSubtitle}}</h2>

    <div class="{{#if IsCn}} flex flex-wrap {{else}} md:flex md:justify-between lg:mr-90 {{/if}}">
      {{#each HelpGroups}}
        <div class="align-top {{#if ../IsCn}}to-md:w-full mb-20 md:w-1_3 align-top md:mb-32 md:mt-2{{else}} mb-30  md:mb-6 {{/if}} md:inline-block">
          <h3 class="text-xl font-medium tracking-tight uppercase mb-15 md:mb-5">{{Title}}</h3>
          <ul class="text-sm font-medium leading-relaxed text-green-100 mr-15 md:text-md">
            {{#each Links}}
              <li class="{{#if ../../IsCn}} my-20 {{else}}my-24 {{/if}} md:my-3"><a href="{{URL}}" class="hover:underline">{{Label}}</a></li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    </div>

    <div class="hidden text-center mb-36 mt-100 md:block h-90">
      {{#with ChatButton}}
        <button class="a-button -outline">
          <div aria-hidden="true" class="inline-block m-2 align-middle w-25 h-25">
            {{{IconSVG}}}
          </div>
          <span class="ml-4 text-base align-middle r-8">{{Label}}</span>
        </button>
      {{/with}}
    </div>


  </div>

</section>
{{> organisms-site-footer }}