{{#MembershipInfo}}
  <div class="bg-white border border-gray-50 rounded-md flex mb-20 md:mb-30">
    <div class="w-full z px-10 py-25 mb-0 md:p-40 md:pb-25">
      <h2 class="text-gray-150 md:text-2xl-2 text-2xl leading-base mb-10 md:mb-20">Membership Information</h2>
      <div class="md:flex pt-10">
        <div class="md:w-1_3 text-base text-gray-120 leading-relaxed mb-30">
          {{#if HasEnroller}}
            <em class="text-gray-150 text-xl font-bold not-italic leading-normal {{#if HasTooltip}} inline-block {{else}} flex {{/if}}">
              Your Enroller:
            </em>
            {{#if HasTooltip}}
              <m-tooltip>{{Text}}</m-tooltip>
            {{/if}}
            <p>John Jacob Smith III</p>
            <p class="text-green break-all md:text-gray-120">(208) 555-1234</p>
            <p class="text-green break-all md:text-gray-120">nojinglheimer@emails.com</p>
          {{else}}
            <p class="leading-normal mb-10" style="max-width: 260px;">
              For questions about your membership, call Customer Service:
            </p>
            <ul class="leading-base">
              <li class="mb-10"><strong>1 (800) 282-3000</strong></li>
              <li class="mb-10 text-gray-120">Mon-Fri: 6am-10pm</li>
              <li class="text-gray-120">Sat: 7am-8pm</li>
            </ul>
          {{/if}}
        </div>

        {{#if ContactInfo}}
          <div class="text-base text-gray-120 leading-tight -mt-5 -ml-5 md:w-1_3 md:text-left md:flex md:justify-around md:pl-70 md:pr-10 md:h-90">
            <p class="w-3_4 md:w-200 mt-10">如果你需要查看美乐家会员顾客协议书，请联系客服021-61616164000</p>
          </div>
        {{else}}
          <div class="md:w-2_3 md:text-left md:flex flex-col text-base text-gray-120 leading-tight md:pl-70 md:pr-10 -mt-5 md:h-90 {{#unless ShowInListFormat}} md:justify-around {{/unless}}{{#if ShowInListFormat}} flex-col md:justify-left{{/if}}">
            <a href="#" target="_blank" class="flex mb-10 md:mb-0">
              {{#unless ShowInListFormat}}
                <div class="w-70 min-w-64 mr-10 md:mr-15">
                  <img src="https://placehold.co/68x83">
                </div>
              {{/unless}}
              <p class="{{#unless ShowInListFormat}}w-200 {{#if IsCn}} md:w-100 {{else}} md:w-150 {{/if}} mt-10{{/unless}} {{#if ShowInListFormat}}mt-15{{/if}}">View Customer Membership
                Agreement<span class="font-material text-green absolute -mt-5 -ml-5 text-2xl">arrow_right</span>
              </p>
            </a>
            <a href="#" target="_blank" class="flex mb-15 md:mb-0">
              {{#unless ShowInListFormat}}
                <div class="w-70 min-w-64 mr-10 md:mr-15">
                  <img src="https://placehold.co/68x83">
                </div>
              {{/unless}}
              <p class="{{#unless ShowInListFormat}}w-200 {{#if IsCn}} md:w-100 {{else}} md:w-150 {{/if}} mt-10{{/unless}} {{#if ShowInListFormat}}mt-15{{/if}}">View Independent Marketing
                Executive Agreement<span class="font-material text-green absolute -mt-5 -ml-5 text-2xl">arrow_right</span></p>
            </a>
          </div>
        {{/if}}

      </div>
      <a href="#" class="float-right text-right text-green uppercase text-base font-medium"><span class="align-middle">More Resources</span><span class="font-material lowercase -ml-5 text-2xl align-middle">arrow_right</span></a>
    </div>
  </div>
{{/MembershipInfo}}