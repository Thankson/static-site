{{> organisms-site-header-grow}}

<div class="bg-gray-25 pt-30 pb-30">
  <div class="o-widthControl mx-auto w-full max-w-full md:max-w-contain to-md:px-10 mb-30">
    <h1 class="uppercase font-bold text-3xl text-gray-150 leading-tight pb-20 mt-32">{{PageHeading}}</h1>
    {{> molecules-tabs-links }}
    <div class="mt-30">
      <h2 class="font-bold text-2xl text-gray-150 leading-tight pb-20">{{Heading}}</h2>
      {{> molecules-button-list}}
    </div>
  </div>

  <div class="o-widthControl mx-auto w-full max-w-full md:max-w-contain to-md:px-10">
    {{> organisms-profile-list-with-pagination }}
  </div>
</div>

{{> organisms-site-footer}}