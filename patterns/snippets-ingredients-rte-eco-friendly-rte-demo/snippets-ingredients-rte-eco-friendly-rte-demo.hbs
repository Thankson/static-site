<div class="m-rte">
  {{#with EcoFriendlyContent}}
    <div class="s-ecoFriendly">
      <h3 class="s-ecoFriendly__heading -main">{{{Heading}}}</h3>
      <div class="s-ecoFriendly__wrapper -main">
        <div class="s-ecoFriendly__text">
          {{{Text}}}
        </div>
        <div class="s-ecoFriendly__wrapper -list">
          <h3 class="s-ecoFriendly__heading -list" role="text">{{{ExtraText}}}</h3>
          <ul class="s-ecoFriendly__list">
            {{#each List}}
              <li class="s-ecoFriendly__item">
                <img src="{{ImgSrc}}" alt="" class="s-ecoFriendly__img">
                <p class="s-ecoFriendly__caption">{{{Caption}}}</p>
              </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>
  {{/with}}
</div>