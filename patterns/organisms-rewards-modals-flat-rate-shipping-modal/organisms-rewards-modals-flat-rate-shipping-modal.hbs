<modal alignment="bottom" width="440px" :visible="true">
  <template #content>
    <div class="o-rewardMod__modal">
      <perfect-scrollbar class="o-rewardMod__ps pr-20">
        <h2 id="global-modal-heading" class="text-gray-150 text-sm font-bold mb-20">{{ModalHeading}}</h2>

        <p class="text-gray-150 text-sm mb-20">{{ModalBody.Description}}</p>

        <p class="text-gray-150 text-xs italic mb-50">{{ModalBody.Note}}</p>
      </perfect-scrollbar>

      <div>
        <button v-modal-hide class="a-button -outline -hemisphere font-medium px-15 py-10 leading-tight">

          {{ModalFooter.LinkLabel}}
        </button>
      </div>
    </div>
  </template>
</modal>