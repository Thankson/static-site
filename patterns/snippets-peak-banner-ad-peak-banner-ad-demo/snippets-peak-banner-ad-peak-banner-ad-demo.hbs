{{#PeakBannerAd}}
  <a href="{{Link}}" class="block relative w-full" aria-describedby="uniqueId001" style="max-width:970px;">
    <div class="absolute bg-cover bg-no-repeat inset-0 h-full w-full -z-1 md:hidden" style="background-image: url('{{BgImgMobile}}')"></div>
    <div class="absolute bg-cover bg-no-repeat inset-0 h-full w-full -z-1 to-md:hidden" style="background-image: url('{{BgImgDesktop}}')"></div>
    <div class="flex flex-col items-center px-8 py-20 relative w-full z-1 md:flex-row md:px-90">
      <img src="{{ProductImg}}" alt="{{ProductAlt}}" width="180">
      <div class="mt-20 md:mt-0 md:ml-30 md:mr-5" role="text" id="uniqueId001">
        <h3 class="font-medium text-xl text-white md:font-normal md:text-2xl" style="line-height: 1.1"><span role="text">{{HeadingText}} <span class="block font-bold text-2xl md:text-4xl">{{HeadingHighlight}}</span></span></h3>
        <p class="font-medium mt-15 uppercase" style="color:#80BD41;line-height:1.125;">{{Cta}} <span class="material-icons align-middle" aria-hidden="true">chevron_right</span></p>
      </div>
    </div>
  </a>
{{/PeakBannerAd}}