<div class="m-tabs">
  <ul class="m-tabs__list {{#if IsCn}}-isCn{{/if}}">
    {{#each Tabs}}
      <li class="m-tabs__tab" id="{{Id}}" style="{{#if Width}}width: {{Width}};{{/if}}">
        <a href="{{Link}}" class="m-tabs__link
                    {{#if IsActive}}-isActive{{/if}}
                    {{#if IsSquaredCorners}} -squared{{/if}}
                    {{#if RoundedCorners}} -rounded{{/if}}
                    {{#if BackgroundColor}} -stacked{{/if}}
                    {{#if ActiveHoverTextColor}} pointer-events-auto {{/if}}
                    {{TailwindMods}}" style="
                        {{!-- Active text color --}}
                        {{#if IsActive}}color: {{ActiveTextColor}}{{else}}color: {{TextColor}}{{/if}};
                        {{#if IsActive}}background-color: {{ActiveBackgroundColor}}{{else}}background-color: {{BackgroundColor}}{{/if}};
                        {{#if IsActive}}border-color: {{ActiveBackgroundColor}}{{else}}border-color: {{BackgroundColor}}{{/if}};
                        " {{#if IsActive}}aria-current="page" {{/if}} {{!-- Applied colors on hover event --}} {{#if HoverTextColor}} onmouseenter="this.style.color='{{#if IsActive}}{{ActiveHoverTextColor}}{{else}}{{HoverTextColor}}{{/if}}';" onmouseleave="this.style.color='{{#if IsActive}}{{ActiveTextColor}}{{else}}{{TextColor}}{{/if}}';" {{/if}} {{#if Gtm}} data-gtm-track='
                    {
                        "gtmId": {{Gtm.Id}},
                        "gtmText": "{{Gtm.Text}}"
                    }' {{/if}}>
          {{Title}}

          {{#ifCond IsActive '&&' BackgroundColor}}
            <svg class="m-tabs__arrow -centered" width="22" height="8" viewBox="0 0 22 8" xmlns="http://www.w3.org/2000/svg">
              <polygon points="0,0 11,8 22,0" fill="{{#if IsActive}}{{ActiveBackgroundColor}}{{else}}{{BackgroundColor}}{{/if}}" />
            </svg>
    {{else}}
      <div class="m-tabs__arrow" aria-hidden="true" />
          {{/ifCond}}
        </a>
      </li>
    {{/each}}
  </ul>
</div>