{{!-- app-download-block.hbs --}}
<div class="m-appDownloadBlock">
  {{!-- QR code (shown only on desktop) --}}
  {{#if QrCode.Url}}
    <div class="m-appDownloadBlock__qr">
      <img src="{{QrCode.Url}}" alt="{{QrCode.Alt}}">
    </div>
  {{/if}}

  {{!-- Store badge (always visible) --}}
  {{#if Link.Url}}
    <a href="{{Link.Url}}" target="{{Link.Target}}" class="m-appDownloadBlock__badgeLink">
      <img src="{{Badge.Url}}" alt="{{Badge.Alt}}">
    </a>
  {{/if}}
</div>