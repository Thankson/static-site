{{> organisms-site-header-checkout}}<div class="bg-gray-25">  <p-checkout script-id="{{DynamicScriptId}}">    {{#if BannerVariant1}}      <sc-placeholder class="hidden" slot-name="banner-variant-1">        {{> molecules-adapt-notice-banner BannerVariant1}}      </sc-placeholder>    {{/if}}    {{#if BannerVariant2}}      <sc-placeholder class="hidden" slot-name="banner-variant-2">        {{> molecules-adapt-notice-banner BannerVariant2}}      </sc-placeholder>    {{/if}}  </p-checkout>  {{#with IframeModal}}    <script type="application/json" id="iframe-modal">    {{toJson Localization}}    </script>  {{/with}}  <script type="application/json" id="{{DynamicScriptId}}">  {{toJson Localization}}  </script>  {{#with AccordionModal}}    <script type="application/json" id="accordionModal">    {{toJson Localization}}    </script>  {{/with}}</div><script type="application/json" id="{{DynamicScriptId}}">{{toJson Localization}}</script>