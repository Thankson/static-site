<div class="m-welcomePin {{#if IsHere}}-isHere{{/if}}">
  <div class="m-welcomePin__content">
    <div>
      <span class="m-welcomePin__title">{{Title}}</span>
      {{#if IsHere}}<span class="m-welcomePin__placeBox">
          <a-icon class="m-welcomePin__place">place</a-icon>
        </span>{{/if}}
      {{#unless IsHere}}
        <a-icon color="white" size="xs" class="m-welcomePin__help">help</a-icon>
        <div class="m-welcomePin__pop">
          <div class="m-welcomePin__popContent">
            <div class="m-welcomePin__arrowPop"></div>
            <p>{{{TipDescription}}}</p>
            <span aria-hidden="true" class="m-welcomePin__popClose a-icon material-icons -inherit -sm">close</span>
          </div>
        </div>
      {{/unless}}
    </div>
  </div>
  {{#unless IsHere}}
    <div class="m-welcomePin__arrow"></div>
  {{/unless}}
</div>