<div class="m-ctaCsrBlock">
  {{#each Blocks}}
    <div class="m-ctaCsrBlock__wrapper" aria-hidden="true">
      <div class="m-ctaCsrBlock__bg -desktop" style="background-image:url('{{Images.BgDesktop}}')" role="img">
      </div>
      <div class="m-ctaCsrBlock__bg -mobile" style="background-image:url('{{Images.BgMobile}}')" role="img">
      </div>
      <div class="m-ctaCsrBlock__content">
        <div class="m-ctaCsrBlock__header">
          <h2 class="m-ctaCsrBlock__title">{{{Title}}}</h2>
          <div class="m-ctaCsrBlock__cta -mobile">
            <a href="{{Link}}" class="m-ctaCsrBlock__link">
              {{CTA}}
            </a>
          </div>
          <div class="m-ctaCsrBlock__cta -desktop">
            <a href="{{Link}}" class="m-ctaCsrBlock__link">
              {{CTA}}
            </a>
          </div>
        </div>
      </div>
    </div>
  {{/each}}
</div>