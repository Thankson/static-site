{{#with CardNumber}}
  <input-card-number id="{{Id}}" input-type="{{InputType}}" mask="{{Maskname}}" :mask-on-blur=true :mask-on-key-up=false :unmask-on-focus=true max-length="{{MaxLength}}" min-length="{{MinLength}}" name="{{Name}}" :required="{{Required}}" tailwind-mods="{{TailwindMods}}" pattern="{{Pattern}}" placeholder="{{Placeholder}}" value="{{Value}}" auto-complete="off" :card-options='{{toJson CardOptions}}'>
  </input-card-number>
{{/with}}