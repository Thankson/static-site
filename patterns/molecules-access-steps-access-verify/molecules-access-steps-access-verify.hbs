<m-access-verify :handler="() => true">
  <template v-slot:heading>
    {{Title}}
  </template>

  <template v-slot:description>
    {{{Description}}}
  </template>

  <template v-slot:field-label>
    {{{CodeField.Label}}}
  </template>

  <template v-slot:field-error>
    {{{CodeField.ErrorMessage}}}
  </template>

  <template v-slot:api-error>
    {{{ApiErrorMessage}}}
  </template>

  <template v-slot:button-label>
    {{Button.CTA}}
  </template>

  {{#if Note}}
    <template v-slot:note>
      {{{Note}}}
    </template>
  {{/if}}

  {{#if InfoLink.Text}}
    <template v-slot:info-link>
      <div class="inline-flex items-center">
        <a href="{{InfoLink.Href}}">
          {{InfoLink.Text}}
        </a>

        {{#if InfoLink.Tooltip}}
          <m-tooltip>
            {{InfoLink.Tooltip}}
          </m-tooltip>
        {{/if}}
      </div>
    </template>
  {{/if}}
</m-access-verify>