<div class="relative">
  <h3 class="text-md md:text-lg font-semibold uppercase mr-3 mb-10 mr-15 inline-block">{{Title}}<span class="to-md:hidden">:</span></h3>
  {{#with Manage}}
    <a href="{{Url}}" class="uppercase text-green-100 text-md mb-10 inline-block absolute left-0 bottom-0 md:relative" aria-label="{{AriaLabel}}" {{#if Gtm}} data-gtm-track='
            {
                "gtmId": {{Gtm.Id}},
                "gtmText": "{{Gtm.Text}}"
            }
            ' {{/if}}>
      {{Label}}
    </a>
  {{/with}}

  {{#if RenderAsVueComponent}}
    <credit-card-info card-name="{{ CardName }}" card-ending="{{ CardEnding.Number }}" card-ending-aria-label="{{ CardEnding.AriaLabel }}" card-expiration="{{ Expires.Date }}" card-expiration-label="{{ Expires.Label }}" :card-expiration-near="{{ Expires.ExpirationNear }}" card-expiration-aria-label="{{ Expires.AriaLabel }}" card-brand-image-src="{{ CardLogo.Src }}" card-brand-alt="{{ CardLogo.Alt }}">
    </credit-card-info>
  {{else}}
    <div class="pb-40 mb-20 text-gray-100 font-medium text-base md:text-xl flex md:mb-10">
      {{> atoms-card-logo}}
      <p class="sr-only">{{CardName}} {{CardEnding.AriaLabel}} {{CardEnding.Number}} {{Expires.AriaLabel}} {{Expires.Date}}</p>
      <p class="inline-block leading-tight w-auto self-center" aria-hidden="true">
        <span class="tracking-tight">{{CardName}}</span>
        {{#with CardEnding}}
          <span class="text-2xl md:text-3xl tracking-tighter leading-none">&middot;&middot;&middot;&middot;</span>&nbsp;<span class="tracking-tight md:mr-50">{{Number}}</span>
        {{/with}}
        {{#with Expires}}
          <span class="tracking-tight text-base block w-full md:inline md:text-lg md:italic {{#if ExpirationNear}}text-red{{/if}}"><span>{{Label}}&nbsp;</span>{{Date}}</span>
        {{/with}}
      </p>
    </div>
  {{/if}}

</div>