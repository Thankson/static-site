{{> organisms-site-header }}

<section class="pt-10 pb-1 md:pt-75 md:pb-15 bg-gray-25">
  <div class="mx-auto max-w-contain">

    <h1 class="w-full text-2xl font-bold tracking-tight text-gray-150 font-global-sans md:text-3xl md:mb-18 to-md:px-10">{{PageTitle}}</h1>

    {{> molecules-tabs-links}}

    {{#if Page.IsOverview}}
      {{> organisms-account-overview}}
    {{/if}}

    {{#if Page.IsOrderHistory}}
      {{#with OrderHistory}}
        {{> organisms-past-orders-section}}
      {{/with}}
    {{/if}}

    {{#if Page.IsPaymentAddress}}
      {{#with PaymentAddressInfo}}
        {{> organisms-payment-address-section}}
        {{> organisms-shipping-address-section}}
      {{/with}}
      {{> organisms-business-commission-section-no-account}}
    {{/if}}

    {{#if Page.IsShoppingLists}}
      {{#with ShoppingLists}}
        {{> organisms-shopping-lists-section}}
      {{/with}}
    {{/if}}
  </div>
</section>

{{> organisms-site-footer }}