{{> organisms-site-header-grow}}

<div class="bg-gray-25">
  <section>
    <div class="mb-10 pt-15">
      {{#Breadcrumb}}
        {{> molecules-breadcrumb }}
      {{/Breadcrumb}}
    </div>

    <h1 class="w-full mx-auto text-2xl-2 font-bold text-gray-150 leading-tight max-w-contain mb-20 px-10 md:text-3xl-2 md:leading-base md:mt-24 md:px-20 xl:px-0">{{PageTitle}}</h1>

    {{> molecules-tabs-links}}

    <div class="o-widthControl mx-auto w-full max-w-full px-10 md:max-w-contain md:px-20 xl:px-0">
      <div class="o-sectionContainer">
        <div class="o-sectionContainer__content">
          <h2 class="o-sectionContainer__title">{{TabTitle}}</h2>

          <div class="o-sectionContainer__description">
            <m-collapsible-text less-label="{{LessLabel}}" more-label="{{MoreLabel}}">
              {{TabDescription}}
            </m-collapsible-text>
          </div>
        </div>

        {{> organisms-grow-profile-cards }}
      </div>
    </div>
  </section>

</div>

{{> organisms-site-footer}}