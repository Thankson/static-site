<div class="a-anchorButton">
  <a class="a-anchorButton__link {{#if Disabled}}-disabled{{/if}}" href="{{Link}}">
    <div class="a-anchorButton__content">
      {{#if LeftIcon}}
        <span class="a-anchorButton__leftIcon material-icons" aria-hidden="true">{{LeftIcon}}</span>
      {{/if }}
      <span class="a-anchorButton__text">{{Text}}</span>
      {{#if RightIcon}}
        <span class="a-anchorButton__rightIcon material-icons" aria-hidden="true">{{RightIcon}}</span>
      {{/if }}
    </div>
  </a>
</div>