<div class="m-categoryHeader">
  <img class="m-categoryHeader__logo" src="https://cdnsc1.melaleuca.com.cn/Lia/Lia Program Image/logo/logo-green@2x.png" alt="">
  <div class="m-categoryHeader__content">
    <h1 class="m-categoryHeader__title">
      {{Name}}
    </h1>
    <a href="{{Link.Url}}" class="m-categoryHeader__link">
      <span class="m-categoryHeader__linkMore" aria-label="{{Name}}">{{More}}</span>
      <span class="m-categoryHeader__icon material-icons" aria-hidden="true">arrow_right</span>
    </a>
  </div>
</div>