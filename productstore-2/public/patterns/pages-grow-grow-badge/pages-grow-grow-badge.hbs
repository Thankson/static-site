{{> organisms-site-header-grow}}

{{!-- Badge wrapped around a full width banner --}}
{{#with CmnFullWidthBanner}}
  <div class="mx-auto w-full max-w-full md:max-w-contain my-24">
    <h2 class="font-bold text-2xl leading-base pb-20">{{SectionTitle}}</h2>
    <hr>
  </div>
  {{#> atoms-badge}}
    {{> molecules-cmn-full-width-banner}}
  {{/atoms-badge}}
{{/with}}

{{!-- Badge wrapped around a banner magazine --}}
{{#with BannerMagazine}}
  <div class="mx-auto w-full max-w-full md:max-w-contain mt-40 mb-24">
    <h2 class="font-bold text-2xl leading-base pb-20">{{SectionTitle}}</h2>
    <hr>
  </div>

  {{#> atoms-badge}}

    {{> molecules-banner-magazine}}

  {{/atoms-badge}}
{{/with}}

{{!-- Badge wrapped around a variable window --}}
{{#with VariableWindow}}
  <div class="mx-auto w-full max-w-full md:max-w-contain mt-40 mb-24">
    <h2 class="font-bold text-2xl leading-base pb-20">{{SectionTitle}}</h2>
    <hr class="mb-24">
    {{#> atoms-badge}}
      {{> molecules-variable-windows}}
    {{/atoms-badge}}
  </div>
{{/with}}

{{#with BadgeModal}}
  {{> organisms-badge-modal}}
{{/with}}

{{> organisms-site-footer}}