<div class="o-inviteFriendAd 
    {{#if BorderColor}} -border {{/if}}
    {{#if BackgroundImage}} -backgroundImage {{/if}}" style="
    {{#if BorderColor}} border-color:{{BorderColor}} {{/if}}
    {{#if BackgroundImage}} background-image:url('{{BackgroundImage}}') {{/if}}
    {{#if BackgroundColor}} background-color:{{BackgroundColor}} {{/if}}
">
  <div class="o-inviteFriendAd__column">
    <span class="o-inviteFriendAd__column__header">{{{TitleRte}}}</span>
    <span class="o-inviteFriendAd__column__content">{{{DescriptionRte}}}</span>
  </div>
  {{#if ProductImgUrl}}
    <img class="o-inviteFriendAd__productImage" src="{{ProductImgUrl}}" alt="{{ImgAlt}}">
  {{/if}}
</div>