<div class="m-onlineSurvey">
  <button class="m-onlineSurvey__closeX" type="button">
    <span aria-hidden="true" class="m-onlineSurvey__icon material-icons -inherit">close</span>
  </button>
  <a class="m-onlineSurvey__link" href="{{SurveyLink}}">
    <div class="m-onlineSurvey__content" role="text">
      <em class="{{Mod.Title}}">{{{SurveyTitle}}}</em>
      <span aria-hidden="true" class="a-arrow -md align-middle -filled">
        <span class="a-arrow__icon border-white text-white"></span>
      </span>
    </div>
  </a>
</div>