<article class="m-LTEBanner">
  <div class="m-LTEBanner__media" alt="{{AltImage}}">
    {{> atoms-icon-badge}}
  </div>
  <div class="m-LTEBanner__content">
    <p class="m-LTEBanner__title">
      {{{Title}}}
    </p>
    <a class="m-LTEBanner__link" href="{{Link}}">
      {{{Description}}}<span class="m-LTEBanner__arrow">&#10095;</span>
    </a>
  </div>
</article>