{{#LargeBanner}}
  <div class="m-largeBanner -withIcons {{#if HeightSmall}}-heightSmall{{/if}}{{#if GroupStyle}} -videoGroup{{/if}}{{#if BottomContent}} -bottomContent{{/if}}" {{#if BgColor}} style="background-color: {{BgColor}};" {{/if}}>
    <div class="m-largeBanner__media">
      <!-- Mobile Image -->
      <div class="m-largeBanner__img -mobile sm:hidden" style="background-image:url('{{ImageSrc.Mobile}}');">
        <img class="sr-only" src="{{ImageSrc.Mobile}}" alt="{{ImageAltText}}">
      </div>
      <!-- Desktop Image -->
      <div class="m-largeBanner__img -desktop to-sm:hidden" style="background-image:url('{{ImageSrc.Desktop}}');">
        <img class="sr-only" src="{{ImageSrc.Desktop}}" alt="{{ImageAltText}}">
      </div>
    </div>

    <div class="m-largeBanner__content {{TextAlignment}} {{#if TextContain}}-textContain{{/if}}">
      {{#unless RTEContent}}
        {{#if Title}}
          <h2 class="m-largeBanner__title">{{Title}}</h2>
        {{/if}}
        {{#if Subtitle}}
          <p class="m-largeBanner__subtitle">{{Subtitle}}</p>
        {{/if}}
      {{else}}
        <div class="m-rte">
          {{!-- Start: RTE Content --}}
          {{{RTEContent}}}
          {{!-- End: RTE Content --}}
        </div>
      {{/unless}}

      <ul class="m-largeBanner__list">
        {{#each Icons}}
          <li class="m-largeBanner__item">
            <img src="{{Icon}}" class="m-largeBanner__icon" />
            <span class="m-largeBanner__name">{{Label}}</span>
          </li>
        {{/each}}
      </ul>
    </div>
  </div>
{{/LargeBanner}}