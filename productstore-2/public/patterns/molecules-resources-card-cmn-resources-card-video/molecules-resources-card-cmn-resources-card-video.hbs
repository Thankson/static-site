{{#Card}}
  <div class="m-resourcesCard {{Modifier}}">
    {{#if Link}}<a class="m-resourcesCard__link" href="{{Link}}">{{/if}}
    <div class="m-resourcesCard__media {{TextAlignment}}">
      {{#if Video}}
        {{> molecules-cmn-video-toggle-button Icon=PlayIcon}}
        <img class="m-resourcesCard__img" src="{{Video.thumbnailImageUrl}}" alt="Play video {{Video.title}}">
      {{/if}}
      {{#if Image}}
        <img class="m-resourcesCard__img" src="{{Image}}" alt="{{ImageAltText}}">
      {{/if}}
    </div>
    {{#unless RTEContent}}
      <p class="m-resourcesCard__content {{TextAlignment}} {{Modifier}}">
        <em class="m-resourcesCard__title {{Modifier}}">{{Heading}}
          <span aria-hidden="true" class="m-resourcesCard__arrow a-arrow align-middle mb-5"><span class="a-arrow__icon border-black text-black"></span></span>
        </em>
        {{#if Subtitle}}<span class="m-resourcesCard__subtitle {{Modifier}}">{{Subtitle}}</span>{{/if}}
      </p>
    {{else}}
      <div class="m-rte m-resourcesCard__content {{TextAlignment}} {{Modifier}} mb-20 md:mb-0">
        {{!-- Start: RTE Content --}}
        {{{RTEContent}}}
        {{!-- End: RTE Content --}}
      </div>
    {{/unless}}
    {{#if Link}}</a>{{/if}}
  </div>
{{/Card}}