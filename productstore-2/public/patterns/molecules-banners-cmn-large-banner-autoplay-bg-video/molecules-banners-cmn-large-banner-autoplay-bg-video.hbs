{{#LargeBanner}}
  <div class="m-largeBanner {{#if ../CollapseEmptyBanner}}-collapseBanner {{#unless Title}}-noTitle{{/unless}}{{/if}} {{#if HeightSmall}}-heightSmall{{/if}}{{#if GroupStyle}} -videoGroup{{/if}}{{#if BottomContent}} -bottomContent{{/if}}" {{#if BgColor}} style="background-color: {{BgColor}};" {{/if}}>

    {{#unless ../CollapseEmptyBanner}}
      <div class="m-largeBanner__media {{#if BgMobile}}absolute top-0 left-0{{/if}}">
        {{#if BgVideo}}
          <div class="m-largeBanner__bgVideo">
            <video muted autoplay loop poster="{{BgVideo.Poster}}" aria-label="{{BgVideo.Description}}">
              <source src="{{BgVideo.WebM}}" type="video/webm" />
              <source src="{{BgVideo.Mp4}}" type="video/mp4" />
            </video>
            {{#with PlayPauseButton}}
              {{> atoms-cmn-play-pause}}
            {{/with}}
          </div>
          <!-- Mobile Only Image -->
          <div class="m-largeBanner__img -mobile sm:hidden" style="background-image:url('{{BgVideo.BgMobile}}');">
            <img class="sr-only" src="{{BgVideo.BgMobile}}" alt="{{BgVideo.AltMobile}}">
          </div>
        {{/if}}

        {{#unless BgVideo}}
          <!-- Mobile Image -->
          <div class="m-largeBanner__img -mobile sm:hidden" style="background-image:url('{{ImageSrc.Mobile}}');">
            <img class="sr-only" src="{{ImageSrc.Mobile}}" alt="{{ImageAltText}}">
          </div>
          <!-- Desktop Image -->
          <div class="m-largeBanner__img -desktop to-sm:hidden" style="background-image:url('{{ImageSrc.Desktop}}');">
            <img class="sr-only" src="{{ImageSrc.Desktop}}" alt="{{ImageAltText}}">
          </div>
        {{/unless}}
      </div>
    {{/unless}}
    <div class="m-largeBanner__content {{TextAlignment}} {{#if TextContain}}-textContain{{/if}}">
      {{#unless RTEContent}}
        {{#if Title}}
          <h2 class="m-largeBanner__title">{{Title}}</h2>
        {{/if}}
        {{#unless ../CollapseEmptyBanner}}
          {{#if Subtitle}}
            <p class="m-largeBanner__subtitle">{{Subtitle}}</p>
          {{/if}}
          {{#if Description}}
            <p class="m-largeBanner__description">{{Description}}</p>
          {{/if}}
        {{/unless}}
        {{#if CTA}}
          <div class="m-largeBanner__cta">
            {{#each CTA}}
              <a href="{{Link}}" class="a-button -green mx-10">{{Text}}</a>
            {{/each}}
          </div>
        {{/if}}
      {{else}}
        <div class="m-rte">
          {{!-- Start: RTE Content --}}
          {{{RTEContent}}}
          {{!-- End: RTE Content --}}
        </div>
      {{/unless}}
    </div>

    {{#ToggleVideo}}
      <div class="m-largeBanner__play {{#if AllowCustomIconPosition}}-customIconPosition{{/if}}">
        {{> molecules-cmn-video-toggle-button}}
      </div>
    {{/ToggleVideo}}

  </div>
{{/LargeBanner}}