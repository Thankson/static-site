{{> organisms-site-header}}
<section class="p-signIn">
  <div class="p-signIn__container">
    <h1 class="p-signIn__heading">{{PageTitle}}</h1>
    <div class="p-signIn__row -top {{#if IsReferred}}-isReferred{{/if}}">
      <div class="p-signIn__col -left {{#if IsReferred}}lg:ml-30{{else}}lg:mr-30{{/if}}">
        <div class="p-signIn__logo">
          <img class="p-signIn__img -logo" src="//cdnus.melaleuca.com/Images/about/home-page/desktop/melaleuca-logo.svg" alt="Melaleuca Logo">
        </div>
        {{> organisms-sign-in-card-vue}}
      </div>
      <div class="p-signIn__col -right">
        <h2 class="p-signIn__title">Not a Member Yet?</h2>
        <p class="p-signIn__description">Discover all the ways that Melaleuca enhances the lives of thousands of people just like you by helping people reach their goals. Learn how members of Melaleuca are spending less money for safer, more effective products, getting out of debt, and making a difference in the lives of those they touch.</p>
        <a class="p-signIn__link" href="#" data-gtm-track=' { "gtmId": "182", "gtmText": "Get to know melaleuca" }'>Get to know melaleuca</a>
        <div class="p-signIn__media">
          {{> atoms-corner-imagery}}
        </div>
      </div>
    </div>
  </div>
  <div class="p-signIn__row -bottom">
    {{#with FeedBack}}
      <h4 class="p-signIn__text">
        {{{Text}}}
      </h4>
      <a class="p-signIn__btn" href="#">
        {{BtnText}}
      </a>
    {{/with}}
  </div>
</section>
{{> organisms-site-footer }}