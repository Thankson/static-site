<h2 class="text-3xl font-light tracking-tight leading-base md:text-5xl mb-5">{{Name}}</h2>
<p class="text-base font-medium tracking-tight {{#if VIPTitle}}mb-5{{else}}mb-30{{/if}} text-gray-100 md:text-2xl">{{Title}}</p>
{{#if VIPTitle}}
  <p class="text-base font-medium tracking-tight mb-30 text-gray md:text-xl">{{VIPTitle}}</p>
{{/if}}
<p class="text-sm text-gray-150 mb-8 md:text-md">
  <span class="font-semibold uppercase mr-3">{{NumberLabel}}:</span>
  {{Number}}
</p>

{{#with CTA}}
  <button id="become-mkt-exec" class="a-button -large -white my-20 w-full text-center justify-around md:w-11_12" data-href="{{Url}}" {{#if Gtm}} data-gtm-track='
            {
                "gtmId": {{Gtm.Id}},
                "gtmText": "{{Gtm.Text}}"
            }
        ' {{/if}}>
    {{Label}}
  </button>
  <span class="becomeMktExec__loading hidden">{{> atoms-cmn-loading-spinner}}</span>
{{/with}}