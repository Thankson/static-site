<header class="o-siteHeader -isCn disableFocus -isCnFocus">
  <div class="o-siteHeader__row -eyebrow">
    {{#Eyebrow}}
      {{> molecules-eyebrow-nav}}
    {{/Eyebrow}}
  </div>

  <div class="o-siteHeader__row -main">
    <div class="o-siteHeader__col -nav">
      {{> molecules-nav-menu}}
    </div>

    <div class="o-siteHeader__col -logo" data-testid="container-logoWrapper">
      <a href="https://www.melaleuca.com/" class="block">
        <img class="lg:hidden" src="//cdnsc1.melaleuca.com/na/images/header/leaf-drop-logo2x.png" alt="Melaleuca Logo">
        <img class="to-lg:hidden max-w-120" src="//cdnsc1.melaleuca.com/na/images/footer/melaleuca-logo-white-full.png" alt="Melaleuca Logo">
      </a>
    </div>

    <!-- Search bar -->
    <div class="o-siteHeader__col -search">
      {{#with Search}}
        <script type="application/json" id="searchBar">
        {{toJson Localization}}
        </script>
        <o-search-bar script-id="searchBar" />
      {{/with}}
    </div>

    <div class="o-siteHeader__col -actions" data-myaccount-icon="https://cdnsc1.melaleuca.com/na/images/header/icon-account-2.png" data-notification-icon="https://cdnsc1.melaleuca.com/na/images/header/icon-notifications2x.png">
      <!-- ORDERS -->
      {{#with Actions.Orders}}
        <div class="relative md:flex hidden">
          <popup-orders label="{{Label}}" footer-link="{{Link}}" />
        </div>
      {{/with}}

      <!-- LISTS -->
      {{#with Actions.Lists}}
        <div class="relative md:flex hidden">
          <script type="application/json" id="popupListsLabels">
          {{toJson Localization}}
          </script>
          <popup-lists script-id="popupListsLabels"></popup-lists>
        </div>
      {{/with}}

      <!-- NOTIFICATIONS -->
      {{#with Actions.NotificationsPopup}}
        <div class="relative md:flex hidden">
          <popup-notifications button-aria-label="{{Notifications.PageTitle}}" label="{{Notifications.PageTitle}}" icon="{{Notifications.Icon.Path}}" icon-class="{{Notifications.Icon.Classes}}" icon-alt="{{Notifications.Icon.Alt}}" footer-link="{{Notifications.Link}}" footer-title="{{Notifications.FooterTitle}}">

            <template v-slot:notification-content>
              <notifications action-btn-text="Close video modal" modifier-molecule="-popup" no-notification-image="//cdnsc1.melaleuca.com/na/images/common/no-notif-desktop.png" no-notification-text="Check back later for new notifications." no-notification-title="You're All Caught Up" remove-btn-text="Remove notification" remove-btn-icon="//cdnsc1.melaleuca.com/na/images/common/trash.png" :enable-new-webalert="{{EnableNewWebAlertFeatureFlag}}">
              </notifications>
            </template>

          </popup-notifications>
        </div>
      {{/with}}

      {{#with Actions.SignIn.Desktop}}
        <div class="relative md:flex hidden pr-30">
          {{>atoms-cmn-author-btn}}
        </div>
      {{/with}}

      {{#with Actions.SignIn.Mobile}}
        <div class="relative mr-8 flex md:hidden">
          {{>atoms-cmn-author-btn}}
        </div>
      {{/with}}

      {{#Actions.MyAccount}}
        {{> organisms-my-account-popup }}
      {{/Actions.MyAccount}}

      {{#Actions.Cart}}
        {{> organisms-cart-icon }}
      {{/Actions.Cart}}
    </div>
  </div>
</header>