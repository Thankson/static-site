<modal :visible="true" width="{{Width}}">
  {{#if Content}}
    <template v-slot:content>
      {{{Content.RTE}}}
      <a href="{{Content.Link.Url}}" class="a-button -medium mt-32" {{#with Gtm}} {{> gtmTrack}} {{/with}}>
        {{Content.Link.Text}}
      </a>
    </template>
  {{/if}}
</modal>

{{#*inline "gtmTrack"}}
  v-on:click="gtmTrackAction({ id:'{{Id}}'{{#if Text}}, text:'{{Text}}'{{/if}} }, $event)"
{{/inline}}