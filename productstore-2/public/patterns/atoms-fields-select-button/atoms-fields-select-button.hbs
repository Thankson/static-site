<div class="a-select {{Select.Mod}}" id="{{Id}}">
  <select id="{{UniqueId}}" class="a-select__field" aria-label="{{Select.AriaLabel}}" {{#if Required}} data-rule-required="{{Required}}" data-msg-required="{{ValidationAlert}}" aria-required="{{Required}}" name="{{Name}}" {{/if}} {{#if Gtm}} data-gtm-track='
            {
                "gtmId": {{Gtm.Id}},
                "gtmText": "{{Gtm.Text}}"
            }
        ' {{/if}}>
    {{#each Options}}
      {{#if @first}}
        {{#if ../IsFirstEmpty}}
          <option value="">{{Label}}</option>
        {{else}}
          <option {{#if Value}}value="{{Value}}" {{/if}} {{#if Selected}}selected="selected" {{/if}}>{{Label}}
          </option>
        {{/if}}
      {{else}}
        <option {{#if Value}}value="{{Value}}" {{/if}} {{#if Selected}}selected="selected" {{/if}}>{{Label}}</option>
      {{/if}}
    {{/each}}
  </select>
  {{#with Arrow}}{{> atoms-arrow}}{{/with}}
</div>