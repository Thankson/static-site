{{#ContentCarousel}}
  <section class="m-contentCarousel {{Mod.BackgroundPosition}}" {{#if Mod.BackgroundImage}} style="background-image:{{Mod.BackgroundImage}};" {{else}} style="background:{{Mod.BackgroundColor}};" {{/if}}>
    <header class="m-contentCarousel__header">
      <h4 class="m-contentCarousel__title">{{Title}}</h4>
      <div class="m-contentCarousel__subtitle">{{Subtitle}}</div>
    </header>
    <div class="m-contentCarousel__wrapper" aria-roledescription="carousel" aria-label="{{CarouselDescription}}">
      <nav class="m-contentCarousel__actions">
        <div class="m-contentCarousel__dots"></div>
        <div class="m-contentCarousel__arrows" style="color:{{ArrowColor}};"></div>
      </nav>
      <div class="m-contentCarousel__slider" id="carousel-count-{{UniqueID}}">
        {{#each CarouselImage}}
          <a href="{{Link}}" class="m-contentCarousel__slide">
            <img class="m-contentCarousel__image" src="{{Src}}" alt="{{Alt}}">
          </a>
        {{/each}}
      </div>
    </div>
  </section>
{{/ContentCarousel}}