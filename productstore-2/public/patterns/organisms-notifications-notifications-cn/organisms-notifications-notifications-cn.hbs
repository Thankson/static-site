{{#Notifications}}
  <div id="{{#if IsCn}}notificationsTop{{/if}}" class="o-notifications -page {{Modifier}}">
    {{#if EnableNewWebAlertFeatureFlag}}
      <input type="hidden" name="enableNewWebAlertFeatureFlag" data-webalert-flag={{EnableNewWebAlertFeatureFlag}} />
    {{/if}}

    {{#if IsPage}}
      <div class="mx-auto max-w-contain mb-10 pt-85 px-20 md:flex md:items-center md:justify-between">
        <h1 class="font-bold text-2xl text-gray-150 uppercase block to-md:mb-15 md:text-4xl md:inline md:normal-case">
          {{PageTitle}}
        </h1>

        {{> organisms-pwa-notification-toggle }}

        {{#if Groups}}
          <div class="block mb-36 md:mb-0">
            {{#if Options}}
              <div id="" class="a-select" data-notif-select>
                <select id="" aria-label="Choose a notification filter type" class="a-select__field bg-white pl-10" v-on:change="gtmTrackAction({ 'id':'188' }, $event)">
                  {{#each Options}}
                    <option value={{Type}}>{{Label}}</option>
                  {{/each}}
                </select>
                {{#with Select.Arrow}}{{> atoms-arrow}}{{/with}}
              </div>
            {{/if}}
          </div>
        {{/if}}
      </div>
    {{/if}}

    {{#if Groups}}
      <div class="font-global-sans text-gray-150 text-base max-w-contain {{GroupsMods}}" data-notif-groups>
        {{#each Groups}}
          <div data-notif-date="{{Date}}">
            {{#if Title}}
              <h2 class="border-b-1 border-gray-50 w-full block px-2 py-4 text-lg mb-20 md:mb-0">{{Title}}</h2>
            {{/if}}
            <ul>
              {{#each Row}}
                <li class="{{RowMods}}" data-notif-type="{{Type}}" data-notif-hidden="false">
                  {{> molecules-notification}}
                </li>
              {{/each}}
            </ul>
          </div>
        {{/each}}
        <!-- Back To Top anchor -->
        {{#if IsCn}}
          <a href="#notificationsTop" class="o-notifications__button text-white block text-right -anchor">
            <span class="material-icons border bg-gray-100 p-5 rounded-full" aria-hidden="true">arrow_upward</span>
          </a>
        {{/if}}
      </div>

    {{else}}

      {{> molecules-no-notifications}}

    {{/if}}
  </div>
{{/Notifications}}

<script id="data-shelf-configurator-localization" type="application/json">
{{toJson Localization }}
</script>