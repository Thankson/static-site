<modal :visible="true" {{#unless ModalHeading}}:heading-visible="false" {{/unless}} {{#if Width}}width="{{Width}}" {{/if}}>
  {{#if ModalHeading}}
    <template v-slot:heading>
      {{{ModalHeading}}}
    </template>
  {{/if}}

  {{#if ModalBody}}
    <template v-slot:body>
      {{{ModalBody}}}
    </template>
  {{/if}}

  {{#with ModalFooter}}
    <template v-slot:footer>
      {{#if SecondaryLink}}
        <a href="{{SecondaryLink.Url}}" class="a-button -white {{SecondaryLink.Mod}}">
          {{SecondaryLink.Text}}
        </a>
      {{/if}}
      <a href="{{#if LinkLabel.Url}}{{LinkLabel.Url}}{{/if}}" class="a-button {{LinkLabel.Mod}}" {{#with Gtm}} {{> gtmTrack}} {{/with}}>
        {{#if LinkLabel.Text}} {{LinkLabel.Text}} {{else}} {{LinkLabel}}{{/if}}
      </a>
    </template>
  {{/with}}
</modal>

{{#*inline "gtmTrack"}}
  v-on:click="gtmTrackAction({ id:'{{Id}}'{{#if Text}}, text:'{{Text}}'{{/if}} }, $event)"
{{/inline}}