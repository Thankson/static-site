<!-- START 12765 - Product-Media -->
{{#ProductMedia}}

  <div class="m-prodMedia" aria-label="{{Description}}" data-js="productMedia">

    <!-- thumbs -->
    <div class="m-prodMedia__wrapper -thumbs" aria-hidden="false" data-label-count="{{Labels.Count}}" data-label-media="{{Labels.Media}}" data-label-of="{{Labels.Of}}" data-label-showing="{{Labels.Showing}}" data-label-selected="{{Labels.Selected}}" data-label-previous="{{Labels.Previous}}" data-label-next="{{Labels.Next}}" data-label-click-to-zoom="{{Labels.ClickToZoom}}">
      <nav class="m-prodMedia__actions -thumbs">
        <div class="m-prodMedia__arrows"></div>
      </nav>
      <div class="m-prodMedia__list -thumbs">
        {{#each Media}}
          <button class="m-prodMedia__thumb {{#if IsVideo}}-video{{/if}}" aria-label="{{Description}}">
            <img src="{{Thumb}}" alt="{{Alt}}" class="noLazy">
          </button>
        {{/each}}
      </div>
    </div>
    <!-- End thumbs -->

    <!-- images and videos-->
    <div class="m-prodMedia__wrapper -images" id="m-prodMedia">

      <nav class="m-prodMedia__actions -images">
        <div class="m-prodMedia__counter"></div>
        <div class="m-prodMedia__arrows"></div>
      </nav>

      <div class="m-prodMedia__zoom">
        <div class="m-prodMedia__zoomImage"></div>
      </div>

      <div class="m-prodMedia__list -images">
        {{#each Media}}
          <div class="m-prodMedia__mediaItem" {{#if ImageBig}}data-zoom="{{ImageBig}}" {{/if}}>
            {{!-- Modal Video --}}
            {{#if Localization}}
              <o-vid-curate-ctrl script-id="{{Localization.Data.UniqueScriptID}}" :is-video-btn="false" class="m-prodMedia__video">
              </o-vid-curate-ctrl>

              <script type="application/json" id="{{Localization.Data.UniqueScriptID}}">{{toJson Localization}}</script>
            {{/if}}

            {{!-- All images except video --}}
            {{#unless Localization}}
              <div class="m-prodMedia__mediaItem__contain">
                <img class="m-prodMedia__image" src="{{Image}}" alt="{{Description}}" {{#if Localization}} aria-hidden="true" {{/if}}>
              </div>
            {{/unless}}

          </div>
        {{/each}}
      </div>
    </div>
    <!-- End images -->

    <!-- lightbox -->
    <div class="m-prodMedia__wrapper -lightbox" role="dialog">
      <div class="m-prodMedia__lightbox" aria-hidden="true">
        <nav class="m-prodMedia__actions -lightbox">
          <div class="m-prodMedia__counter -lightbox"></div>
          <div class="m-prodMedia__arrows -lightbox"></div>
          <button class="m-prodMedia__close">{{CloseLighbox}}</button>
        </nav>
        <!-- <div class="m-prodMedia__lightboxList"> -->
        <div class="m-prodMedia__list -lightbox">
          {{#each Media}}
            {{#if ImageBig}}
              <div class="m-prodMedia__lightboxImage">
                <img src="{{ImageBig}}" alt="{{Description}}" class="m-prodMedia__lightboxZoom">
              </div>
            {{/if}}
          {{/each}}
        </div>
      </div>
    </div>
    <!-- End lightbox -->

  </div>
{{/ProductMedia}}

<!-- END START 12765 - Product-Media -->