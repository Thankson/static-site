<ul class="o-cardGrid {{> SetClass}}">
  {{#each Cards}}
    <li class="o-cardGrid__listItem">
      {{#ifvalue ../ListModifier equals='-csr'}}
        {{> molecules-csr-resources-card }}
      {{/ifvalue}}

      {{#ifvalue ../ListModifier equals='-natureFund'}}
        {{> molecules-cmn-resources-card }}
      {{/ifvalue}}
    </li>
  {{/each}}
</ul>

{{#*inline "SetClass"}}
  {{#ifvalue ListModifier equals='-csr'}}-csr{{/ifvalue}}
  {{#ifvalue ListModifier equals='-natureFund'}}-natureFund{{/ifvalue}}
{{/inline}}