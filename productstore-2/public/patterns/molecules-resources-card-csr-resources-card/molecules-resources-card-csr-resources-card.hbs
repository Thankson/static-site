{{#Card}}
  <div class="m-resourcesCard {{Modifier}}">

    <div class="m-resourcesCard__media">
      {{#if Image}}
        <img class="m-resourcesCard__img" src="{{Image}}" alt="{{ImageAltText}}">
      {{/if}}
    </div>
    <p class="m-resourcesCard__content">
      <em class="m-resourcesCard__title">{{Heading}} </em>
      {{#if Subtitle}}<span class="m-resourcesCard__subtitle">{{Subtitle}}</span>{{/if}}
    </p>
    {{#if Link}}
      <a href="{{Link.Href}}" class="m-resourcesCard__link align-middle -isCn">
        {{Link.Text}}<span aria-hidden="true" class="a-arrow -thinner -sm2 ml-5 border-green align-middle"><span class="a-arrow__icon border-green"></span></span>
      </a>
    {{/if}}

  </div>
{{/Card}}