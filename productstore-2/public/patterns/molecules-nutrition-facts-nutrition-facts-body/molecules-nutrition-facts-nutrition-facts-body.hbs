{{#with NfactsBody}}
  <div class="m-nutriFacts__body">
    <table class="m-nutriFacts__table {{BorderSize}}">
      <caption class="sr-only">{{Caption}}</caption>
      {{#with Thead}}
        <thead>
          {{#if ../IsDrugTable}}
            {{> DrugTableHead}}
          {{else}}
            {{> TableHead}}
          {{/if}}
        </thead>
      {{/with}}
      <tbody>
        {{#each Rows}}
          {{#if ../IsDrugTable}}
            {{> DrugTableRow}}
          {{else}}
            {{> TableRow}}
          {{/if}}
          {{#if IndentRows}}
            {{#each IndentRows}}
              {{#if ../../IsDrugTable}}
                {{> DrugTableIndentRow}}
              {{else}}
                {{> TableIndentRow}}
              {{/if}}
            {{/each}}
          {{/if}}
        {{/each}}
        {{#with AdditionalRow}}
          {{> AdditionalRow}}
        {{/with}}
        {{#if Note}}
          {{> Note}}
        {{/if}}
      </tbody>
    </table>
  </div>
{{/with}}


{{!-- Start: Drug Table thead --}}
{{#*inline "DrugTableHead"}}
  <tr class="m-nutriFacts__row">
    <th colspan="4" class="m-nutriFacts__label font-bold text-left text-sm">{{{Label}}}</th>
    <td class="m-nutriFacts__value font-bold">{{{SecondCol}}}</td>
  </tr>
  {{#with IndentRows}}
    <tr class="m-nutriFacts__row">
      <td class="m-nutriFacts__empty -medium"></td>
      <td colspan="3" class="m-nutriFacts__label text-left text-sm">{{{Label}}}</td>
      <td class="m-nutriFacts__value">{{{SecondCol}}}</td>
    </tr>
  {{/with}}
{{/inline}}
{{!-- End: Drug Table thead --}}

{{!-- Start: Table thead --}}
{{#*inline "TableHead"}}
  {{#if Calories}}
    <tr>
      <th colspan="4" class="m-nutriFacts__calories">
        <span class="m-nutriFacts__title -pre">{{{Ammount.Label}}}</span>
        <span class="m-nutriFacts__title">{{{Calories.Label}}}</span>
      </th>
      <td class="m-nutriFacts__value -calories">{{{Calories.Value}}}</td>
    </tr>
  {{/if}}

  {{#if DV}}
    <tr class="m-nutriFacts__row">
      <td colspan="5" class="m-nutriFacts__value font-bold">{{{DV}}}</td>
    </tr>
  {{/if}}

{{/inline}}
{{!-- End: Table thead --}}

{{!-- Start: Drug Table Row --}}
{{#*inline "DrugTableRow"}}
  <tr class="m-nutriFacts__row">
    <th colspan="5" class="m-nutriFacts__label font-normal text-left text-sm">{{{Label}}}</th>
  </tr>
{{/inline}}
{{!-- End: Drug Table Row --}}

{{!-- Start: Table Row --}}
{{#*inline "TableRow"}}
  <tr class="m-nutriFacts__row">
    <th colspan="3" class="m-nutriFacts__label font-bold text-left text-sm">{{{Label}}}</th>
    <td class="m-nutriFacts__value">{{{SecondCol}}}</td>
    <td class="m-nutriFacts__value">{{{ThirdCol}}}</td>
  </tr>
{{/inline}}
{{!-- End: Table Row --}}

{{!-- Start: Drug Table Indent Row --}}
{{#*inline "DrugTableIndentRow"}}
  <tr class="m-nutriFacts__row">
    <td class="m-nutriFacts__empty -medium"></td>
    <td colspan="4" class="m-nutriFacts__label text-left text-sm">{{{Label}}}</td>
  </tr>
{{/inline}}
{{!-- End: Drug Table Indent Row --}}

{{!-- Start: Table Indent Row --}}
{{#*inline "TableIndentRow"}}
  <tr class="m-nutriFacts__row">
    <td class="m-nutriFacts__empty -medium"></td>
    <td colspan="2" class="m-nutriFacts__label text-left text-sm">{{{Label}}}</td>
    <td class="m-nutriFacts__value">{{{SecondCol}}}</td>
    <td class="m-nutriFacts__value">{{{ThirdCol}}}</td>
  </tr>
  {{#if SubIndentRows}}
    {{#each SubIndentRows}}
      <tr class="m-nutriFacts__row">
        <td class="m-nutriFacts__empty -medium"></td>
        <td class="m-nutriFacts__empty -medium"></td>
        <td class="m-nutriFacts__label text-left text-sm">{{{Label}}}</td>
        <td class="m-nutriFacts__value">{{{SecondCol}}}</td>
        <td class="m-nutriFacts__value">{{{ThirdCol}}}</td>
      </tr>
    {{/each}}
  {{/if}}
{{/inline}}
{{!-- End: Table Indent Row --}}

{{!-- Start: Additional Row --}}
{{#*inline "AdditionalRow"}}
  <tr class="m-nutriFacts__row -topThick">
    <th colspan="3" class="m-nutriFacts__label font-bold text-left text-sm">{{{Label}}}</th>
    <td class="m-nutriFacts__value">{{{SecondCol}}}</td>
    <td class="m-nutriFacts__value">{{{ThirdCol}}}</td>
  </tr>
  {{#with IndentRows}}
    <tr class="m-nutriFacts__row">
      <td class="m-nutriFacts__empty -medium"></td>
      <td colspan="3" class="m-nutriFacts__label text-left text-xs">{{{Label}}}</td>
      <td class="m-nutriFacts__value">{{{SecondCol}}}</td>
    </tr>
  {{/with}}
{{/inline}}
{{!-- End: Additional Row --}}

{{!-- Start: Note --}}
{{#*inline "Note"}}
  <tr class="m-nutriFacts__footNotes -topThick">
    <td colspan="5" class="m-nutriFacts__label text-left text-xs">
      <span class="sr-only">Footnotes</span>
      {{{Note}}}
    </td>
  </tr>
{{/inline}}
{{!-- End: Note --}}