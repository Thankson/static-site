{{#ContentCard}}
  <div class="m-contentCard {{TextAlignment}}">
    <div class="m-contentCard__media">
      <img src="{{Image.src}}" alt="{{Image.alt}}" class="m-contentCard__img" />

      {{#with ../ToggleVideo}}
        {{> molecules-cmn-video-toggle-button }}
      {{/with}}
    </div>

    <p class="m-contentCard__description">
      <em class="m-contentCard__title" {{#if TitleColor}}style="color: {{ TitleColor }};" {{/if}}>{{Title}}</em>
      <span class="m-contentCard__subtitle" {{#if SubtitleColor}}style="color: {{ SubtitleColor }};" {{/if}}>{{Subtitle}}</span>
    </p>
  </div>
{{/ContentCard}}