<nav class="o-featuredMenu">
  <ul class="o-featuredMenu__list">
    {{#each featuredMenu.MenuList}}
      <li class="o-featuredMenu__item">
        <a class="o-featuredMenu__link" href="{{IconLink}}">
          <img src="{{IconImage}}" alt="{{AltText}}" class="o-featuredMenu__img" />
          <span class="o-featuredMenu__title">{{IconTitle}}</span>
        </a>
      </li>
    {{/each}}
  </ul>
</nav>