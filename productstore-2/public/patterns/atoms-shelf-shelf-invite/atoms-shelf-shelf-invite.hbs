<div class="a-inviteRail -fixed">
  <a-shelf-toggle class="a-inviteToggle {{InviteToggleClassSet}}" data-testid="{{DataTestId}}" shelf-id="invite-shelf" :heading-visible="false">
    <span class="a-inviteToggle__label">
      <span class="a-inviteToggle__labelDesktop">{{LabelDesktop}}</span>
      <span class="a-inviteToggle__labelMobile">{{LabelMobile}}</span>
    </span>

    {{#if CloseSrLabel}}<template v-slot:close-sr-label>{{CloseSrLabel}}</template>{{/if}}
    {{!-- heading is intentionally omitted --}}
    {{#if Content}} <template v-slot:content>{{{Content}}}</template>{{/if}}
  </a-shelf-toggle>
</div>