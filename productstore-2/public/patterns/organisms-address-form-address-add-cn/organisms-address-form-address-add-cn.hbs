<form action="" method="post" id="add-address-cn" class="o-addressCn -add w-full px-10 pt-30 pb-36 mx-auto mt-10 mb-0 bg-white border max-w-contain border-gray-50 text-gray-150 md:mb-40 md:px-40 md:rounded">

  <div class="w-full flex flex-col lg:flex-row">
    <div class="w-full lg:w-1_2 lg:pr-20">

      <input type="hidden" id="addressid" name="addressid" value="0">
      <input type="hidden" id="country" name="country" value="China">

      {{#RecipientName}}
        <div class="lg:pb-7 relative">
          {{> molecules-form-field-basic}}
        </div>
      {{/RecipientName}}

      {{#PhoneNumber}}
        <div class="lg:pb-7 relative">
          {{> molecules-form-field-basic}}
        </div>
      {{/PhoneNumber}}

      {{#Area}}
      <div class="lg:pb-7 relative">
        {{> molecules-area-select}}
      </div>
      {{/Area}}

      {{#Street}}
        <div class="lg:pb-7 relative">
          {{> molecules-form-field-basic}}
        </div>
      {{/Street}}


      {{#ZipCode}}
        <div class="lg:pb-7 relative">
          {{> molecules-form-field-basic}}
        </div>
      {{/ZipCode}}
    </div>
  </div>

  {{#MakeDefaultShipAddress}}
    <div class="w-full pb-24">
      {{> molecules-form-field-checkbox}}
    </div>
  {{/MakeDefaultShipAddress}}

  <div class="w-full">
    <div class="flex pb-30 to-xs:justify-between">
      <div class="xs:mr-30 text-center to-xs:w-1_2 to-xs:mr-10">
        {{#Cancel}}
          {{> atoms-button}}
        {{/Cancel}}
      </div>
      <div class="text-center to-xs:w-1_2">
        {{!-- Vue.js save button --}}
        {{#Save}}
          {{> atoms-button}}
        {{/Save}}
      </div>
    </div>
    <div data-loading="address__loading" class="hidden">
      <span class="w-10 block">{{> atoms-cmn-loading-spinner}}</span>
    </div>
    <div data-answer="address__answer" class="hidden"></div>
    <div data-target-error-cn="add-address-cn"></div>
  </div>

  <div class="hidden-answers hidden">
    {{#VerifyAddress}}
      <div class="address-entered">{{AddressEntered}}</div>
      <div class="address-not-availabe">{{AddressNotAvailabe}}</div>
      <div class="address-sugested">{{AddressSugested}}</div>
      <div class="modal-title">{{ModalTitle}}</div>
      <div class="suggestions-in-total">{{SuggestionsInTotal}}</div>
      <div class="problem-with-address">{{ProblemWithAddress}}</div>
    {{/VerifyAddress}}
  </div>

</form>