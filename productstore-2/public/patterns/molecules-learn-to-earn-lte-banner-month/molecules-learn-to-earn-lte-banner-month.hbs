{{#LTEMBMBanner}}
  <article class="m-lteMBMBanner" style="background: {{BgColor}}">
    <header class="m-lteMBMBanner__header">
      <h3 class="m-lteMBMBanner__title">{{Title}}</h3>
    </header>
    <ul class="m-lteMBMBanner__row">
      {{#each Col}}
        <li class="m-lteMBMBanner__col">
          <h4 class="m-lteMBMBanner__month">{{Month}}</h4>
          <div class="m-lteMBMBanner__description m-rte">
            {{{RTE}}}
          </div>
        </li>
      {{/each}}
    </ul>
  </article>
{{/LTEMBMBanner}}