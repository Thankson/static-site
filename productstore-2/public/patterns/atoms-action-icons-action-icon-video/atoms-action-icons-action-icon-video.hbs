{{#if Cart}}
  <o-shelf-configurator class="a-actionIcon" aria-label="{{AriaLabel}}" sku="{{Sku}}" family-id="{{FamilyId}}" script-id="data-shelf-configurator-localization">
    <img src="//cdnsc1.melaleuca.com/na/images/header/add-cart-icon.png" class="a-actionIcon__img" />
  </o-shelf-configurator>
{{else if Video}}
  <o-video-modal-button id="{{Data.Id}}" class="a-actionIcon" :localization='{{toJson Video.Data.Localization}}' :video-data='{{toJson Video.Data.Video.VirtualVideo}}'>
    {{!-- Simple button example --}}
    <img src="{{Icon}}" class="a-actionIcon__img">
  </o-video-modal-button>
{{else}}
  <button class="a-actionIcon {{Mod}}" aria-label="{{Description}}">
    <img src="{{Icon}}" class="a-actionIcon__img">
  </button>
{{/if}}