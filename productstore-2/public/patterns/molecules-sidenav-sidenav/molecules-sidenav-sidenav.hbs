{{#SideNav}}
  <nav>
    <h3 class="text-2xl font-extrabold tracking-tight uppercase mb-15 {{#if IsCn}}md:text-xl{{/if}} md:font-medium md:mb-5 to-md:hidden">{{SectionTitle}}</h3>
    <ul class="text-sm font-medium leading-relaxed text-green-100 mr-15 to-md:hidden {{#unless IsCn}}md:text-md{{else}}md:text-base{{/unless}}">
      {{#each ListItem}}
        <li class="my-24 md:my-3">
          <a href="{{URL}}">{{Label}}</a>
          <ul class="test">
            {{#each InnerItem}}
              <li class="text-black border-l-4 border-clear font-normal pl-6 my-24 leading-normal md:my-8 {{#if Active}}border-green-100 font-semibold{{/if}}">
                <a href="{{URL}}">{{Label}}</a>
              </li>
            {{/each}}
          </ul>
        </li>
      {{/each}}
    </ul>
  </nav>
{{/SideNav}}