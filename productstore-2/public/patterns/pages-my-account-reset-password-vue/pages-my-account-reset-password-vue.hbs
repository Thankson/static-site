{{> organisms-site-header}}
<div class="bg-gray-25">
  <nav class="top-0 py-0 my-0 bg-white md:hidden">
    {{#MobileAccordionNav}}
      {{> organisms-cmn-accordion}}
    {{/MobileAccordionNav}}
  </nav>

  <section class=" md:py-40">
    <h1 class="w-full mx-auto text-2xl font-bold tracking-tight text-gray-150 max-w-contain font-global-sans mb-18 md:text-4xl to-md:px-10 to-md:pt-20">
      {{PageTitle}}
    </h1>

    <div class="w-full px-10 py-40 mx-auto mt-10 mb-0 bg-white border max-w-contain border-gray-50 text-gray-150 md:mb-20 md:px-40 md:rounded">
      {{#if IsCn}}
        <h2 class="leading-none text-xl bg-gray-150 mb-25">{{PageSubTitle}}</h2>
      {{/if}}

      {{> organisms-reset-password-vue}}

    </div>
  </section>

</div>
{{> organisms-site-footer}}