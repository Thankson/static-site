<!-- Start: PDP Ingredients Organism-->
<div class="w-full mx-auto xl:max-w-xl">
  {{#if IngredientSummaries}}
    <div class="flex flex-wrap justify-start max-w-xl px-8 mb-20 mx-auto lg:justify-between lg:px-20">
      <!-- Start: ingredients summary cards -->
      {{#each IngredientSummaries}}
        {{> molecules-ingredient-summary}}
      {{/each}}
      <!-- End: ingredients summary cards -->
    </div>
  {{/if}}

  {{#if GlossaryItems}}
    {{> organisms-ingredient-glossary}}
  {{/if}}

  {{#if FooterText}}
    <p class="text-left w-full max-w-xl pt-40 px-8 mb-20 mx-auto lg:px-20">
      {{{FooterText}}}
    </p>
  {{/if}}

  {{IngredientPhilosophy}}
</div>
<!-- End: PDP Ingredients Organism-->