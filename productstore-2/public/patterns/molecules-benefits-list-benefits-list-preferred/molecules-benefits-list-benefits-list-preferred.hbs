{{#with BenefitsList}}
  <article class="m-benefitsList -preferred {{ListOrientation}} {{ColsPerRow}} {{#if BorderAll}}-border{{/if}}" {{#if BgColor}}style="background: {{BgColor}};" {{/if}}>
    <header class="m-benefitsList__header">{{{Header}}}</header>
    <ul class="m-benefitsList__list">
      {{#each Benefits}}
        <li class="m-benefitsList__item" {{#if ../BorderIndividualListItem}}style="border-width: {{../BorderWidth}}; border-color: {{../BorderColor}};" {{/if}}>
          <img class="m-benefitsList__image" src="{{Image.Src}}" alt="{{Image.Alt}}">
          <div class="m-benefitsList__description">{{{Description}}}</div>
        </li>
      {{/each}}
    </ul>
  </article>
{{/with}}