{{#ThumbBanner}}
  <article class="m-thumbBanner">
    <div class="m-thumbBanner__row -backgrounds">
      <picture class="m-thumbBanner__picture">
        {{#if BgImg.Mobile}}
          <source srcset="{{BgImg.Mobile}}" media="(max-width: 414px)" class="m-thumbBanner__srcset">
        {{/if}}

        {{#if BgImg.Tablet}}
          <source srcset="{{BgImg.Tablet}}" media="(max-width: 1209px)" class="m-thumbBanner__srcset">
        {{/if}}

        {{#if BgImg.Desktop}}
          <source srcset="{{BgImg.Desktop}}" media="(min-width: 1210px)" class="m-thumbBanner__srcset">
        {{/if}}

        <img src="{{BgImg.Desktop}}" alt="{{BgImg.Alt}}" class="m-thumbBanner__image">
      </picture>
    </div>

    <div class="m-thumbBanner__row -container {{BgColorMod}}">
      <div class="m-thumbBanner__row -content">
        <div class="m-thumbBanner__rte m-rte">
          {{{Title}}}
        </div>
        <div class="m-thumbBanner__media">
          <img class="m-thumbBanner__thumb" src="{{VideoThumb}}" aria-hidden="true">
          <div class="m-thumbBanner__video">
            {{#with ../ToggleVideo}}
              {{> molecules-cmn-video-toggle-button}}
            {{/with}}
          </div>
        </div>
      </div>
    </div>
  </article>
{{/ThumbBanner}}