<div class="relative flex w-150 mx-auto">
  <button class="popUp-toggler text-base text-semibold leading-base flex justify-center items-center border-none mr-24" type="button" name="button" aria-pressed="false">
    <span class="text-green font-bold text-4xl leading-base" aria-hidden="true">+</span> <span class="pt-2 pl-10 pr-6">Accessories</span> ({{Quantity}})<span class="a-arrow -sm -down " aria-hidden="true">

    </span>

  </button>


  {{> molecules-popup}}

</div>

{{!

    Use the `BodyDynamic` property in the JSON file to reference the inline partial below

}}

{{#*inline "PopUpBodyContent"}}
  {{#PopUpBodyContent}}

    <h3 class="text-black text-sm leading-normal font-bold p-20 pb-10">{{Title}}</h3>

    <div class="px-20">
      {{#each ProductInfoRow}}
        <div class="flex py-15 {{#if @last}}border-b-0 {{else}} border-b{{/if}}">
          <div class="w-70">
            <img src="{{Img.Src}}" alt="{{Img.Alt}}" role="Img">
          </div>
          <div class="text-sm flex-grow w-1_3 px-15">
            <a href="{{ProdLabel.CTA}}" aria-label="{{ProdLabel.Aria-Label}}">{{ProdLabel.Label}}</a>
          </div>
          <div class="text-right leading-tight w-48">
            <div class="font-bold">{{Details.Price}}</div>
            <div class="text-xs">{{Details.Pts}}</div>
            <div class="pt-10">
              {{> atoms-action-icon}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>

  {{/PopUpBodyContent}}
{{/inline}}