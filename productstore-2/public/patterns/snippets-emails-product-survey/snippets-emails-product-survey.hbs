{{#with Table}}
  <table style="color:#252525;line-height:1.3;width:100%;">
    {{#each Section}}
      <tbody>
        {{#with Header}}
          <tr style="text-transform:uppercase;font-size:16px;font-weight:700;height:38px;vertical-align:bottom;text-align:left;">
            <th>{{Category}}</th>
            <th {{#if Points}} {{/if}}>{{Points}}</th>
          </tr>
        {{/with}}
        {{#each Rows}}
          <tr style="font-size:14px;">
            <td>{{{CategoryName}}}</td>
            <td>{{Points}}</td>
          </tr>
        {{/each}}
        {{#with Total}}
          <tr style="font-size:14px;background-color:#DDD;font-weight:700">
            <td>{{Text}}</td>
            <td>{{Points}}</td>
          </tr>
        {{/with}}
        {{#with GrandTotal}}
          <tr style="text-transform:uppercase;font-size:16px;font-weight:700;height:40px;vertical-align:bottom;">
            <td>{{Text}}</td>
            <td>{{Points}}</td>
          </tr>
        {{/with}}
      </tbody>
    {{/each}}
  </table>
{{/with}}