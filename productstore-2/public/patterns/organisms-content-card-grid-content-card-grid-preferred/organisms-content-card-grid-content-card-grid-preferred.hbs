<article class="o-preferred">
  <div class="o-preferred__wrapper">
    <header class="o-preferred__header">
      <h2 class="o-preferred__title">{{{HeaderTitle}}}</h2>
      {{{HeaderRTE}}}
    </header>
    <ul class="o-cardGrid {{ListModifier}}">
      {{#each PreferredCards}}
        <li class="o-cardGrid__listItem">
          {{! Replace demoBlock with LIA Card data}}
          {{> molecules-content-card-video-vue-video }}
        </li>
      {{/each}}
    </ul>
    {{#HasTips}}
      <footer class="o-preferred__footer">
        <div style="color: {{TextColor}}">
          {{{Text}}}
        </div>
      </footer>
    {{/HasTips}}
  </div>
</article>