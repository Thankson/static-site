{{> organisms-site-header }}

<section class="pt-10 pb-1 md:pt-75 md:pb-15 bg-gray-25">
  <div class="mx-auto max-w-contain">

    <h1 class="w-full text-2xl-2 font-bold tracking-tight text-gray-150 font-global-sans md:mb-18 to-md:px-10">{{PageTitle}}</h1>

    {{> molecules-tabs-links}}

    {{> organisms-account-settings-profile-backup}}

    <!-- Start: SSN Row -->
    <div class="bg-white border border-gray-50 rounded-md flex to-md:flex-wrap mb-20 md:mb-30">
      <div class="w-full md:w-1_2 px-10 py-25 mb-20 md:mr-15 md:mb-30 md:p-40">
        <h2 class="text-gray-150 text-2xl-2 leading-base mb-20">Social Security Number</h2>
        <p class="text-gray-120 mb-20 md:mb-30">Because you will be earning commissions & bonuses, we are required to collect your Social Security Number for tax reporting purposes.</p>
        <a href="#" class="justify-center w-full text-center text-base text-green leading-base uppercase block bg-white border-green border-1 rounded w-full py-15 px-20" data-gtm-track='
                    {
                        "gtmId": "243",
                        "gtmText": "Enter Social Security Number"
                    }'>
          Enter Social Security Number</a>
      </div>
      <div class="w-full md:w-1_2 px-10 py-25 mb-20 md:ml-15 md:mb-30 md:p-40 to-md:hidden">
        <!-- This empty div is required for consistent spacing -->
      </div>
    </div>
    <!-- End: SSN Row -->

    <!-- Start: Membership Info Row -->
    {{> organisms-membership-info}}
    <!-- End: Membership Info Row -->

    <!-- Start: Recognition Photo and Car Bonus Row -->
    {{#with PhotoCardSection}}
      <!--Using two col grid component markup for wrapping divs-->
      <div class="flex mx-auto to-md:flex-col w-full">
        <div class="md:pr-15 md:mb-30 md:w-1_2">
          {{#with RecognitionPhoto}}
            {{> molecules-photo-card-recognition}}
          {{/with}}
        </div>
        <div class="to-md:my-10 md:pl-15 md:mb-30 md:w-1_2">
          {{#with CarBonus}}
            {{> molecules-photo-card-bonus}}
          {{/with}}
        </div>
      </div>
    {{/with}}
    <!-- End: Recognition Photo and Car Bonus Row -->

    <!-- Start: Communication pref Row -->
    <div class="bg-white border border-gray-50 rounded-md flex mb-20 md:mb-30">
      <div class="w-full px-10 py-25 mb-20 md:mr-15 md:mb-30 md:p-40">
        <h2 class="text-gray-150 text-2xl-2 leading-base mb-20">Communication Preferences</h2>
        {{#with CommunicationPreferences}}
          {{> organisms-communication-preferences}}
        {{/with}}
      </div>
    </div>
    <!-- End: Communication pref Row -->

    <!-- Start: Communication pref Row V2 -->
    <div class="bg-white border border-gray-50 rounded-md flex mb-20 md:mb-30">
      <div class="w-full px-10 py-25 mb-20 md:mr-15 md:mb-30 md:p-40">
        {{#with CommunicationPreferencesV2}}
          {{> organisms-communication-preferences-v2}}
        {{/with}}
      </div>
    </div>
    <!-- End: Communication pref Row V2 -->

    <!-- Start: Communication pref Row KR -->
    <div class="bg-white border border-gray-50 rounded-md flex mb-20 md:mb-30">
      <div class="w-full px-10 py-25 mb-20 md:mr-15 md:mb-30 md:p-40">
        <h2 class="text-gray-150 text-2xl-2 leading-base mb-20">Communication Preferences</h2>
        {{#with CommunicationPreferencesKr}}
          {{> organisms-communication-preferences-kr}}
        {{/with}}
      </div>
    </div>
    <!-- End: Communication pref Row -->

    <!-- Start: Cancel Row -->
    <div class="bg-white border border-gray-50 rounded-md flex to-md:flex-wrap mb-20 md:mb-30">
      <div class="w-full md:w-1_2 px-10 py-25 mb-20 md:mr-15 md:mb-30 md:p-40">
        <h2 class="text-gray-150 text-2xl-2 leading-base mb-20">Cancel My Preferred Member Benefits!</h2>
        <p class="text-gray-120 md:mb-30 {{#if IsCn}} text-sm {{/if}}">You can cancel your Preferred Member Benefits in 4 easy steps.</p>
        <a href="#" class="justify-center w-full text-center text-base text-green leading-base uppercase block bg-white border-green border-1 rounded w-full py-15 px-20" data-gtm-track='
                    {
                        "gtmId": "246",
                        "gtmText": "Learn More"
                    }'>
          Learn More</a>
      </div>
      <div class="w-full md:w-1_2 px-10 py-25 mb-20 md:ml-15 md:mb-30 md:p-40 to-md:hidden">
        <!-- This empty div is required for consistent spacing -->
      </div>
    </div>
    <!-- End: Cancel Row -->

    <!-- Start: Invoice Row only for CN -->
    {{#with Invoice}}
      <div class="bg-white border border-gray-50 rounded-md flex to-md:flex-wrap mb-20 md:w-1_2 md:mb-30">
        <div class="w-full px-10 py-25 mb-20 md:mr-15 md:mb-30 md:p-40">
          <h2 class="text-gray-150 text-2xl-2 leading-base mb-15 md:mb-20">{{ Title }}</h2>
          <p class="text-gray-120 mb-18 md:mb-30">{{ Subtitle }}</p>
          <h4 class="text-gray-120 font-semibold text-base leading-base mb-20 md:mt-2 md:mb-24">{{ InvoiceTitleLabel }}:{{ InvoiceTitle }}</h4>
          <a href="{{ EditButton.Url }}" class="justify-center text-center text-base text-green leading-base uppercase block bg-white border-green border-1 rounded w-full py-15 px-20 md:w-3_4 " data-gtm-track='
                    {
                        "gtmId": "246",
                        "gtmText": "Learn More"
                    }'>
            {{ EditButton.Text }}</a>
        </div>
      </div>
    {{/with}}
    <!-- End: Cancel Row only for CN-->

  </div>
</section>

{{> organisms-site-footer }}