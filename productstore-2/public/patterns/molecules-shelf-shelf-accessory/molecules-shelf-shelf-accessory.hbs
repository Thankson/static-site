<div class="m-shelfAccessory">
  <div class="m-shelfAccessory__details">
    <h3 class="m-shelfAccessory__heading">{{Title}}</h3>
    <p class="m-shelfAccessory__desc">{{Description}}</p>
  </div>
  <div class="m-shelfAccessory__fill">
    <img src="{{Image}}" alt="{{Title}}" class="m-shelfAccessory__img">
  </div>
  <div class="m-shelfAccessory__controls">
    <button type="button" class="m-shelfAccessory__btn" aria-label="{{Button.AriaLabel}}">
      <a-icon size="inherit">add</a-icon>
      <a-icon size="inherit">shopping_cart</a-icon>
    </button>
  </div>
</div>