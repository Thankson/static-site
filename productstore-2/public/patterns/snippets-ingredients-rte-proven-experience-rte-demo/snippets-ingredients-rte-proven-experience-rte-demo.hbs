<div class="m-rte">
  {{#with ProvenExperienceContent}}
    <div class="s-provenExperience">
      <div class="s-provenExperience__row">
        <p class="s-provenExperience__description">{{Description}}</p>
        <img src="{{Img.Src}}" alt="{{Img.Alt}}" class="s-provenExperience__img">
      </div>
      <ul class="s-provenExperience__list">
        {{#each List}}
          <li class="s-provenExperience__item">
            <span role="text" class="s-provenExperience__text">{{{Text}}}</span>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/with}}
</div>