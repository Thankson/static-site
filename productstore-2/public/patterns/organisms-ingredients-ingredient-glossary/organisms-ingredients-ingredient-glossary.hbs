<!-- Start: Glossary List Organism-->
<!-- End: Ingredient Glossary Organism-->
<article class="o-ingredGloss">
  <header class="o-ingredGloss__header">
    {{#each Legend}}
      <p class="o-ingredGloss__legend">
        <img src="{{Image.Src}}" alt="{{Image.Alt}}" class="o-ingredGloss__icon">
        {{Text}}
      </p>
    {{/each}}
  </header>

  <div class="o-ingredGloss__list">
    {{#each GlossaryItems}}
      <div class="o-ingredGloss__item">
        {{> molecules-ingredient-glossary}}
      </div>
    {{/each}}
  </div>
</article>
<!-- End: Ingredient Glossary Organism-->