{{#AccordionTwoCol}}
  <div class="o-accordion {{WrapperMods}}">
    {{#each Rows}}
      <h2 class="o-accordion__title {{Mods.Title}}">
        <button class="o-accordion__toggler {{Mods.Toggler}}" id="{{ToggleID}}" aria-controls="{{ContentID}}" aria-expanded="false">{{Title}} <span class="{{Mods.SecondTitle}}">{{{SecondTitle}}}</span> {{> atoms-arrow Size=../ArrowSize TailwindColor="gray-120" Direction="-down" OtherMods="mt-6 md:right-0"}}</button>
      </h2>

      <div class="o-accordion__content hidden {{Mods.Content}}" id="{{ContentID}}" aria-labelledby="{{ToggleID}}" aria-hidden="true" tabindex="-1" role="region">
        {{#if ContentDynamic}}
          {{#each ContentDynamic}}
            {{> (lookup . 'DynamicPartial')}}
          {{/each}}
        {{else}}
          {{{ContentStatic}}}
        {{/if}}
      </div>
    {{/each}}
  </div>
{{/AccordionTwoCol}}