<div class="m-rte">
  {{#with PhotoExamples}}
    <div class="s-photoExample max-w-contain w-full">
      <h2 class="border-b-4 border-green pb-5 text-2xl md:text-2xl-2">{{Heading}}</h2>
      <ul class="mt-20 md:flex md:items-start md:mt-30">
        {{#each Example}}
          <li class="flex flex-col justify-center list-none mb-20 md:mb-0 md:mr-30">
            <h4 class="font-medium text-xs uppercase md:text-sm">{{Title}}</h4>
            <img src="{{Img.Src}}" alt="{{Img.Alt}}" class="w-full md:w-auto">
            <div class="flex items-start mt-10 md:mt-20" style="max-width: 330px;">
              <img src="{{Icon}}" alt="{{IconAlt}}">
              <p class="leading-tight ml-15 pr-5 text-sm text-gray md:pr-0 md:text-base">{{Description}}</p>
            </div>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/with}}
</div>