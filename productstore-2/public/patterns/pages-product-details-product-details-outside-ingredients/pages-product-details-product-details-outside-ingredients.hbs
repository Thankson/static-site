{{! START: Site Header }}
{{> organisms-site-header}}
{{! START: Site Header }}

<main id="mainContent" role="main" class="relative">

  <div class="hidden mx-auto mb-10 max-w-contain md:px-20 mt-15 md:mb-40 md:block">
    {{#Breadcrumb}}
      {{> molecules-breadcrumb }}
    {{/Breadcrumb}}
  </div>

  <product-dynamic-section section-name="top">
    {{#BannerAd}}
      <div class="mb-40 w-full">
        {{> molecules-banner-ad}}
      </div>
    {{/BannerAd}}
  </product-dynamic-section>

  {{!-- Product Data --}}
  {{> organisms-product-details}}

  {{!-- JUMP LINKS --}}
  {{> molecules-jump-links}}

  {{#if PdpData.Data.UserFlags.IsAuthenticated}}
    {{!-- ABOUT THIS PRODUCT --}}
    <section id="section-pdp-about" class="w-full max-w-contain mx-auto">
      {{> SectionHeader SectionHeading="About" SrOnly=true}}

      <product-dynamic-section section-name="about">
        {{> atoms-cmn-demo-block }}
      </product-dynamic-section>
    </section>

    <hr class="border-b-10 block max-w-contain my-80 mx-auto" style="border-color:#eee" aria-hidden="true" v-pdp-ingredients>
  {{/if}}

  {{!-- INGREDIENTS - Testing ingredients OUTSIDE <section> --}}
  <div class="o-widthControl mx-auto w-full max-w-full to-md:px-10 md:max-w-contain md:py-40">
    <img src="https://cdnsc1.melaleuca.com/na/images/product-labels/139_enUs.gif" alt="139_enUs">
  </div>

  {{#if PdpData.Data.UserFlags.IsAuthenticated}}
    {{> hr}}

    {{!-- REVIEWS --}}
    <section id="section-pdp-reviews" class="w-full max-w-xl px-8 mx-auto lg:px-20">

      {{> SectionHeader SectionHeading="Reviews"}}

      <div class="o-reviewSection" id="reviews">
        <div id="pr-reviewdisplay">
        </div>
      </div>
    </section>

    {{> hr}}

    {{!-- RECOMMENDED CAROUSEL --}}
    <div class="o-widthControl mx-auto w-full md:max-w-contain">
      <section class="mt-40 pb-2">
        {{>organisms-product-carousel-vue-slots}}
      </section>
    </div>
  {{/if}}

  <script id="data-shelf-configurator-localization" type="application/json">
  {{toJson ShelfData}}
  </script>

  {{> atoms-main-spinner MainSpinner}}
</main>

{{! START: CTA Banner }}
{{> molecules-cta-banner}}
{{! END: CTA Banner }}

{{! START: Site Footer }}
{{> organisms-site-footer}}
{{! END: Site Footer }}


{{!-- Inline Partials to keep the file clean --}}
{{#*inline "hr"}}
  <hr class="border-b-10 block max-w-contain my-80 mx-auto" style="border-color:#eee" aria-hidden="true">
{{/inline}}

{{#*inline "SectionHeader"}}
  <header class="pb-40 {{#if SrOnly}}sr-only{{/if}}">
    <h2 class="text-3xl text-gray-150 uppercase font-bold leading-base">
      <span class="block">{{SectionHeading}}</span>
    </h2>
  </header>
{{/inline}}