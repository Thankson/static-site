{{#if Badge}}
  <a-badge aria-label="{{Badge.Data.AriaLabel}}" background-color="{{Badge.Data.BackgroundColor}}" badge-position="{{Badge.Data.BadgePosition}}" tailwind-classes="{{Badge.Data.TailwindClasses}}" text-color="{{Badge.Data.TextColor}}" title="{{Badge.Data.Title}}" is-grow-premium-popup="{{Badge.Data.IsGrowPremiumPopup}}">
{{/if}}
<a href="{{Url}}" class="m-searchResultItem">
  {{#if Image}}
    <img src="{{Image}}" alt="{{Alt}}" class="m-searchResultItem__img" />
  {{/if}}
  <div class="m-searchResultItem__content">
    <h3 class="m-searchResultItem__title">{{Title}}</h3>
    <p class="m-searchResultItem__description">{{Description}}</p>
  </div>
</a>
{{#if Badge}}
  </a-badge>
{{/if}}