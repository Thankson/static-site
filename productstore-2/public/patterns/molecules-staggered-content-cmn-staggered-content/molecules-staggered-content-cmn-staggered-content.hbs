{{#with StaggeredContent}}
  <article class="m-staggeredCo {{ImageAlignTopLeft}}" {{#if BgColor}} style="background-color: {{BgColor}};" {{/if}}>
    {{#with BgImage}}
      <div class="m-staggeredCo__backgrounds">
        <div class="m-staggeredCo__bg -desktop" style="background-image:{{Src.Desktop}}" aria-hidden="true"></div>
        <div class="m-staggeredCo__bg -mobile" style="background-image:{{Src.Mobile}}" aria-hidden="true"></div>
      </div>
    {{/with}}
    <div class="m-staggeredCo__contain {{WidthContain}}">
      {{#if Header}}
        <header class="m-staggeredCo__header">
          <!-- Start: RTE Content -->
          {{{Header}}}
          <!-- End: RTE Content -->
        </header>
      {{/if}}
      <ul class="m-staggeredCo__list">
        {{#each Row}}
          <li class="m-staggeredCo__row {{RowBottomPadding}}">
            <div class="m-staggeredCo__col -image">
              <img class="m-staggeredCo__image" src="{{Image}}">
            </div>
            <div class="m-staggeredCo__col">
              <div class="m-staggeredCo__description">
                {{{Description}}}
              </div>
            </div>
          </li>
        {{/each}}
      </ul>
    </div>
  </article>
{{/with}}