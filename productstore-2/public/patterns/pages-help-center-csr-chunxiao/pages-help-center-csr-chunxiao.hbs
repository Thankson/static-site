{{> organisms-site-header}}
<div class="bg-gray-25">

  <div class="mb-10 pt-15 {{#if IsCn}}hidden md:block{{/if}}">
    {{#Breadcrumb}}
      {{> molecules-breadcrumb }}
    {{/Breadcrumb}}
  </div>
  {{!-- Banner --}}

  <section class="md:py-40">
    <div class="w-full max-w-contain mx-auto mb-40 md:mb-50 md:px-0">
      {{#if PageImage}}
        <!-- Start: Image Content -->
        <div class="m-contentBlock__media">
          {{> atoms-cmn-generic-img}}
        </div>
        <!-- End: Image Content -->
      {{/if}}
      <h1 class="w-full mx-auto px-10 text-left text-3xl font-medium tracking-tight text-gray-150 max-w-contain font-global-sans my-20 md:my-30 md:px-0 md:text-4xl">
        {{PageTitle}}
      </h1>
      <div class="m-rte w-full px-10 max-w-contain mx-auto md:px-0" role="text">
        {{{TextRTE}}}
      </div>
    </div>

    <div class="w-full md:mb-50 mx-auto max-w-contain">
      {{> organisms-csr-chunxiao-section}}
    </div>

    <div class="w-full md:mb-100">
      <h2 class="w-full mx-auto text-left text-3xl font-medium tracking-tight text-gray-150 max-w-contain font-global-sans mb-20 px-10 md:px-0 md:mb-30 md:text-4xl">
        {{Title}}
      </h2>
      {{> molecules-content-quotation-block}}
    </div>

    <div class="w-full md:mb-100">
      {{#AboutContent}}
        <h2 class="w-full mx-auto text-left text-3xl font-medium tracking-tight text-gray-150 max-w-contain font-global-sans my-20 px-10 md:px-0 md:my-30 md:text-4xl">
          {{Title}}
        </h2>
        <div class="m-rte w-full max-w-contain mx-auto" role="text">
          {{{TextRTE}}}
        </div>
      {{/AboutContent}}
    </div>
  </section>
</div>
{{> organisms-site-footer}}