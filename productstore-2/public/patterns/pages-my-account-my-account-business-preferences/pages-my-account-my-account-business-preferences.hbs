{{> organisms-site-header }}
<script id="data-shelf-configurator-localization" type="application/json">
{{toJson Localization }}
</script>
<section class="pt-10 pb-1 md:pt-75 md:pb-15 bg-gray-25">
  <div class="mx-auto max-w-contain">
    {{#if CreditCardBanner }}
      <m-credit-card-ads :is-modal="false" background-color="#e69c4d4d"></m-credit-card-ads>
    {{/if}}

    <h1 class="w-full text-2xl font-bold tracking-tight text-gray-150 font-global-sans md:text-3xl md:mb-18 to-md:px-10 u-printHidden">{{PageTitle}}</h1>

    <div class="u-printHidden">
      {{> molecules-tabs-links}}
    </div>

    {{#if Page.IsOverview}}
      {{> organisms-account-overview}}
    {{/if}}

    {{#if Page.IsOrderHistory}}
      {{#with OrderHistory}}

        {{> organisms-past-orders-section}}
      {{/with}}
    {{/if}}

    {{#if Page.IsPaymentAddress}}
      {{#with PaymentAddressInfo}}
        {{> organisms-payment-address-section}}
        {{> organisms-shipping-address-section}}
      {{/with}}
      {{> organisms-business-commission-section}}
    {{/if}}

    {{#if Page.IsShoppingLists}}
      {{#if Page.IsShoppingListsManage}}
        {{> organisms-shopping-lists-manage}}
      {{else}}
        {{> organisms-shopping-lists-section}}
      {{/if}}
    {{/if}}

    {{#if Page.IsBusinessPreferences}}
      {{> organisms-business-preferences}}
      {{> organisms-personal-link}}
      {{> organisms-document-upload}}
    {{/if}}
  </div>
</section>

{{> organisms-site-footer }}