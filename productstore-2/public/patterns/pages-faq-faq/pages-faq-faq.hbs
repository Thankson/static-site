{{> organisms-site-header}}
<div class="bg-gray-25">
  <nav class="top-0 py-0 my-0 bg-white md:hidden">
    {{#MobileAccordionNav}}
      {{> organisms-cmn-accordion}}
    {{/MobileAccordionNav}}
  </nav>

  <div class="mb-10 pt-15 {{#if IsCn}}hidden md:block{{/if}}">
    {{#Breadcrumb}}
      {{> molecules-breadcrumb }}
    {{/Breadcrumb}}
  </div>

  <section class=" md:py-40">
    <h1 class="w-full mx-auto text-2xl font-medium tracking-tight text-gray-150 max-w-contain font-global-sans mb-18 md:text-3xl to-md:px-10 to-md:pt-20">{{PageTitle}}</h1>

    <div class="w-full px-10 pt-10 pb-36 mx-auto mt-10 mb-0 bg-white border max-w-contain border-gray-50 text-gray-150 md:mb-40 md:px-40 md:rounded">
      <h2 class="text-3xl font-light leading-tight mb-18 md:mb-50 md:text-5xl to-md:hidden">{{PageSubtitle}}</h2>

      <div class="md:flex md:justify-between">
        {{#PageBody}}
          <div class="mb-30 {{#if IsCn}}mb-10{{/if}} md:mb-6">
            {{> molecules-sidenav}}
          </div>

          <div class="md:w-2_3 md:px-40 xl:px-60">
            {{#HelpContent}}
              <h4 class="w-full pb-10 mx-auto text-2xl border-b border-gray-50 text-gray-150 font-medium max-w-contain font-global-sans {{#unless IsCn}}md:text-3xl{{else}}md:text-2xl{{/unless}} to-md:px-0">{{ContentTitle}}</h4>
              {{> organisms-cmn-accordion}}
            {{/HelpContent}}
          </div>
        {{/PageBody}}
      </div>
    </div>
  </section>
  {{> molecules-cta-banner}}
</div>
{{> organisms-site-footer}}