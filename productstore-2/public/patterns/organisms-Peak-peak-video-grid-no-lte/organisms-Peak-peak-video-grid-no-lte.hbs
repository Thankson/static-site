{{#with VideoGrid}}
  <article class="peak-videoGrid">
    <div class="peak-videoGrid__wrapper -top">
      <div class="peak-videoGrid__media">
        <o-vid-curate-ctrl script-id="peakGridVidData-001"></o-vid-curate-ctrl>
        <script type="application/json" id="peakGridVidData-001">
        {{toJson VideoData1.Localization}}
        </script>
      </div>
    </div>
    <div class="peak-videoGrid__wrapper -text">
      {{!-- Start RTE --}}
      <h2 class="leading-base font-light pb-12" style="font-size: 42px; color:#F25AB0">The <span class="uppercase font-medium">Science</span> behind living life at your peak</h2>
      {{!-- End RTE --}}
      <div>
        <p class="peak-videoGrid__text">At Melaleuca we don’t just rely on theoretical data or lab experiments. We
          put the Peak Performance Pack to the ultimate test—on real people under real-life conditions. We then
          measured the impact the Peak Performance Pack had on those individuals.
          <br>
          <br>
          At Melaleuca we don’t just rely on theoretical data or lab experiments. We put the Peak Performance Pack
          to the ultimate test—on real people under real-life conditions. We then measured the impact the Peak
          Performance Pack had on those individuals.
        </p>
      </div>
      <a href="" class="peak-videoGrid__link">Learn More <span class="peak-videoGrid__arrow" aria-hidden="true"></span></a>
    </div>
    <div class="peak-videoGrid__wrapper -bottom">
      <div class="peak-videoGrid__col">
        <o-vid-curate-ctrl script-id="peakGridVidData-002"></o-vid-curate-ctrl>
        <script type="application/json" id="peakGridVidData-002">
        {{toJson VideoData2.Localization}}
        </script>
      </div>
      <div class="peak-videoGrid__col">
        <o-vid-curate-ctrl script-id="peakGridVidData-003"></o-vid-curate-ctrl>
        <script type="application/json" id="peakGridVidData-003">
        {{toJson VideoData3.Localization}}
        </script>
      </div>
    </div>
  </article>
{{/with}}