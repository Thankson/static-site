<modal :visible="true" {{#if PreventClose}}:prevent-close="true" {{/if}}>
  {{#if ModalHeading}}
    <template v-slot:heading>
      {{ModalHeading}}
    </template>
  {{/if}}

  {{#if ModalBody}}
    <template v-slot:body>
      {{ModalBody}}
    </template>
  {{/if}}

  {{#if ModalFooter}}
    <template v-slot:footer>
      <button v-modal-hide type="button" class="a-button -medium" {{{AriaProps}}} {{#with Gtm}} {{> gtmTrack}} {{/with}}>
        {{ModalFooter.ButtonLabel}}
      </button>
    </template>
  {{/if}}
</modal>

{{#*inline "gtmTrack"}}
  v-on:click="gtmTrackAction({ id:'{{Id}}'{{#if Text}}, text:'{{Text}}'{{/if}} }, $event)"
{{/inline}}