<div class="m-directorCard">
  <img class="m-directorCard__image" src="{{ Image.Src }}" alt="{{ Image.Alt }}" />
  <div class="m-directorCard__info">
    <p class="m-directorCard__name">
      {{Name}}
    </p>
    <p class="m-directorCard__yearEnrolled">{{#if EnrolledText}}{{EnrolledText}}{{/if}} {{FormattedEnrolledDate}}</p>
  </div>
</div>