<a-shelf-toggle class="
      {{#if UseDefaultButtonClass}}
        a-button
      {{else}}
         {{PopupNotificationsClassSet}}
      {{/if}}">
  {{#if UseDefaultButtonClass}}
    {{ButtonLabel}}
  {{else}}
    <img src="{{Image.Picture}}" alt="{{Image.Alt}}">
  {{/if}}

  {{#if CloseSrLabel}}
    <template v-slot:close-sr-label>
      {{CloseSrLabel}}
    </template>
  {{/if}}

  {{#if Heading}}
    <template v-slot:heading>
      {{Heading}}
    </template>
  {{/if}}

  {{#if Content}}
    <template v-slot:content>
      {{{Content}}}
    </template>
  {{/if}}
</a-shelf-toggle>