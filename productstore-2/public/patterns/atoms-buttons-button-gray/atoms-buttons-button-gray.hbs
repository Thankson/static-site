{{#if Attr.IsButton}}
  <button class="a-button {{Mods}}" type="{{Attr.Type}}" {{{AriaProps}}} style="{{Styles}}" {{#each Attr.DataAttr}} {{#if DataAttrKey}}data-{{DataAttrKey}}="{{DataAttrValue}}" {{/if}} {{/each}} {{#if Gtm}} data-gtm-track='
            {
                "gtmId": {{Gtm.Id}},
                "gtmText": "{{Gtm.Text}}"
            }
        ' {{/if}}>
    {{CTA}}
  </button>
{{else}}
  <a class="a-button {{Mods}}" href="{{{Attr.Href}}}" target="{{Target}}" {{{AriaProps}}} style="{{Styles}}" {{#each Attr.DataAttr}} {{#if DataAttrKey}}data-{{DataAttrKey}}="{{DataAttrValue}}" {{/if}} {{/each}} {{#if Gtm}} data-gtm-track='
            {
                "gtmId": {{Gtm.Id}},
                "gtmText": "{{Gtm.Text}}"
            }
        ' {{/if}} {{Directive}}>
    {{CTA}}
  </a>
{{/if}}