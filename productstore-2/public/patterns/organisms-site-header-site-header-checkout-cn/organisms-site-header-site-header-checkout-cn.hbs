{{#SiteHeaderCheckout}}
  <header class="o-siteHeader -checkout">
    <div class="o-siteHeader__row -main">
      <div class="o-siteHeader__col -nav">
        {{> molecules-nav-menu}}
      </div>

      <div class="o-siteHeader__col -logo" data-testid="container-logoWrapper">
        {{#Logo}}
          <a href="{{Link}}" class="block">
            <img class="o-siteHeader__image" src="{{Img}}" alt="{{Alt}}">
          </a>
        {{/Logo}}
      </div>

      <div class="o-siteHeader__col -title">
        <h1 class="font-bold text-center text-white text-2xl uppercase {{#if IsCn}}mr-40{{/if}}">{{Title}}</h1>
      </div>

      <div class="o-siteHeader__col -actions" data-myaccount-icon="https://cdnsc1.melaleuca.com/na/images/header/icon-account-2.png" data-notification-icon="https://cdnsc1.melaleuca.com/na/images/header/icon-notifications2x.png" data-testid="container-siteHeaderActions">
        {{#Cart}}
          {{> organisms-cart-icon}}
        {{/Cart}}
      </div>
    </div>
  </header>
{{/SiteHeaderCheckout}}