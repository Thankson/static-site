<div class="a-playPause" data-js="playPauseBlock">
  <button type="button" class="a-playPause__action {{ClassMod}}" aria-pressed="false" aria-label="{{AriaLabel}}" data-js="playPause" data-descr-pause="{{PauseDescription}}" data-descr-play="{{PlayDescription}}" data-label-pause="{{PauseAriaLabel}}" data-label-play="{{PlayAriaLabel}}">
    <span class="a-playPause__icon font-material" data-js="playPauseIcon">pause_circle_filled</span>
    <span class="a-playPause__description" data-js="playPauseDescr">{{PauseDescription}}</span>
  </button>
</div>