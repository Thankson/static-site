<div class="flex flex-wrap w-full mx-auto max-w-contain pb-30 sm:pb-40">
  <div class="flex flex-col items-center justify-start w-full sm:pl-60 sm:w-1_2 sm:pr-85 {{#with LargeCard}} {{ModsPosition}} {{/with}}">
    {{! Replace LargeCard data with LIA Card data}}
    {{#LargeCard}}
      {{> molecules-cmn-resources-card}}
    {{/LargeCard}}
  </div>
  <div class="flex flex-wrap justify-between to-sm:mt-36 w-full sm:w-1_2 {{ModsPosition}}">
    {{#each Cards}}
      {{! Replace demoBlock with LIA Card data}}
      <div class="w-1_2 sm:w-1_4 sm:flex-grow to-sm:odd:pr-5 to-sm:even:pl-5 sm:mx-15 third-child-mr-0">
        {{> molecules-cmn-resources-card}}
      </div>
    {{/each}}
    <div class="w-full text-center md:px-100">
      {{> atoms-button Mods="-full -outline -bg-white -tall md:text-base" CTA="View More"}}
    </div>
    </>
  </div>