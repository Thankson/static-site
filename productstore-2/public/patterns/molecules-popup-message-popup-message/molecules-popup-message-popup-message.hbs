<!-- START 29142 - Success Message -->
{{#PopUpMessage}}
  <popup-message :is-visible="{{IsVisible}}" id="{{Id}}" size="{{PopUpSize}}" mods="{{PopUpMods}}" :header-visible="{{Show.Header}}" header-title="{{Header}}" email="{{Email}}" :footer-visible="{{Show.Footer}}" footer-title="{{CTA.Text}}" footer-link="{{CTA.Link}}" footer-target-window="{{CTA.TargetWindow}}" footer-c-t-a-mods="{{CTA.FooterCTAMods}}" close-icon="{{ClosePopup.Icon}}" close-alt="{{ClosePopup.Alt}}" close-aria-label="{{ClosePopup.AriaLabel}}" is-cn="{{IsCn}}">

    <template>
      {{#if BodyDynamic}}
        {{> (lookup . 'BodyDynamic')}}
      {{else}}
        {{{Body}}}
      {{/if}}
    </template>

  </popup-message>
{{/PopUpMessage}}
<!-- END 29142 - Success Message -->