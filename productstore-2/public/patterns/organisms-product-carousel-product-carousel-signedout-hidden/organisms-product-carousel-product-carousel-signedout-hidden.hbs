<div>
  <div class="o-productCarousel {{Mod.ProdCarousel}}">
    <div class="o-productCarousel__header">
      <h3 class="o-productCarousel__title">{{Title}}</h3>
      <p class="o-productCarousel__CTA">
        <a href="{{CTA.Link}}">{{CTA.Label}}</a>
        {{> atoms-arrow TailwindColor="green-100" Direction="-right" Size="-sm" OtherMods="-filled  ml-3" }}
      </p>
    </div>
    <div role="region" class="o-productCarousel__wrapper" aria-roledescription="carousel" aria-label="{{CarouselDescription}}">
      <nav class="o-productCarousel__actions">
        <div class="o-productCarousel__dots"></div>
        <div class="o-productCarousel__arrows"></div>
      </nav>
      <p class="o-productCarousel__count" id="carousel-count-{{UniqueID}}" aria-live="polite">Showing <span class="slick-ada-from"></span> to <span class="slick-ada-to"></span> out of <span class="slick-ada-length"></span>.</p>
      <div class="o-productCarousel__slider" id="carousel-{{UniqueID}}">
        {{#each Products}}
          {{> molecules-product-card-vue}}
        {{/each}}
      </div>
    </div>
  </div>
</div>