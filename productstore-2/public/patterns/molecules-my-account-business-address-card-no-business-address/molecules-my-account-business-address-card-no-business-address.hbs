<div>
  {{#if BusinessAddress}}
    <div class="m-acctCard {{#if IsCn}}-isCn -isCommission{{/if}}">
      <div class="m-acctCard__card">
        <ul class="m-acctCard__list">
          <li class="m-acctCard__item font-bold">{{BusinessAddress.Name}}</li>
          <li class="m-acctCard__item">{{BusinessAddress.Address}}</li>
          <li class="m-acctCard__item">{{BusinessAddress.CityStatZip}}</li>
        </ul>
        <div class="m-acctCard__nav">
          <a aria-label="{{BusinessAddress.ButtonAria}}" class="m-acctCard__link" data-gtm-track='
                    {
                        "gtmId": "204",
                        "gtmText": "Edit"
                    }
                ' href="{{BusinessAddress.Link}}">
            {{BusinessAddress.ButtonLabel}}
          </a>
        </div>
      </div>
    </div>
    {{ else}}
    <div class="pb-30">
      <a aria-label="{{AddNewBusinessAddress}}" class="m-acctCard__addBusAddButton" data-gtm-track='
                {
                    "gtmId": "204",
                    "gtmText": "Add"
                }
            ' href="{{link.organisms-address-form-business}}">
        {{AddNewBusinessAddress}}
      </a>
    </div>
  {{/if}}
</div>