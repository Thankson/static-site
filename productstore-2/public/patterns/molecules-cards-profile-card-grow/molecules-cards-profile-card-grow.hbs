<a-badge aria-label="{{Badge.Data.AriaLabel}}" background-color="{{Badge.Data.BackgroundColor}}" badge-position="{{Badge.Data.BadgePosition}}" tailwind-classes="{{Badge.Data.TailwindClasses}}" text-color="{{Badge.Data.TextColor}}" title="{{Badge.Data.Title}}" is-grow-premium-popup="{{#if Badge.Data.IsGrowPremiumPopup}}{{Badge.Data.IsGrowPremiumPopup}}{{else}}false{{/if}}">
  <div class="m-profileCardGrow">
    <object data="{{Image.Url}}" type="image/jpg" class="m-profileCardGrow__image">
      <img src="{{FallbackImageUrl}}" alt="{{Image.Alt}}" />
    </object>

    <h3 class="m-profileCardGrow__title">
      {{Title}}
    </h3>

    <p class="m-profileCardGrow__status">
      {{Status}}
    </p>

    {{#if Enrolled}}
      <p class="m-profileCardGrow__enrolled">
        {{Enrolled}}
      </p>
    {{/if}}

    {{#if From}}
      <p class="m-profileCardGrow__from">
        {{From}}
      </p>
    {{/if}}
  </div>
</a-badge>

<script type="application/json" id="{{Badge.UniqueScriptID}}">
{{toJson Badge.Localization}}
</script>