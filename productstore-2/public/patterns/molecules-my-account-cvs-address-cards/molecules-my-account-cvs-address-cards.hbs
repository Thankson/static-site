<div class="m-acctCard">
  <div class="m-acctCard__card -cvs">
    <div class="pb-25">
      <p class="font-medium">{{NameOnAddress}} {{PhoneNumber}}</p>
      <p>{{ChannelDisplayName}} {{StoreName}}</p>
      <p>{{CvsAddress.City}} {{CvsAddress.Suburb}}</p>
      <p>{{CvsAddress.AddressLine1}}</p>
      <p>{{CvsAddress.Country}}</p>
    </div>
    <ul class="m-acctCard__actions">
      <li><button class="m-acctCard__button">{{Labels.Delete}}</button></li>
    </ul>
  </div>
</div>