<div class="o-couponHeader">
  <div class="o-couponHeader__col -hero">
    {{#with CouponHero}}
      {{>molecules-coupon-page-hero}}
    {{/with}}
  </div>
  <div class="o-couponHeader__col -savings">
    <div class="o-couponHeader__date">
      {{#with CouponReminder}}
        {{>molecules-coupon-reminder}}
      {{/with}}
    </div>
    <div class="o-couponHeader__save">
      {{#with CouponSavings}}
        {{>molecules-coupon-page-savings}}
      {{/with}}
    </div>
  </div>
</div>