<div class="m-addOnPacks">
  <div class="m-addOnPacks__media {{#if IsEnhancement}}-mod{{/if}}">
    <img class="m-addOnPacks__img" src="{{ImgSrc}}" alt="{{AltImg}}">
    {{#if ShowPill}}
      <p class="m-addOnPacks__pill {{#if IsEnhancement}}-mod{{/if}}" style="background-color:{{PillBGColor}}; color:{{PillColor}}; border:{{PillBorder}}">{{PillText}}</p>
    {{/if}}
  </div>
  <div class="m-addOnPacks__content {{#if IsEnhancement}}-mod{{/if}}">
    <div class="m-addOnPacks__product">
      <p class="m-addOnPacks__name" style="color:{{SkuNameColor}}">{{{SkuName}}}</p>
      <div class="m-addOnPacks__description {{#if IsRTE}} -rte m-rte {{/if}}" style="color:{{PackDescriptionColor}}">
        {{!-- Start RTE if it is an RTE --}}
        {{{SkuDescription}}}
        {{!-- End RTE --}}
      </div>
    </div>
    <div class="m-addOnPacks__container">
      <div class="m-addOnPacks__info" style="color:{{PackInfoColor}}">
        {{#if ViewPoints}}
          <p class="m-addOnPacks__points">
            <strong class="m-addOnPacks__text -points">{{Points}}</strong> points
          </p>
        {{/if}}
        {{#if ShowPrices}}
          <p class="m-addOnPacks__price">
            <strong class="m-addOnPacks__text -price">{{Price}}</strong>
            {{#if IsRestrictedPack}}
              <span>{{MemberOnlyOffer}}</span>
            {{else}}
              preferred
            {{/if}}
          </p>
        {{/if}}
        {{#if ShowPreferredSavings}}
          <p class="m-addOnPacks__saving {{PackInfoMods}}">
            <strong class="m-addOnPacks__text">{{PreferredSavings}}</strong>
          </p>
        {{/if}}
      </div>
      {{#unless IsRestrictedPack}}
        <div class="m-addOnPacks__action">
          {{!-- This button will eventually become a vue component --}}
          <o-shelf-configurator class="{{Mods}} a-button {{#if isRounded}}rounded-full{{/if}}" aria-label="{{AriaProps}}" sku="{{Sku}}" family-id="{{FamilyId}}" :gtm-id="415" product-name="{{SkuName}}" script-id="data-shelf-configurator-localization" configurator="1">

            {{ CTA }}
          </o-shelf-configurator>
        </div>
      {{/unless}}
    </div>
  </div>
</div>

<script id="data-shelf-configurator-localization" type="application/json">
{{toJson Localization}}
</script>