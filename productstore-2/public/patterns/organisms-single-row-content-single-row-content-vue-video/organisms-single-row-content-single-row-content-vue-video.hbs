<div class="o-singleRowContent" {{#if BgColor}}style="background-color: {{ BgColor }};" {{/if}}>
  <ul class="o-singleRowContent__list">
    {{#if OneItem}} {{> One}} {{/if}}
    {{#if TwoItem}} {{> Two}} {{/if}}
    {{#if ThreeItem}} {{> Three}} {{/if}}
    {{#if FourItem}} {{> Four}} {{/if}}
  </ul>
</div>

{{#*inline "One"}}
  <li class="o-singleRowContent__item">
    {{#if IsVideo}}
      {{> molecules-content-card-video-vue-video }}
    {{else}}
      {{> molecules-cmn-content-card }}
    {{/if}}
  </li>
{{/inline}}

