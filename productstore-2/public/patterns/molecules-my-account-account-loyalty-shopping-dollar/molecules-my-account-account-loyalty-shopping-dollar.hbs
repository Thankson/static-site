<div class="relative">
  <h3 class="text-md md:text-lg  font-semibold uppercase mr-3 mb-10 mr-15 inline-block">{{Title}}<span class="to-md:hidden">:</span></h3>
  {{ Balance  }}
  <div class="pb-20 text-gray">
    {{#if lsdExpiringInCurrentMonthValue}}
      <p>
        {{ lsdExpiringInCurrentMonth }}
        <span class="font-medium">{{ lsdExpiringInCurrentMonthValue }}</span>
      </p>
    {{/if}}
    <p>
      {{ LifeTimeEarned }}
      <span class="font-medium">{{ LifeTimeEarnedValue }}</span>
    </p>
  </div>
</div>