<div class="m-rte">
  {{#with SafeContent}}
    <div class="s-safeIngredients">
      <h3 class="s-safeIngredients__heading">{{{Heading}}}</h3>
      <ul class="s-safeIngredients__list">
        {{#each List}}
          <li class="s-safeIngredients__item">
            <span role="text" class="s-safeIngredients__text">{{{Text}}}</span>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/with}}
</div>