{{#with NfactsHeader}}
  <header class="m-nutriFacts__header">
    <h1 class="m-nutriFacts__heading">{{{Heading}}}</h1>
    {{#each Items}}
      <p class="m-nutriFacts__heading -serving">
        {{#if @first}}
          <span class="m-nutriFacts__label -header font-bold pb-0">{{Item.Label}}</span> {{Item.Text}}
        {{else}}
          <span class="m-nutriFacts__label -header font-bold">{{Item.Label}}</span> {{Item.Text}}
        {{/if}}
      </p>
    {{/each}}
  </header>
{{/with}}