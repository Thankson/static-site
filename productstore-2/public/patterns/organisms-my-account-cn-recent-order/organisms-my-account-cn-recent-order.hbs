{{#RecentOrders}}
  <div class="o-recentOrders">
    <h2 class="o-recentOrders__title -mobile">{{Label}}</h2>
    <nav class="o-recentOrders__container">
      <h2 class="o-recentOrders__title -pc">{{Label}}</h2>
      <ul>
        {{#each Recent}}
          <li class="o-recentOrders__item">
            <div class="o-recentOrders__content -above">
              {{#with Date}}
                <p class="o-recentOrders__date">
                  {{Label}}: <span class="text-green-100">{{Date}}</span>
                </p>
              {{/with}}
              {{#if Status}}
                <p class="o-recentOrders__status">
                  {{Status}}
                </p>
              {{/if}}
            </div>
            <div class="o-recentOrders__content -below">
              <ul class="o-recentOrders__images">
                {{#each Images}}
                  <li class="o-recentOrders__imageItem">
                    <img class="o-recentOrders__image" src="{{Src}}" alt="{{Alt}}">
                  </li>
                {{/each}}
                <li class="o-recentOrders__imageItem -more">
                  <p>···</p>
                </li>
              </ul>
              <p>
                {{#each Details}}
                  {{#if Label}} {{Label}}:{{/if}} <span aria-label="{{AriaText}}">{{Text}}</span>
                  {{#unless @last}}<span class="text-sm mx-4" aria-hidden="true">|</span>{{/unless}}
                {{/each}}
              </p>
              <div class="o-recentOrders__action">
                {{#with Actions}}
                  {{#with Pay}}
                    <a class="o-recentOrders__link a-authorBtn text-center {{BgColor}} {{CornerType}} {{Size}} {{XPadding}}" href="{{Url}}">{{Text}}</a>
                  {{/with}}
                  {{#with Track}}
                    <a class="o-recentOrders__link a-authorBtn text-center {{BgColor}} {{CornerType}} {{Size}} {{XPadding}}" href="{{Url}}">{{Text}}</a>
                  {{/with}}
                  <a href="{{Detail.Url}}" class="o-recentOrders__link {{#if Pay }}-centerAlign{{/if}} {{#if Track}}-centerAlign{{/if}}">{{ Detail.Text }}</a>
                {{/with}}
              </div>
            </div>
          </li>
        {{else}}{{!-if empty --}}
          <p class="o-recentOrders__empty">{{EmptyText}}</p>
        {{/each}}
      </ul>
    </nav>
  </div>
{{/RecentOrders}}