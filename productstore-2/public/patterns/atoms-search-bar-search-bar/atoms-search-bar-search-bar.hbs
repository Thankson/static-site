{{#with SearchBar}}
  <form action="{{Action}}" method="POST" class="a-searchBar" role="search">
    <input class="a-searchBar__input" type="search" name="Search Input" placeholder="{{Placeholder}}" aria-placeholder="{{AriaPlaceholder}}">
    <button class="a-searchBar__btn" aria-label="{{BtnAria}}"><img class="a-searchBar__icon" src="{{SearchIcon}}" alt="{{AltSearchIcon}}" aria-hidden="true"></button>
  </form>
{{/with}}