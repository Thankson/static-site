{{> organisms-site-header }}
<div class="bg-gray-25">
  <nav class="top-0 py-0 my-0 bg-white md:hidden">
    {{#MobileAccordionNav}}
      {{> organisms-cmn-accordion}}
    {{/MobileAccordionNav}}
  </nav>
  {{#with OnlineEnrollmentVideo}}
    <section class="max-w-contain mx-auto py-10 w-full lg:pb-80 lg:pt-50">
      <div class="bg-white border px-8 py-20 border-gray-50 w-full lg:p-40 lg:pb-20 lg:rounded">
        {{!-- Title --}}
        <div class="m-rte" role="text">
          {{{TextRTE}}}
        </div>

        {{!-- Video --}}
        <div class="mt-30">
          {{> organisms-online-enrollment-welcome-video }}
        </div>

        {{!-- Benefits --}}
        {{#with Benefits}}
          <div class="mt-30">
            <div class="m-rte mb-30" role="text">{{{Title}}}</div>
            {{> organisms-cmn-category-section}}
          </div>
        {{/with}}
      </div>
    </section>
  {{/with}}
</div>