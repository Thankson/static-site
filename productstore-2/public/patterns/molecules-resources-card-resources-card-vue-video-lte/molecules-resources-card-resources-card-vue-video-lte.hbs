{{#Card}}
  <div class="m-resourcesCard {{Modifier}}">
    {{#if Link}}<a class="m-resourcesCard__link" href="{{Link}}">{{/if}}
    <div class="m-resourcesCard__mediaWrapper {{MobileThumbnailAlignment}}">
      <div class="m-resourcesCard__media {{TextAlignment}}">
        {{#if Video}}
          <o-vid-curate-ctrl script-id="{{UniqueScriptId}}"></o-vid-curate-ctrl>
        {{/if}}
        {{#if Image}}
          <img class="m-resourcesCard__img" src="{{Image}}" alt="{{ImageAltText}}">
        {{/if}}
      </div>
    </div>
    <p class="m-resourcesCard__content {{TextAlignment}} -content -small">
      <em class="m-resourcesCard__title -content -small">{{Heading}} </em>
      {{#if Subtitle}}<span class="m-resourcesCard__subtitle -content -small">{{Subtitle}}</span>{{/if}}
    </p>
    {{#if Link}}</a>{{/if}}
  </div>
  <script type="application/json" id="{{UniqueScriptId}}">
  {{toJson Localization}}
  </script>
{{/Card}}