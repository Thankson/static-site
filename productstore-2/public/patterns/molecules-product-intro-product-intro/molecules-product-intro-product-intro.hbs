<article class="m-productIntro">
  <div class="m-productIntro__col -logos">
    <picture class="m-productIntro__backgrounds">
      <source srcset="//cdnsc1.melaleuca.com/na/images/product-detail-pages/sun-valley/wave-mobile.png" media="(max-width: 575px">
      <source srcset="//cdnsc1.melaleuca.com/na/images/product-detail-pages/sun-valley/wave.png" media="(min-width: 576px">
      <img class="m-productIntro__img -background" src="//cdnsc1.melaleuca.com/na/images/product-detail-pages/sun-valley/wave.png" alt="" />
    </picture>
    <div class="m-productIntro__logos">
      <img class="m-productIntro__img -brand" src="{{Brand.Src}}" alt="{{Brand.Alt}}">
      <img class="m-productIntro__img -category" src="{{Category.Src}}" alt="{{Category.Alt}}">
    </div>
    <div class="m-productIntro__desc m-rte">
      {{!-- Start: RTE Content --}}
      {{{Desc}}}
      {{!-- End: RTE Content --}}
    </div>
  </div>
  <div class="m-productIntro__col -product">
    <img class="m-productIntro__img -product" src="{{Product.Src}}" alt="{{Product.Alt}}">
  </div>
</article>