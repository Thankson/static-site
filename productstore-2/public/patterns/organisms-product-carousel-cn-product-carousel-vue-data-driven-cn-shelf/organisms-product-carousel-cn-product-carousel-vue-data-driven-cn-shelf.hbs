<o-product-carousel-cn script-id="dataTopProductsCarousel" :settings='{{toJson Settings}}' :is-shelf="{{#if Localization.Labels.ProductCarousel.IsShelf}}true{{else}}false{{/if}}">
  <!-- The title can be passed by slot. If the slot is empty will display the default markup that is inside the component -->
  <template v-slot:title>
    <h3 class="text-xl text-gray-150 font-bold uppercase px-0 md:text-2xl">
      {{Localization.Labels.ProductCarousel.FallbackTitle}}
    </h3>
  </template>

  <!-- Optional link -->
  {{#if Localization.Labels.ProductCarousel.SeeAllLink}}
    <template v-slot:link>
      <p class="flex items-center tracking-wider text-green-100 text-md uppercase px-5 md:px-0">
        <a href="{{Localization.Labels.ProductCarousel.SeeAllLink}}" title="{{Localization.Labels.ProductCarousel.SeeAllText}}">
          {{Localization.Labels.ProductCarousel.SeeAllText}}
          <span aria-hidden="true" class="a-arrow -sm -right -filled  ml-3">
            <span class="a-arrow__icon border-green-100"></span>
          </span>
        </a>
      </p>
    </template>
  {{/if}}
</o-product-carousel-cn>

<script type="application/json" id="dataTopProductsCarousel">
{{toJson Localization}}
</script>

<script id="data-shelf-configurator-localization" type="application/json">
{{toJson Localization}}
</script>