{{#ContentBlock}}
  <article class="m-contentBlock {{MobileSwap}} {{WidthControl}} {{MobileContain}}">
    <div class="m-contentBlock__backgrounds" style="background-color: {{Background.Color}}">
      {{#if Background.Desktop}}
        <div class="m-contentBlock__bg -desktop" style="background-image: url({{Background.Desktop}});"></div>
      {{/if}}

      {{#if Background.Mobile}}
        <div class="m-contentBlock__bg -mobile" style="background-image: url({{Background.Mobile}});"></div>
      {{/if}}
    </div>

    {{#unless ../IsCn}}
      <div class="m-contentBlock__col block md:hidden">
        {{#with ContentRight}}
          {{> RTEorImg}}
        {{/with}}

        {{#if ContentRight.HasVideo}}
          <!-- Start: Right Video Content -->
          <div class="m-contentBlock__media">
            {{> Video}}
          </div>
          <!-- End: Right Video Content -->
        {{/if}}
      </div>
    {{/unless}}

    <div class="m-contentBlock__columns {{ColumnModifiers}}">
      <div class="m-contentBlock__col">
        {{#with ContentLeft}}
          {{> RTEorImg}}
        {{/with}}

        {{#if ContentLeft.HasVideo}}
          <!-- Start: Left Video Content -->
          <div class="m-contentBlock__video">
            {{> Video}}
          </div>
          <!-- End: Left Video Content -->
        {{/if}}
      </div>

      <div class="m-contentBlock__col {{#unless ../IsCn}}hidden md:block{{/unless}}">
        {{#with ContentRight}}
          {{> RTEorImg}}
        {{/with}}

        {{#if ContentRight.HasVideo}}
          <!-- Start: Right Video Content -->
          <div class="m-contentBlock__media">
            {{> Video}}
          </div>
          <!-- End: Right Video Content -->
        {{/if}}
      </div>
    </div>
  </article>

  <script type="application/json" id="testVidCtrl">
  {{toJson Localization}}
  </script>
{{/ContentBlock}}


{{#*inline "RTEorImg"}}
  {{#if RTE}}
    <!-- Start: RTE Content -->
    <div class="m-contentBlock__rte">
      {{> molecules-cmn-rte}}
    </div>
    <!-- End: RTE Content -->
  {{/if}}

  {{#if GenericImg}}
    <!-- Start: Image Content -->
    <div class="m-contentBlock__media">
      {{> atoms-cmn-generic-img}}
    </div>
    <!-- End: Image Content -->
  {{/if}}
{{/inline}}

{{#*inline "Video"}}
  {{#if ContentRight.DifferentVideoImage}}
    <img class="mx-auto" alt="{{ContentRight.DifferentVideoImage.Alt}}" src="{{ContentRight.DifferentVideoImage.Src}}">
    <o-vid-curate-ctrl script-id="testVidCtrl" :is-video-btn="true" class="absolute top-0 flex w-full h-full justify-center items-center m-auto">
      <span class="a-playCircle -xxl material-icons">play_circle_outline</span>
    </o-vid-curate-ctrl>
  {{else}}
    <o-vid-curate-ctrl script-id="testVidCtrl"></o-vid-curate-ctrl>
  {{/if}}
{{/inline}}