{{#with CTABanner}}
  <section class="m-ctaBanner {{Modifier}}">
    <p class="m-ctaBanner__heading">{{ CTAText }}</p>
    {{#if IsCn}}
      {{> atoms-button Mods="-darkMode -isCn" CTA=CTADescription}}
    {{else}}
      <a-banner-button href="{{ CTAUrl }}">{{ CTADescription }}</a-banner-button>
    {{/if }}
  </section>
{{/with}}