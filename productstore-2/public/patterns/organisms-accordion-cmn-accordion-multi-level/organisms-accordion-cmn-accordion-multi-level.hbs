<div class="o-accordion">
  <h2 class="o-accordion__title -primary">
    <button class="o-accordion__toggler" id="{{ToggleID.A}}" aria-controls="{{ContentID.A}}" aria-expanded="false">{{Title.A}} {{> atoms-arrow Size="-lg" TailwindColor="gray-120" Direction="-down" OtherMods="mt-6 md:right-0"}}</button>
  </h2>

  <div class="o-accordion__content -subLvl" id="{{ContentID.A}}" aria-labelledby="{{ToggleID.A}}" aria-hidden="true" tabindex="-1" role="region">
    <h3 class="o-accordion__title">
      <button class="o-accordion__toggler" id="{{ToggleID.B}}" aria-controls="{{ContentID.B}}" aria-expanded="false">{{Title.B}}{{> atoms-arrow Size="-md" TailwindColor="gray-120" Direction="-down" OtherMods="mt-6 md:right-0"}}</button>
    </h3>
    <div class="o-accordion__content" id="{{ContentID.B}}" aria-labelledby="{{ToggleID.B}}" aria-hidden="true" tabindex="-1" role="region">
      <p>{{loremIpsum}}</p>
    </div>
  </div>
</div>