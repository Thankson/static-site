{{#Modal}}
  <div id="m-modal" class="m-modal {{Mods}}" style="{{Styles}}" role="dialog" aria-labelledby="m-modal__title" aria-modal="true">
    <div class="m-modal__inner" style="{{Size}}">
      <div class="m-modal__content">

        {{#Header}}
          <div class="m-modal__header {{Mods}}" style="{{Styles}}">
            <h2 class="m-modal__title" style="{{StylesTitle}}" id="m-modal__title">
              {{ Title }}
            </h2>
          </div>
        {{/Header}}

        {{#Body}}
          <div class="m-modal__body {{Mods}}" style="{{Styles}}">
            {{{ Content }}}
          </div>
        {{/Body}}

        {{#Footer}}
          <div class="m-modal__footer {{Mods}}" style="{{Styles}}">
            {{#SecondaryButton}}
              <div class="m-modal__btn -secondary">
                {{> atoms-button}}
              </div>
            {{/SecondaryButton}}

            {{#PrimaryButton}}
              <div class="m-modal__btn -primary">
                {{> atoms-button}}
              </div>
            {{/PrimaryButton}}
          </div>
        {{/Footer}}

        {{#CloseBtn}}
          <button class="m-modal__close" aria-label="{{Alt}}">
            <img class="m-modal__closeImg" src="{{Img}}" alt="{{Alt}}" aria-hidden="true" />
          </button>
        {{/CloseBtn}}
      </div>
    </div>
    <div class="m-modal__overlay"></div>
  </div>
{{/Modal}}
<!-- END 37924 - Modal -->