{{#with SignInForm}}
  <o-sign-in-card action="/identity-server" button-aria-label="{{SignInButton.AriaLabel}}" invalid-credential-text="{{InvalidCredentialText}}" :agreement-terms='{{toJson Agreements}}' :hide-country-selector="{{HideCountrySelector}}" :hide-keep-me-signed-in="{{HideKeepMeSignedIn}}" :show-error-message="{{ShowErrorMessage}}" :show-sign-in-greetings="{{ShowSignInGreetings}}" :is-mobile-app="{{IsMobileApp}}" :is-grow-app="{{IsGrowApp}}" greetings-text="{{GreetingsText}}" show-label="{{Field.Password.ShowLabel}}" hide-label="{{Field.Password.HideLabel}}">

    <template v-slot:sign-in-text>
      {{ SignInText }}
    </template>

    <template v-slot:select-sign-in-text>
      {{ SelectSignInText }}
    </template>

    {{#with Field.UserName}}
      <template v-slot:username-label>
        {{Label.Text}}
      </template>
    {{/with}}

    {{#with Field.Password}}
      <template v-slot:password-label>
        {{Label.Text}}
      </template>
    {{/with}}

    {{#with PopupCulture}}
      <template v-slot:popup-culture>
        {{> molecules-popup-culture }}
      </template>
    {{/with}}

    {{#with Field.SignedIn}}
      <template v-slot:signed-in-label>
        {{Label.Text}}
      </template>
    {{/with}}

    <template v-slot:what-does-mean-text>
      {{ WhatDoesMeanText }}
    </template>

    <template v-slot:additional-text>
      {{ AdditionalText }}
    </template>

    {{#with SignInButton}}
      <template v-slot:button-label>
        {{CTA}}
      </template>
    {{/with}}

    <template v-slot:info>
      <a href="{{ForgotLink}}" class="text-green font-medium mb-30 md:mb-0" data-gtm-track='
            {
                "gtmId": "182",
                "gtmText": "{{ ForgotText }}"
            }' data-testid="forgotCredential-link">
        {{ ForgotText }}
      </a>
      <span class="font-medium inline-block px-15 to-md:hidden" aria-hidden="true">|</span>
      <a href="{{CreateLink}}" class="text-green font-medium" data-gtm-track='
            {
                "gtmId": "182",
                "gtmText": "{{ CreateText }}"
            }' data-testid="createAccount-link">
        {{ CreateText }}
      </a>
    </template>

  </o-sign-in-card>
{{/with}}