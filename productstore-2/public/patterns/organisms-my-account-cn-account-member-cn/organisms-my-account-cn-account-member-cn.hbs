<div class="o-accountMember -isCn">
  <div class="o-accountMember__info">
    <h2 class="o-accountMember__name">{{Name}}</h2>
    <p class="o-accountMember__intro">{{Title}}
    </p>
    {{#if Lvip}}
      <span class="o-accountMember__lvip">
        {{Lvip}}<img alt="{{Icon.AltText}}" class="o-accountMember__img -small" src={{Icon.Src}} /></span>
    {{/if}}
  </div>
  <div class="o-accountMember__count">
    <div class="o-accountMember__box">
      <p class="o-accountMember__item">
        {{NumberLabel}}:
        <span class="o-accountMember__number -black">{{Number}}</span>
      </p>

      <p class="o-accountMember__item">
        {{LsdLabel}}:
        <span class="o-accountMember__number {{#if IsReactivate}}-black{{/if}}">{{Lsd}}</span>
      </p>
    </div>
    <div class="o-accountMember__box">
      <p class="o-accountMember__item">
        {{LongevityLabel}}:
        <span class="o-accountMember__number -black">{{Longevity}}</span>
      </p>
      <p class="o-accountMember__item">
        {{CoaLabel}}:
        <span class="o-accountMember__number {{#if IsReactivate}}-black{{/if}}">{{Coa}}</span>
      </p>
    </div>
  </div>
  <div class="o-accountMember__btn">
    {{#with CTA}}
      <a class="o-accountMember__cta {{#if ../IsReactivate}} -cnReactivation {{else}} -cnNotReactivation {{/if}}" href="{{Url}}" {{#if Gtm}} data-gtm-track='
            {
                "gtmId": {{Gtm.Id}},
                "gtmText": "{{Gtm.Text}}"
            }
        ' {{/if}}>
        {{#unless ../IsReactivate}}
          <img alt="{{../Icon.AltText}}" class="o-accountMember__img" src={{../Icon.Src}} />
        {{/unless}}
        {{Label}}
      </a>
    {{/with}}
  </div>
</div>