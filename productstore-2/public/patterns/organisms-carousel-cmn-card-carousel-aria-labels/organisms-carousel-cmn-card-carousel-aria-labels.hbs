<div class="o-cardCarousel hidden">
  <span class="o-cardCarousel__ariaLabel">{{ CardCarouselAriaLabels.Item }}</span>
  <span class="o-cardCarousel__role">{{ CardCarouselAriaLabels.Group }}</span>
  <span class="o-cardCarousel__description">{{ CardCarouselAriaLabels.Slide }}</span>
  <span class="o-cardCarousel__descriptionOf">{{ CardCarouselAriaLabels.OfSlide }}</span>
  <span class="o-cardCarousel__carousel">{{ CardCarouselAriaLabels.TotalCarouselSlides }}</span>
  <span class="o-cardCarousel__currentSlide">{{ CardCarouselAriaLabels.CurrentSlide }}</span>
  <span class="o-cardCarousel__nextSlide">{{ CardCarouselAriaLabels.NextSlide }}</span>
  <span class="o-cardCarousel__previousSlide">{{ CardCarouselAriaLabels.PreviousSlide }}</span>
</div>