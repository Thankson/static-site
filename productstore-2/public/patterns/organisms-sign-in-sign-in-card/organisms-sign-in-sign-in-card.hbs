{{#with SignInForm}}
  <form class="o-signInForm" id="signInForm" name="signInForm" action="" method="post">
    <div class="flex flex-col flex-wrap">
      <div class="w-full uppercase">
        {{#Field.UserName}}
          {{> molecules-form-field-basic}}
        {{/Field.UserName}}
      </div>
      <div class="w-full uppercase">
        {{#Field.Password}}
          {{> molecules-form-field-glimpse}}
        {{/Field.Password}}
      </div>
      <div class="w-full lg:flex lg:flex-row mt-10">
        <div class="lg:w-1_2 w-full flex items-start md:block relative">
          {{#with PopupCulture}}
            {{> molecules-popup-culture }}
          {{/with}}
          <div class="w-full">
            {{#SignInButton}}
              {{> atoms-button}}
            {{/SignInButton}}
          </div>
        </div>
        <div class="o-signInForm__errorMsg hidden w-full pt-5 md:py-5 mt-6 md:mb-9 lg:w-1_2 lg:py-0">
          <p class="o-signInForm__error flex leading-tight text-red text-xs w-full md:text-sm lg:text-left lg:pl-10 xl:pl-25 xl:pr-6">
            <span>Invalid Username or Password. <a href="{{ForgotLink}}" class="font-bold underline">Need Help? <span class="sr-only">Click Here</span></a></span>
          </p>
        </div>
      </div>
      <div class="w-full mb-15 pt-20 md:mb-20">
        {{#Field.SignedIn}}
          {{> molecules-form-field-checkbox}}
        {{/Field.SignedIn}}
      </div>
    </div>
    <div class="flex flex-col flex-wrap md:flex-row mt-30 md:mt-15">
      <a href="{{ForgotLink}}" class="text-green font-medium mb-30 md:mb-0">Forgot Username or Password?</a>
      <span class="font-medium inline-block px-15 to-md:hidden" aria-hidden="true">|</span>
      <a href="{{CreateLink}}" class="text-green font-medium"> Create Account</a>
    </div>
  </form>
{{/with}}