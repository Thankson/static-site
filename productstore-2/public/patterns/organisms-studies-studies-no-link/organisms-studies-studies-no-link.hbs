<article class="o-studies">
  <div class="o-studies__wrapper">
    <header class="o-studies__header m-rte">
      {{{HeaderRTE}}}
    </header>
    <ul class="o-studies__list">
      {{#each Study}}
        <li class="o-studies__listItem">
          {{>molecules-studies-card}}
        </li>
      {{/each}}
    </ul>
    {{#HasCTA}}
      <footer class="o-studies__footer">
        <a class="o-studies__cta" style="background-color: {{BgColor}};" href="{{Url}}" data-js="hoverBg" data-bg-overlay="{{HoverBgColor}}" data-hover-text="{{HoverTxtColor}}">
          <!-- Initial text color must be set on inner div -->
          <div style="color: {{TextColor}}">
            {{{Text}}}
          </div>
        </a>
      </footer>
    {{/HasCTA}}
  </div>
</article>