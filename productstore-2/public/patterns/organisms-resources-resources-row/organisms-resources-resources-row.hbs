<div class="w-full px-10 mx-auto mb-40 max-w-contain md:px-0">
  {{#each ResourcesRows}}
    <h2 class="pb-6 mb-20 text-xl md:text-3xl font-medium border-b-4 border-green">
      {{RowTitle}}
    </h2>
    <div class="mb-20 sm:mb-30">
      {{#if RichText}}
        {{! User Created Rich Text content }}
        {{{RichText}}}
      {{else}}
        {{! User Selected Predefined Components }}
        {{#each DynamicComponents}}
          {{> (lookup . 'Pattern')}}
        {{/each}}
      {{/if}}
    </div>
  {{/each}}