<div class="o-proteinCalc -isCn">
  <h2 class="o-proteinCalc__title">{{{Title}}}</h2>
  <p class="o-proteinCalc__description">{{{Description}}}</p>
  <div class="o-proteinCalc__content">
    <img class="o-proteinCalc__image" src={{Image}} />
    <form id="proteinCalculatorForm" class="o-proteinCalc__form" name="proteinCalculatorForm" action="" method="post">
      {{#ProteinCalculatorForm.GenderDropdown}}
        {{> molecules-form-field-select}}
        <div class="o-proteinCalc__wrapper" aria-live="assertive">
          <div class="o-proteinCalc__error -dropdown hidden">
            <p>{{{../ProteinCalculatorForm.EmptyFieldMessage}}}</p>
          </div>
        </div>
      {{/ProteinCalculatorForm.GenderDropdown}}
      {{#ProteinCalculatorForm.AgeDropdown}}
        {{> molecules-form-field-select}}
        <div class="o-proteinCalc__wrapper" aria-live="assertive">
          <div class="o-proteinCalc__error -dropdown hidden">
            <p>{{{../ProteinCalculatorForm.EmptyFieldMessage}}}</p>
          </div>
        </div>
      {{/ProteinCalculatorForm.AgeDropdown}}
      {{#ProteinCalculatorForm.GoalDropdown}}
        {{> molecules-form-field-select}}
        <div class="o-proteinCalc__wrapper" aria-live="assertive">
          <div class="o-proteinCalc__error -dropdown hidden">
            <p>{{{../ProteinCalculatorForm.EmptyFieldMessage}}}</p>
          </div>
        </div>
      {{/ProteinCalculatorForm.GoalDropdown}}
      {{#ProteinCalculatorForm.CTA}}
        {{> atoms-button}}
      {{/ProteinCalculatorForm.CTA}}
      <div class="o-proteinCalc__wrapper" aria-live="polite">
        <div class="o-proteinCalc__result hidden" role="text">
          <p class="o-proteinCalc__text -protein">{{{ProteinCalculatorForm.Results.Protein}}}</p>
          <p class="o-proteinCalc__text -recommended" id="nutritionShake">{{{ProteinCalculatorForm.Results.ElevateProtein}}}</p>
          <p class="o-proteinCalc__text -recommended" id="attainShake">{{{ProteinCalculatorForm.Results.Proflex}}}</p>
          <p class="o-proteinCalc__text -recommended" id="proflex20Shake">{{{ProteinCalculatorForm.Results.VeganProtein}}}</p>
        </div>
      </div>

    </form>
  </div>

</div>