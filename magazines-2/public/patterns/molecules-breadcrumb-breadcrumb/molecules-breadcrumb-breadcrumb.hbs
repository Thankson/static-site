<nav class="m-breadcrumb {{Mods}}" aria-label="Breadcrumb">
  <ol class="m-breadcrumb__list">
    {{#each Items}}
      <li class="m-breadcrumb__item">
        {{#unless CurrentPage}}
          <a class="m-breadcrumb__link" href="{{Link}}">{{Name}}</a>
        {{else}}
          <span class="m-breadcrumb__link" aria-current="page">{{Name}}</span>
        {{/unless}}
        <span class="m-breadcrumb__separator" aria-hidden="true"> / </span>
      </li>
    {{/each}}
  </ol>
</nav>