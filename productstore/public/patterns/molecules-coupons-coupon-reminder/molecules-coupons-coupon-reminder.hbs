<div class="m-couponReminder {{#if Activated}} -isActivated{{/if}}">
  <h3 class="m-couponReminder__heading">
    <span class="m-couponReminder__splitHeading" role="text">
      <span class="m-couponReminder__title">{{HeadingLine1}}</span>
      {{HeadingLine2}}
    </span>
  </h3>
  <div class="m-couponReminder__media">
    <div class="m-couponReminder__action -button">
      {{>atoms-button}}
    </div>
    <div class="m-couponReminder__action -dropdown">
      {{>atoms-select-coupon-vue}}
    </div>
  </div>
</div>