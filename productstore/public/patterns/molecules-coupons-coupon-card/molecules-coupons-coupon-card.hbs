<script id="data-shelf-configurator-localization" type="application/json">
{{toJson Localization }}
</script>
<article class="m-couponCard">
  <header class="m-couponCard__row -description">
    <div class="m-couponCard__col -description">
      <em class="m-couponCard__title">{{Title}}</em>
      <p class="m-couponCard__text -description">{{Description}}</p>
    </div>
    <div class="m-couponCard__col -product">
      <img class="m-couponCard__img" src="{{Img.Src}}" alt="{{Img.Alt}}">
    </div>
  </header>
  <div class="m-couponCard__row -price">
    <em class="m-couponCard__text -save">Save {{SaveAmt}}</em>
    <div class="m-couponCard__container">
      <p class="m-couponCard__col -coupon">
        <em class="m-couponCard__text -price">{{Price}} |</em> {{Points}} Points
        <span class="m-couponCard__text -subtext -coupon">Coupon Price</span>
      </p>
      <p class="m-couponCard__col -regular">
        <span class="m-couponCard__text -oldPrice">{{OldPrice}}</span>
        <span class="m-couponCard__text -subtext -member">Member Price</span>
      </p>
    </div>
    <p class="m-couponCard__footnote">While supplies last. No cash value. Limit {{Limit}}.</p>
  </div>

  <o-shelf-configurator class="{{Mods}} a-button" sku="{{Sku}}" button-label="{{ButtonAriaLabel}}" family-id="{{FamilyId}}" script-id="data-shelf-configurator-localization">
    {{ CTA }}
  </o-shelf-configurator>
</article>