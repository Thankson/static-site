<article class="m-recentProduct">
  <div class="m-recentProduct__wrapper">
    <img src="{{Image}}" alt="{{FamilyTitle}}" class="m-recentProduct__img">
  </div>

  <div class="m-recentProduct__details">
    <h3 class="m-recentProduct__title">
      <a href="{{PdpPageLink}}">{{FamilyTitle}}</a>
    </h3>
    <p class="m-recentProduct__price">
      <strong>{{Price}}</strong>
    </p>
    <p class="m-recentProduct__points">{{Points}} Points</p>
  </div>

  <div class="m-recentProduct__add">
    <a-cart-add class="a-actionIcon" :gtm-id="415" product-name="{{FamilyTitle}}" aria-label="{{Button.AriaLabel}}" sku="{{Sku}}">
      <img src="{{Button.Image}}" alt="" class="a-actionIcon__img" aria-hidden="true">
    </a-cart-add>
  </div>
</article>