{{#FWBanner}}
  <a href="{{Link}}" class="m-fwBanner {{BlockHeight}} {{#if IsSlide}}-slide{{/if}} {{#if StackAtMobile}}-stackMobile{{/if}} {{#if Has.VideoToggle}}-videoToggle{{/if}} {{#if Has.ImageGrid}}-imageGrid{{/if}} {{#if IsCategoryPage}}-category{{/if}}" data-testid="link-fullWidthBanner">
    <div class="m-fwBanner__row -media">
      <!-- Start: Media block -->
      <!-- images -->
      {{#if Has.BgColor}}
        {{> BgColor}}
      {{/if}}

      {{#if Has.BgImages}}
        {{>atoms-cmn-generic-img}}
      {{/if}}

      <!-- Video -->
      {{#if Has.BgVideo}}
        {{> BgVideo}}
      {{/if}}
      <!-- End: Media block -->
    </div>
    <div class="m-fwBanner__row -columns {{Content.Size}} {{Content.XAlign}} {{Content.YAlign}} {{Content.TextAlign}}">
      <!-- Start: Content block -->
      <div class="m-fwBanner__columns">
        <div class="m-fwBanner__col -content">
          <div class="m-fwBanner__rte">
            <div class="m-rte">
              {{{RTE}}}
            </div>
          </div>

          {{#if Has.CTAButton}} {{#with CTA}}
              <div class="m-fwBanner__cta {{ButtonXAlign}}">
                {{> atoms-cmn-author-btn}}
              </div>
            {{/with}} {{/if}}
        </div>

        {{#if Has.VideoToggle}}
          <div class="m-fwBanner__col -video">
            {{#with ../ToggleVideo}}
              {{> molecules-cmn-video-toggle-button}}
            {{/with}}
          </div>
        {{/if}}

        {{#if Has.ImageGrid}}
          <div class="m-fwBanner__col -grid">
            <div class="m-fwBanner__grid">
              {{#each GridImages}}
                <a class="m-fwBanner__link" href="{{Href}}">
                  <img class="m-fwBanner__image" src="{{ImgSrc}}" alt="ImgAlt">
                </a>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </div>
      <!-- End: Content block -->
    </div>
  </a>
{{/FWBanner}}

{{!-- Start: Background Color --}}
{{#*inline "BgColor"}}
  <div class="m-fwBanner__bgColor" style="background: {{{BgColorCode}}};">
  </div>
{{/inline}}
{{!-- End: Background Color --}}

{{!-- Start: Background Video --}}
{{#*inline "BgVideo"}}
  <div class="m-fwBanner__bgVideo">
    <video muted autoplay loop poster="{{BgVideo.Poster}}" aria-label="{{BgVideo.Description}}">
      <source src="{{BgVideo.WebM}}" type="video/webm" />
      <source src="{{BgVideo.Mp4}}" type="video/mp4" />
    </video>
    {{#with PlayPauseButton}}
      {{> atoms-cmn-play-pause}}
    {{/with}}
  </div>
{{/inline}}
{{!-- End: Background Video --}}