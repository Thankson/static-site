<article class="o-newCustomerBanner">
  {{#if BgImage}}
    <div class="o-newCustomerBanner__bg -reverse -tablet" style="background-image: url('{{BgImage.Src.Tablet}}')" aria-hidden="true"></div>
    <div class="o-newCustomerBanner__bg -reverse -desktop" style="background-image: url('{{BgImage.Src.Desktop}}')" aria-hidden="true"></div>
  {{/if}}

  <header class="o-newCustomerBanner__header">
    <img src="{{Banner.Img}}" class="o-newCustomerBanner__img" />
    <div class="o-newCustomerBanner__description">
      {{{Banner.Description}}}
    </div>
  </header>

  {{#if IsVisibled}}
    <div class="o-newCustomerBanner__gift">
      {{#if BgImage}}
        <div class="o-newCustomerBanner__bg -reverse -mobile" style="background-image: url('{{BgImage.Src.Mobile}}')" aria-hidden="true"></div>
      {{/if}}
      <img src="{{Icon}}" class="o-newCustomerBanner__corner" />

      <div class="o-newCustomerBanner__line">
      </div>

      {{#each Gift}}
        <div class="o-newCustomerBanner__item">
          <div class="o-newCustomerBanner__table">
            <div class="o-newCustomerBanner__intro">
              <div class="o-newCustomerBanner__title">
                {{Title}}
              </div>
              <a class="o-newCustomerBanner__link -itemName" href="{{item.Sku.GoodsUrl}}">
                <div class="o-newCustomerBanner__name">{{Sku.GoodsName}}</div>
              </a>
            </div>
            <a class="o-newCustomerBanner__link -itemImage" href="{{Sku.GoodsUrl}}">
              <img src="{{Sku.GoodsImg}}" class="o-newCustomerBanner__img" />
            </a>
          </div>
        </div>
      {{/each}}

      <div class="o-newCustomerBanner__btn">
        <a class="o-newCustomerBanner__loadMore" href="{{Button.BtnLink}}">{{Button.BtnTxt}}</a>
      </div>
    </div>
  {{else}}
    <div class="o-newCustomerBanner__gift {{#if IsCondition}} -noLogin {{/if}}">
      <img src="{{Icon}}" class="o-newCustomerBanner__corner" />

      {{#if IsCondition}}
        <div class="o-newCustomerBanner__item -noLogin">
          <div class="o-newCustomerBanner__table">
            <div class="o-newCustomerBanner__intro">
              <div class="o-newCustomerBanner__newMsg">新加入第 </br>
                <span class="o-newCustomerBanner__number">{{Condition.FirstNumber}}</span>个月免费拿
              </div>
            </div>
            <div class="-itemImage">
              <img src="{{Condition.Img}}" class="o-newCustomerBanner__img" />
            </div>
          </div>
        </div>

        <a class="o-newCustomerBanner__load" href="#">了解更多<span class="o-newCustomerBanner__number">{{Condition.FirstNumber}}</span> - <span class="o-newCustomerBanner__number">{{Condition.SecondNumber}}</span> 个月好礼 <span aria-hidden="true" class="a-arrow -newAI pl-10"><span class="a-arrow__icon border-black"></span></span></a>
      {{else}}
        {{#each Gift}}
          <div class="o-newCustomerBanner__item">
            <div class="o-newCustomerBanner__table">
              <div class="o-newCustomerBanner__intro">
                <div class="o-newCustomerBanner__title">
                  {{Title}}
                </div>
                <a class="o-newCustomerBanner__link -itemName" href="{{item.Sku.GoodsUrl}}">
                  <div class="o-newCustomerBanner__name">{{Sku.GoodsName}}</div>
                </a>
              </div>
              <a class="o-newCustomerBanner__link -itemImage" href="{{Sku.GoodsUrl}}">
                <img src="{{Sku.GoodsImg}}" class="o-newCustomerBanner__img" />
              </a>
            </div>
          </div>
        {{/each}}
        <div class="o-newCustomerBanner__btn">
          <a class="o-newCustomerBanner__loadMore" href="{{Button.BtnLink}}">{{Button.BtnTxt}}</a>
        </div>
      {{/if}}
    </div>
  {{/if}}
</article>