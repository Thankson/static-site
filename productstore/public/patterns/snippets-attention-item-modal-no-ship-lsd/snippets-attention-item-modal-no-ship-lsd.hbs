{{#with NoShipLSD}}
  <h2 id="global-modal-heading" class="text-2xl md:text-4xl font-normal text-dark leading-base mb-10">
    {{Heading}}
  </h2>

  <!-- List of unavailable items with scroll -->
  <m-unavailable-items :items='{{toJson Items}}' :localization='{{toJson Localization}}' :max-height="210">
  </m-unavailable-items>

  <!-- Buttons -->
  <div class="md:flex">
    <button type="button" class="a-button text-base px-50 py-12" aria-label="{{Close}}">
      {{Close}}
    </button>
  </div>
{{/with}}