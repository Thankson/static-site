{{#with DynamicBanner}}
  <{{#if LinkEnabled}}a href="{{LinkUrl}}" {{else}}div{{/if}} class="m-dynamicBanner" style="background-image: {{#if BackgroundImage}}url('{{BackgroundImage}}'){{/if}};">

    {{#ifCond IconAlignment "===" "left"}}
      {{> dynamicBannerIcon}}
      {{> dynamicBannerContent}}
      {{else}}
        {{> dynamicBannerContent}}
        {{> dynamicBannerIcon}}
    {{/ifCond}}

  </{{#if LinkEnabled}}a{{else}}div{{/if}}>
{{/with}}

{{#*inline "dynamicBannerIcon"}}
  {{#if IconImage}}
    <img class="m-dynamicBanner__icon {{#if IsIconBottomLeft}}-icon-bottom-left{{/if}} {{#if IsIconRightBottom}}-icon-bottom-right{{/if}}" src="{{IconUrl}}" alt="{{IconAlt}}" />
  {{else if PlayButtonIsEnabled}}
    {{#with Icon}}
      {{> atoms-cmn-play-circle-icon }}
    {{/with}}
  {{/if}}
{{/inline}}

{{#*inline "dynamicBannerContent"}}
  <div class="m-dynamicBanner__content {{#if IsIconBottomLeft}}ml-100{{/if}} {{#if IsIconRightBottom}}mr-100{{/if}}">
    <div class="m-dynamicBanner__title">
      <div class="m-rte">
        {{{Title}}}
      </div>
    </div>
    <div class="m-dynamicBanner__subtitle">
      <div class="m-rte">
        {{{Subtitle}}}
        {{#if LinkEnabled}}
          {{#with Arrow}}
            {{> atoms-arrow }}
          {{/with}}
        {{/if}}
      </div>
    </div>
  </div>
{{/inline}}