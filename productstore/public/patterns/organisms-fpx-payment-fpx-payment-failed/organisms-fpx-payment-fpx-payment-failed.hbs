<section class="o-fpxPayment">
  <header class="o-fpxPayment__header">
    <h1 class="o-fpxPayment__title">
      {{PageTitle}}
    </h1>
    <h2 class="o-fpxPayment__subTitle">
      {{OrderLabel}} <span>{{OrderNumber}} </span>{{OrderStatus}}
    </h2>
    <div class="o-fpxPayment__logo">
      <div class="o-fpxPayment__logoText">{{PayWith}}</div><img src="{{FpxLogo.Image}}" alt="{{FpxLogo.Alt}}" class="o-fpxPayment__logoImage" />
    </div>
    <div class="o-fpxPayment__content">
      <span class="a-bullet -inComplete"></span>
      <div class="o-fpxPayment__status -unSuccessful">
        {{Payment}} {{PaymentStatus}}
      </div>
    </div>
  </header>

  <div class="o-fpxPayment__details">
    <div>
      <h2 class="o-fpxPayment__detailsTitle">
        {{DetailTitle}}
      </h2>
      <ul class="o-fpxPayment__detailsContent">
        {{#each Details.Items}}
          {{#if TitleText}}
            <li class="o-fpxPayment__detailsText"><span>{{TitleText}}: </span>{{Content}}</li>
          {{/if}}
        {{/each}}
      </ul>

      <div class="o-fpxPayment__footer">
        {{#with Button}}
          <div class="o-fpxPayment__continueBtn">
            {{> atoms-button}}
          </div>
        {{/with}}

        <div class="o-fpxPayment__logo -footerLogo">
          <div class="o-fpxPayment__logoText -footerText">{{PoweredBy}}</div><img src="{{FpxLogo.Image}}" alt="{{FpxLogo.Alt}}" class="o-fpxPayment__logoImage" />
        </div>
      </div>
    </div>
  </div>
</section>