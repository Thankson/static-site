<modal :heading-visible="false" :visible="true" data-testid="growNotSubscribedModal" width="531px" class="o-growNotSubscribedModal">
  <template #body>
    <h2 class="o-growNotSubscribedModal__heading">
      {{ Heading }}
    </h2>
    <p class="o-growNotSubscribedModal__description">
      {{ Description }}
    </p>
  </template>

  <template #footer>
    <div class="o-growNotSubscribedModal__buttons">
      <a data-testid="growNotSubscribedModal__backButton" href="{{ Link.Url }}" class="o-growNotSubscribedModal__button -bordered">
        {{ Link.Text }}
      </a>
      <a data-testid="growNotSubscribedModal__ctaButton" href="{{ Cta.Url }}" class="o-growNotSubscribedModal__button">
        {{ Cta.Text }}

      </a>
    </div>
  </template>

</modal>