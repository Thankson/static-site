{{#JumpLinks}}
  <m-jump-links>
    {{#About}}
      <template v-slot:about>
        <a id="{{Id}}" href="{{URL}}" class="m-jumpLinks__link" data-smooth-scroll="1000" aria-label="{{AriaLabel}}" {{#if GtmId}} v-on:click='gtmTrackAction({"id": "{{GtmId}}", "text": "{{Title}}"}, $event)' {{/if}}>

          {{!-- -mobile must come before the -standard --}}
          <span class="m-jumpLinks__title -mobile">{{MobileTitle}}</span>
          <span class="m-jumpLinks__title -standard">{{Title}}</span>
        </a>
      </template>
    {{/About}}

    {{#Ingredients}}
      <template v-slot:ingredients>
        <a id="{{Id}}" href="{{URL}}" class="m-jumpLinks__link" data-scrollTo="true" data-smooth-scroll="1000" {{#if GtmId}} v-on:click='gtmTrackAction({"id": "{{GtmId}}", "text": "{{Title}}"}, $event)' {{/if}}>

          {{!-- -mobile must come before the -standard --}}
          <span class="m-jumpLinks__title -mobile">{{MobileTitle}}</span>
          <span class="m-jumpLinks__title -standard">{{Title}}</span>
        </a>
      </template>
    {{/Ingredients}}

    {{#Reviews}}
      <template v-slot:reviews>
        <a id="{{Id}}" href="{{URL}}" class="m-jumpLinks__link" data-smooth-scroll="1000" aria-label="{{AriaLabel}}" {{#if GtmId}} v-on:click='gtmTrackAction({"id": "{{GtmId}}", "text": "{{Title}}"}, $event)' {{/if}}>

          {{!-- -mobile must come before the -standard --}}
          <span class="m-jumpLinks__title -mobile">{{MobileTitle}}</span>
          <span class="m-jumpLinks__title -standard">{{Title}}</span>
        </a>
      </template>
    {{/Reviews}}

    {{#TermsConditions}}
      <template v-slot:terms-conditions>
        <a id="{{Id}}" href="{{URL}}" class="m-jumpLinks__link" data-smooth-scroll="1000" aria-label="{{AriaLabel}}" {{#if GtmId}} v-on:click='gtmTrackAction({"id": "{{GtmId}}", "text": "{{Title}}"}, $event)' {{/if}}>

          {{!-- -mobile must come before the -standard --}}
          <span class="m-jumpLinks__title -mobile">{{MobileTitle}}</span>
          <span class="m-jumpLinks__title -standard">{{Title}}</span>
        </a>
      </template>
    {{/TermsConditions}}
  </m-jump-links>
{{/JumpLinks}}