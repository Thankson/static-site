<nav class="m-helpTiles {{#if IsCn}}-isCn{{/if}} overflow-hidden xl:overflow-visible max-w-contain md:mx-auto">
  <ul class="m-helpTiles__list flex-wrap items-stretch overflow-hidden to-md:px-10 md:-mx-15 md:px-0 md:flex md:justify-between to-md:border-gray-50 {{#unless ../IsCn}} to-md:border-t-1 to-md:border-b-1 {{/unless}} to-md:mb-10 to-md:tracking-tight">
    {{#each Tiles}}
      <li class="m-helpTiles__item flex-grow md:mx-15 md:w-1_5 md:mb-30 md:last:mb-30 md:min-h-90 lg:min-h-120 to-md:border-gray-25 to-md:border-b-2 last:-mb-2 md:rounded-b-md md:hover:shadow-green">
        {{#if ModalRte}}
          {{> ModalToggleWrapper}}
        {{else}}
          {{> LinkWrapper}}
        {{/if}}
      </li>
    {{/each}}
  </ul>
</nav>

{{#*inline "Content"}}
  <div class="relative flex items-center h-full px-1 py-12 text-base text-gray-100 bg-white md:border md:border-t-0 lg:text-xl md:px-20 md:border-gray-50 md:py-15 md:rounded-b-md font-global-sans">
    <p class="md:leading-tight md:mx-auto md:text-center pr-25 md:pr-0 {{#if ../IsCn}}font-semibold text-green-100{{/if}}">
      {{Text1}}<em class="not-italic font-semibold text-green-100">{{TextAccented}}</em>{{Text2}}
    </p>
    {{#if ../IsCn}}
      {{> atoms-arrow Size="-sm2" TailwindColor="gray-100" Direction="-right" OtherMods="-thin absolute right-10 md:hidden inset-y-0 my-auto"}}
    {{else}}
      {{> atoms-arrow Size="-sm2" TailwindColor="green-100" Direction="-right" OtherMods="-thin absolute right-10 md:hidden inset-y-0 my-auto"}}
    {{/if}}
  </div>
{{/inline}}

{{#*inline "GtmTrack"}}
  data-gtm-track='{ "gtmId": {{Gtm.Id}}, "gtmText": "{{Gtm.Text}}" }'
{{/inline}}

{{#*inline "ModalToggleWrapper"}}
  <a-modal-toggle class="block h-full w-full md:border-t-2 md:border-green-100 {{Class}}" :heading-visible="false" {{#if Gtm}} {{> GtmTrack}} {{/if}}>
    {{> Content}}
    <template v-slot:body>
      {{{ModalRte}}}
    </template>
  </a-modal-toggle>
{{/inline}}

{{#*inline "LinkWrapper"}}
  <a href="{{Link}}" class="block h-full md:border-t-2 md:border-green-100 {{Class}}" data-href="{{Link}}" {{#if Gtm}} {{> GtmTrack}} {{/if}}>
    {{> Content}}
  </a>
{{/inline}}