<o-access active-step="{{ActiveStep}}" active-text="{{ProgressBar.ActiveText}}" complete-text="{{ProgressBar.CompleteText}}">
  <template v-slot:heading>
    {{Title}}
  </template>

  {{#each Steps}}
    <template v-slot:progress-step-{{@index}}>
      {{ProgressTitle}}
    </template>

    <template v-slot:step-{{@index}}>
      <h2 class="text-2xl-2 mb-15">{{Title}}</h2>

      <p>{{Description}}</p>
    </template>
  {{/each}}

  <template v-slot:progress-final>
    {{FinalStep.ProgressTitle}}
  </template>
</o-access>

<!-- Example of <a-access-link> component for navigation -->
<div class="max-w-contain mx-auto px-15 md:px-0 md:flex justify-center">
  <a-access-link class="a-accountButton flex-1 mb-20 md:mr-10" prev>Previous</a-access-link>

  <a-access-link class="a-accountButton flex-1 mb-20 md:ml-10" next>Next</a-access-link>
</div>