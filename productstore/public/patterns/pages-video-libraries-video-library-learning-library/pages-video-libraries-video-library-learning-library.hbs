{{> organisms-site-header}}

<div class="bg-gray-25">
  <div class="mb-10 pt-15">
    {{#Breadcrumb}}
      {{> molecules-breadcrumb }}
    {{/Breadcrumb}}
  </div>

  <video-library script-id="{{VideoLibrary.DynamicId}}">
    <sc-placeholder class="hidden" slot-name="menu">
      {{> molecules-cat-list-menu}}
    </sc-placeholder>

    <sc-placeholder class="hidden" slot-name="banner">
      <div class="bg-no-repeat bg-cover bg-center py-110" style="background-image: url('https://placehold.co/970x220');height:220px;">&nbsp;</div>
    </sc-placeholder>
  </video-library>

  {{#with VideoLibrary}}
    <script type="application/json" id="{{DynamicId}}">
    {{toJson Localization}}
    </script>
  {{/with}}
</div>

{{> organisms-site-footer}}