{{> organisms-site-header-checkout}}

<div class="bg-gray-25">

  <p-checkout-edit-account-info script-id="{{DynamicScriptId}}">
    {{#if BannerVariant1}}
      <sc-placeholder class="hidden" slot-name="banner-variant-1">
        {{> molecules-adapt-notice-banner BannerVariant1}}
      </sc-placeholder>
    {{/if}}

    {{#if BannerVariant2}}
      <sc-placeholder class="hidden" slot-name="banner-variant-2">
        {{> molecules-adapt-notice-banner BannerVariant2}}
      </sc-placeholder>
    {{/if}}
  </p-checkout-edit-account-info>

  <script type="application/json" id="{{DynamicScriptId}}">
  {{toJson Localization}}
  </script>

</div>