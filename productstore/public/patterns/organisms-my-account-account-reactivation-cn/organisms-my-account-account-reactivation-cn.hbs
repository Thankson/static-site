<article class="o-acctCardSection -reactivation">
  <h4 class="mb-9 text-2xl text-gray-150 md:text-2xl-2">{{Header}}</h4>
  <div class="o-acctCardSection__text m-rte">
    {{!-- Start RTE --}}
    <p class="text-gray-120 text-sm leading-tight md:text-base">{{Text}}</p>
    {{!-- End RTE --}}
  </div>
  <div class="o-acctCardSection__action -half">
    <a class="a-button test {{Mods}}" href="{{{Attr.Href}}}" target="{{Target}}" {{{AriaProps}}} style="{{Styles}}" data-gtm-track='
                {
                    "gtmId": "204",
                    "gtmText": "Reactivate Account"
                }
            '>
      {{CTA}}
    </a>
  </div>
</article>