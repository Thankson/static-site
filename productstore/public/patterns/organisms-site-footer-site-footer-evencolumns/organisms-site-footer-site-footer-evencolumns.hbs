<footer class="o-siteFooter {{#unless UserSignedIn}}-signedOut{{/unless}} {{#if ShowFlag}}-showFlagLeft{{/if}} {{#if EvenColumnsLayout}}-evenColumnsLayout{{/if}}">
  <div class="o-siteFooter__section -bg">
    <div class="o-siteFooter__bg -desktop" style="{{Images.Desktop}}" role="img"></div>
    <div class="o-siteFooter__bg -mobile" style="{{Images.Mobile}}" role="img"></div>
  </div>
  <div class="o-siteFooter__section -content">
    <div class="o-siteFooter__row -brand">
      <a href="{{MelaLogo.Link}}" class="o-siteFooter__link">
        {{> atoms-mela-logo }}
      </a>
    </div>
    <div class="o-siteFooter__row -content {{#if UserSignedIn}}-signedIn{{/if}}">
      {{#if ShowFlag}}
        <div class="o-siteFooter__col -showFlagLeft">
          <div class="o-siteFooter__col -showFlagLeftInner">
            <div class="o-siteFooter__address">
              <div class="o-siteFooter__contact">
                <p>
                  {{{Text.Address}}}
                </p>
                <a href="tel:+1(208)522-0700" aria-label="{{Text.AriaLabel.Phone}}">{{Text.Phone}}</a><br />
                <a href="mailto:info@melaleuca.com" aria-label="{{Text.AriaLabel.Email}}">{{Text.Email}}</a>
              </div>
            </div>
            <div class="o-siteFooter__stamp -showFlagLeftStamp">
              <a href="{{GuaranteedLogo.Link}}" class="o-siteFooter__link">
                {{> atoms-guaranteed-logo}}
              </a>
            </div>
          </div>
          <a href="{{MadeInAmerica.Link}}" class="o-siteFooter__flagLink">
            <img class="o-siteFooter__flagImg" src="{{MadeInAmerica.Src}}" alt="{{MadeInAmerica.Alt}}">
            <p class="o-siteFooter__flagText">{{MadeInAmerica.FlagText}}</p>
          </a>
        </div>
      {{else}}
        <div class="o-siteFooter__col -details">
          <div class="o-siteFooter__address">
            <div class="o-siteFooter__contact">
              <p>
                {{{Text.Address}}}
              </p>
              <a href="tel:+1(208)522-0700" aria-label="{{Text.AriaLabel.Phone}}">{{Text.Phone}}</a><br />
              <a href="mailto:info@melaleuca.com" aria-label="{{Text.AriaLabel.Email}}">{{Text.Email}}</a>
              {{#unless EvenColumnsLayout}}
                <a href="{{BetterBusiness.Link}}" class="o-siteFooter__link">
                  <img class="o-siteFooter__bbbDeskLogo" src="{{BetterBusiness.Src}}" alt="{{BetterBusiness.Alt}}">
                </a>
              {{/unless}}
            </div>
          </div>
          <div class="o-siteFooter__stamp">
            <a href="{{GuaranteedLogo.Link}}" class="o-siteFooter__link">
              {{> atoms-guaranteed-logo}}
            </a>
          </div>
        </div>
      {{/if}}
      <nav class="o-siteFooter__col -nav">
        <div class="o-siteFooter__nav -left {{#if EvenColumnsLayout}}-evenColumns{{/if}} {{#unless UserSignedIn}}-signedOut{{/unless}}">
          <ul class="o-siteFooter__navList" data-testid="listItem-footerLinkList">
            {{#if UserSignedIn}}
              <!-- Start: SignedIn -->
              {{#each NavLinksLeftSignedIn}}
                <li class="o-siteFooter__item" data-testid="listItem-footerLink">
                  <a class="o-siteFooter__link" href="{{Link.CTA}}" aria-label="{{{Link.AriaLabel}}}">{{{Link.Title}}}</a>
                </li>
              {{/each}}
              <!-- End SignedIn -->
            {{else}}
              <!-- Start: SignedOut -->
              {{#each NavLinksLeftSignedOut}}
                <li class="o-siteFooter__item" data-testid="listItem-footerLink">
                  <a class="o-siteFooter__link" href="{{Link.CTA}}" aria-label="{{{Link.AriaLabel}}}">{{{Link.Title}}}</a>
                </li>
              {{/each}}
              <!-- End: SignedOut -->
            {{/if}}
          </ul>
        </div>
        <!-- Start: EvenColumnsLayout - Right Columns -->
        {{#if EvenColumnsLayout}}
          {{#if UserSignedIn}}
            <!-- Start: SignedIn -->
            {{#with NavLinksRight.[0]}}
              <div class="o-siteFooter__nav -evenColumns">
                <ul class="o-siteFooter__navList" data-testid="listItem-footerLinkList">
                  {{#each .}}
                    <li class="o-siteFooter__item" data-testid="listItem-footerLink">
                      <a class="o-siteFooter__link" href="{{Link.CTA}}" aria-label="{{{Link.AriaLabel}}}">
                        {{{Link.Title}}}
                      </a>
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/with}}
            {{#with NavLinksRight.[1]}}
              <div class="o-siteFooter__nav -rightOuter">
                <ul class="o-siteFooter__navList" data-testid="listItem-footerLinkList">
                  {{#each .}}
                    <li class="o-siteFooter__item" data-testid="listItem-footerLink">
                      <a class="o-siteFooter__link" href="{{Link.CTA}}" aria-label="{{{Link.AriaLabel}}}">
                        {{{Link.Title}}}
                      </a>
                    </li>
                  {{/each}}
                </ul>
                <a class="o-siteFooter__link" href="{{../BetterBusiness.Link}}">
                  <img class="o-siteFooter__bbbDeskLogo" src="{{../BetterBusiness.Src}}" alt="{{../BetterBusiness.Alt}}">
                </a>
              </div>
            {{/with}}
            <!-- End SignedIn -->
          {{else}}
            <!-- Start: SignedOut -->
            <div class="o-siteFooter__nav -right">
              {{#with Text}}
                <h2 class="o-siteFooter__heading">{{{FooterCopy.Title}}}</h2>
                <p class="o-siteFooter__description">{{{FooterCopy.Desc}}}</p>
              {{/with}}
              <a class="o-siteFooter__link {{#unless ShowFlag}}-rightLogo{{/unless}}" href="{{BetterBusiness.Link}}">
                <img class="o-siteFooter__bbbDeskLogo" src="{{BetterBusiness.Src}}" alt="{{BetterBusiness.Alt}}">
              </a>
            </div>
            <!-- End: SignedOut -->
          {{/if}}
          <!-- End: EvenColumnsLayout - Right Columns -->
        {{else}}
          <div class="o-siteFooter__nav -right">
            {{#if UserSignedIn}}
              <!-- Start: SignedIn -->
              {{#each NavLinksRight}}
                <div class="o-siteFooter__navList" data-testid="listItem-footerLinkList">
                  <ul>
                    {{#each .}}
                      <li class="o-siteFooter__item" data-testid="listItem-footerLink">
                        <a class="o-siteFooter__link" href="{{Link.CTA}}" aria-label="{{{Link.AriaLabel}}}">
                          {{{Link.Title}}}
                        </a>
                      </li>
                    {{/each}}
                  </ul>
                </div>
              {{/each}}
              <!-- End SignedIn -->
            {{else}}
              <!-- Start: SignedOut -->
              {{#with Text}}
                <h2 class="o-siteFooter__heading">{{{FooterCopy.Title}}}</h2>
                <p class="o-siteFooter__description">{{{FooterCopy.Desc}}}</p>
              {{/with}}
              {{#if ShowFlag}}
                <a class="o-siteFooter__link" href="{{BetterBusiness.Link}}">
                  <img class="o-siteFooter__bbbDeskLogo" src="{{BetterBusiness.Src}}" alt="{{BetterBusiness.Alt}}">
                </a>
              {{/if}}
              <!-- End: SignedOut -->
            {{/if}}
          </div>
        {{/if}}
      </nav>
      <div class="o-siteFooter__bbb">
        <a href="{{BetterBusiness.Link}}" class="o-siteFooter__link">
          <img class="o-siteFooter__bbbMobileLogo" src="{{BetterBusiness.Src}}" alt="{{BetterBusiness.Alt}}">
        </a>
      </div>
    </div>
    <div class="o-siteFooter__actions">
      <div class="o-siteFooter__cultures" data-culture-select>
        {{#CultureSelect}}
          <label class="text-left text-white text-sm uppercase block mb-4 to-md:pt-20" for="{{Select.UniqueId}}">Select Language</label>
          {{> atoms-select}}
        {{/CultureSelect}}
      </div>
      <div class="o-siteFooter__social">
        {{#each SocialIcons}}
          {{#if SocialIcon.Tooltip.Rte}}
            <m-tooltip close-alt="{{SocialIcon.Tooltip.Close.Alt}}" close-aria-label="{{SocialIcon.Tooltip.Close.AriaLabel}}" close-icon="{{SocialIcon.Tooltip.Close.Icon}}" :popper-offset-x-desktop="{{SocialIcon.Tooltip.Offset.Horizontal.Desktop}}" :popper-offset-x-mobile="{{SocialIcon.Tooltip.Offset.Horizontal.Mobile}}" :popper-offset-y="{{SocialIcon.Tooltip.Offset.Vertical}}" toggle tooltip-rte="{{SocialIcon.Tooltip.Rte}}" tooltip-popup-mod="max-w-full py-30 px-12 sm:px-20">
              <template v-slot:button>
                <div class="o-siteFooter__socialIcon">
                  <button role="button" class="o-siteFooter__socialAnchor" data-testid="button-footerSocialLink" aria-label="{{SocialIcon.AriaLabel}}">
                    {{> SocialIconImg}}
                  </button>
                </div>
              </template>
            </m-tooltip>
          {{else}}
            <div class="o-siteFooter__socialIcon">
              <a class="o-siteFooter__socialAnchor" href="{{SocialIcon.Url}}" aria-label="{{SocialIcon.AriaLabel}} " data-testid="link-footerSocial">
                {{> SocialIconImg}}
              </a>
            </div>
          {{/if}}
        {{/each}}
      </div>
    </div>
    <div class="o-siteFooter__copyright">
      <p class="o-siteFooter__copyrightText">
        {{{Text.Copyright}}}
      </p>
    </div>
  </div>
  <!-- Pop-up messages -->
  {{> molecules-popup-message }}
  <!-- Modal -->
  {{> molecules-cmn-modal }}
</footer>

{{#*inline "SocialIconImg"}}
  <img class="o-siteFooter__socialImg noLazy" src="{{SocialIcon.Src}}" alt="{{SocialIcon.Alt}}" aria-hidden="true">
{{/inline}}