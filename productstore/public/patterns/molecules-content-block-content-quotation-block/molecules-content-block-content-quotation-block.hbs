{{#QuotationBlock}}
  <article class="m-contentBlock {{WidthControl}}">
    <div class="m-contentBlock__columns">
      <div class="m-contentBlock__col mb-20 md:mb-0">
        {{#with ContentLeft}}
          {{> RTEorImg}}
        {{/with}}
      </div>
      <div class="m-contentBlock__col">
        {{#with ContentRight}}
          {{> RTEorImg}}
        {{/with}}
      </div>
    </div>
  </article>
{{/QuotationBlock}}

{{#*inline "RTEorImg"}}
  {{#if RTE}}
    <!-- Start: RTE Content -->
    <div class="m-contentBlock__rte">
      {{> molecules-cmn-rte}}
    </div>
    <!-- End: RTE Content -->
  {{/if}}

  {{#if GenericImg}}
    <!-- Start: Image Content -->
    <div class="m-contentBlock__media">
      {{> atoms-cmn-generic-img}}
    </div>
    <!-- End: Image Content -->
  {{/if}}
{{/inline}}