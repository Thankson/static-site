<section class="o-busCommBlock">
  <div class="o-busCommBlock__wrapper">
    <div class="o-busCommBlock__col">
      <h4 class="o-busCommBlock__header">{{BusinessCommission.Col1.Title}}</h4>
      <p class="o-busCommBlock__subHeader">{{BusinessCommission.Col1.Subtitle}}</p>
      {{> molecules-business-address-card}}
    </div>
    <div class="o-busCommBlock__col -noAccount">
      <h4 class="o-busCommBlock__header">{{BusinessCommission.Col2.Title}}</h4>
      <p class="o-busCommBlock__subHeader">{{BusinessCommission.Col2.Subtitle}}</p>

      <div class="o-busCommBlock__noAccount">
        <a href="{{BusinessCommission.Col2.CTA.Link}}" class="justify-center w-full text-center text-sm md:text-base text-green leading-base uppercase block border-green border-1 rounded w-full py-15 px-0 md:p-15 font-medium" data-gtm-track='
                {
                    "gtmId": "204",
                    "gtmText": "{{BusinessCommission.Col2.CTA.Text}}"
                }
                '>
          <span class="mr-5">+</span>
          {{BusinessCommission.Col2.CTA.Text}}
        </a>
      </div>
    </div>
  </div>
</section>