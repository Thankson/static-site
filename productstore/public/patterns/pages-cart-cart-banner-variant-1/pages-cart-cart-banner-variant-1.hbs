{{> organisms-site-header}}

<div class="bg-gray-25">

  <cart script-id="{{DynamicScriptId}}" {{#if IsEmpty}}:empty="true" {{/if}}>
    {{#if IsEmpty}}
      <sc-placeholder class="hidden" slot-name="empty-cart-placeholder">
        {{#if EmptyRTE}}
          {{{ EmptyRTE }}}
        {{/if}}
        {{#if EmptyCartCta}}
          {{> atoms-button EmptyCartCta}}
        {{/if}}
        {{#if EmptyCartFeatured}}
          <div class="mt-30 md:mt-50">
            {{> organisms-cmn-category-section EmptyCartFeatured}}
          </div>
        {{/if}}
      </sc-placeholder>
    {{/if}}

    {{#if CreditCardBanner }}
      <template v-slot:ad-variant-3>
        <m-credit-card-ads :is-modal="false" background-color="#e69c4d4d"></m-credit-card-ads>
      </template>
    {{/if}}


    {{#if AdVariant1}}
      <sc-placeholder class="hidden" slot-name="ad-variant-1">
        {{> molecules-adapt-ad AdVariant1}}
      </sc-placeholder>
    {{/if}}

    {{#if AdVariant2}}
      <sc-placeholder class="hidden" slot-name="ad-variant-2">
        {{> molecules-adapt-ad AdVariant2}}
      </sc-placeholder>
    {{/if}}

    {{#if AdVariant3}}
      <sc-placeholder class="hidden" slot-name="ad-variant-3">
        {{> molecules-adapt-ad AdVariant3}}
      </sc-placeholder>
    {{/if}}

    {{#if BannerVariant1}}
      <sc-placeholder class="hidden" slot-name="banner-variant-7">
        {{> molecules-adapt-notice-banner BannerVariant1}}
      </sc-placeholder>
    {{/if}}

    {{#if BannerVariant2}}
      <sc-placeholder class="hidden" slot-name="banner-variant-2">
        {{> molecules-adapt-notice-banner BannerVariant2}}
      </sc-placeholder>
    {{/if}}

  </cart>

  <script type="application/json" id="{{DynamicScriptId}}">
  {{toJson Localization}}
  </script>

  <script id="data-shelf-configurator-localization" type="application/json">
  {{toJson Localization}}
  </script>
</div>

{{> organisms-site-footer}}