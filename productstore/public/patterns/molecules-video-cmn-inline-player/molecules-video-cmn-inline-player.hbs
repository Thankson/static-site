<div class="m-inlinePlayer {{#if IsContentWidth}}-contain{{/if}}">
  {{#with Video}}
    <img class="m-inlinePlayer__thumbnail" src="{{thumbnailImageUrl}}" alt="{{title}}">
    <button class="m-inlinePlayer__playButton">
      <span class="sr-only">Play video</span>
      <img class="m-inlinePlayer__playIcon" src="{{../OverlayImage}}" alt="Play video" aria-hidden="true">
    </button>
    {{> atoms-cmn-mela-player}}
  {{/with}}
</div>