{{> organisms-site-header}}

<div class="bg-gray-25">
  <div class="mb-10 pt-15">
    {{#Breadcrumb}}
      {{> molecules-breadcrumb }}
    {{/Breadcrumb}}
  </div>

  <beauty-tool-kit-video-library script-id="{{VideoLibrary.DynamicId}}">
    <sc-placeholder class="hidden" slot-name="menu">
      {{> molecules-cat-list-menu}}
    </sc-placeholder>
  </beauty-tool-kit-video-library>

  {{#with VideoLibrary}}
    <script type="application/json" id="{{DynamicId}}">
    {{toJson Localization}}
    </script>
  {{/with}}
</div>

{{> organisms-site-footer}}