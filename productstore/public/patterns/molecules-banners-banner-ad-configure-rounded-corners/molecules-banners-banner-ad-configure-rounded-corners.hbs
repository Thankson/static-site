 {{#> atoms-badge}}
   <div class="m-bannerAd{{#if IsReactivation}} -isReactivation{{/if}} {{Mod.Padding.Top}} {{Mod.Padding.Bottom}} {{Mod.Padding.Left}} {{Mod.Padding.Right}}" style="background-color:{{#if Mod.Background.UseColor}} {{Mod.Background.Color}} {{/if}}; min-height: {{Mod.Height}}">

     {{#unless Mod.Background.UseColor}}
       <div class="m-bannerAd__image -desktop {{Mod.Image.Desktop}} {{#if Mod.RoundedCorners.enabled}} {{Mod.RoundedCorners.size}} {{/if}}" style="{{Images.Main.Desktop}}"></div>
       <div class="m-bannerAd__image -mobile {{Mod.Image.Mobile}} {{#if Mod.RoundedCorners.enabled}} {{Mod.RoundedCorners.size}} {{/if}}" style="{{Images.Main.Mobile}}"></div>
     {{/unless}}

     {{#if ShowLink}}
       <a class="m-bannerAd__link" href="{{BannerLink}}">
     {{/if}}

     <div class="m-bannerAd__content {{Mod.Content}} {{#if Mod.Align}} -{{Mod.Align}} {{/if}}">
       {{! Start: Rich Text Demo}}
       <div class="m-rte">
         {{! All text and styles within this RTE Demo block is for demonstrative purposes only }}
         <em class="{{Mod.Title}}">{{{Text.Title}}}</em>
         <p class="{{Mod.Subtitle}}">{{{Text.Subtitle}}}</p>
         <p class="{{Mod.Footnote}}">{{{Text.Footnote}}}</p>
       </div>

       {{! End: Rich Text Demo}}
       {{#if Button.ShowButton}}
         <a class="m-bannerAd__button a-button -white" href="{{Button.Link}}" {{#if Button.IsDownloadButton}} download {{/if}}>
           {{Button.Text}}
         </a>
       {{/if}}

     </div>

     <div class="m-bannerAd__media">
       {{#if HasProductImage}}
         <img class="m-bannerAd__product" src="{{Images.Product.Src}}" alt="{{Images.Product.Alt}}">
       {{/if}}
     </div>

     {{#if ShowLink}}
       </a>
     {{/if}}
   </div>
 {{/atoms-badge}}

 {{!-- This is for showing Premium Badge Modal --}}
 {{#if BadgeModal}}
   {{#with BadgeModal}}
     {{> organisms-badge-modal}}
   {{/with}}
 {{/if}}