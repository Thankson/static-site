<div class="lg:container">
  {{#each Cards}}
    <article class="relative z-0 w-full px-20 py-10 bg-white border rounded-md md:py-30 pb-30 md:pb-100 mb-15 md:mb-60 border-gray-50">
      <header class="md:max-w-2_3">
        <h2 class="mb-20 text-5xl font-light text-gray-150">{{Title}}</h2>
        {{> molecules-contact-summary}}
      </header>

      <div class="md:max-w-1_2">
        <div class="mt-10 md:mt-50">
          {{> organisms-cmn-accordion-two-col}}
        </div>
      </div>
      {{#each AdditionalRows}}
        <div class="mt-20 md:mt-60">
          <hr class="pt-30 md:pt-50 {{DividerMods}}">
          {{#each ContentBlock}}
            <div class="md:max-w-1_2 mb-30 md:mb-60 last:mb-0">
              <h3 class="mb-10 text-xl font-medium uppercase md:mb-20 md:text-gray-120">{{Title}}</h3>
              {{> organisms-cmn-accordion-two-col}}
            </div>
          {{/each}}
        </div>
      {{/each}}
      {{> atoms-corner-imagery}}
    </article>
  {{/each}}
</div>