<m-cart-summary item-total="{{ItemTotal}}" lsd-total="{{LsdTotal}}" cc-total="{{CcTotal}}" subtotal="{{Subtotal}}" points="{{Points}}" checkout-url="{{Localization.CheckoutUrl}}" pending-label="{{Localization.Pending}}" {{#if Shipping}}shipping="{{Shipping}}" {{/if}}>

  <template v-slot:heading>
    {{{Localization.Heading}}}
  </template>

  <template v-slot:item-total>
    {{Localization.ItemTotal}}
  </template>

  <template v-slot:lsd-total>
    {{{Localization.LsdTotal}}}
  </template>

  <template v-slot:cc-total>
    {{{Localization.CcTotal}}}
  </template>

  <template v-slot:subtotal>
    {{Localization.Subtotal}}
  </template>

  <template v-slot:points>
    {{Localization.Points}}
  </template>

  <template v-slot:shipping-taxes>
    {{{Localization.ShippingTaxes}}}
  </template>

  <template v-slot:sales-taxes>
    {{{Localization.GSTLabel}}}
  </template>

  {{#if Localization.CheckoutButton}}
    <template v-slot:button>
      <v-button :is-anchor="true" class="-cartCheckout" :class="{'-disabled pointer-events-none' : {{Localization.CheckoutButton.Disabled}} }" href="{{Localization.CheckoutButton.Url}}" :type="null">
        {{Localization.CheckoutButton.Text}}
      </v-button>
    </template>
  {{/if}}

  {{#if Error}}
    <template v-slot:error>
      {{{Error.Text}}}
    </template>
  {{/if}}

  <template v-slot:savings-heading>
    {{Localization.AsPreferred}}
  </template>

  <template v-slot:savings>
    {{Localization.YouSaved}}
  </template>
</m-cart-summary>