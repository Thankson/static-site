<section class="o-stopAccessNoOrder">
  <img class="o-stopAccessNoOrder__bgImage" alt="{{BgImage.Alt}}" src="{{BgImage.Src}}">
  <div class="o-stopAccessNoOrder__heading">
    <h2 class="o-stopAccessNoOrder__title">{{Title}}</h2>
    <p class="o-stopAccess__message ">{{Message}}</p>
  </div>
  {{> molecules-no-order-card}}
  <div class="o-stopAccessNoOrder__footer">
    <a class="o-stopAccessNoOrder__action" href="{{SignOut.Url}}">{{SignOut.SignOutText}}</a>
  </div>
</section>