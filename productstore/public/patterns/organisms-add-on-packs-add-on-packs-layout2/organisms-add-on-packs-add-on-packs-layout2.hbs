<article class="o-addOnPacks {{AddOnPacksMod}}" style="background-color: {{BgColor}};">
  <header class="o-addOnPacks__header  m-rte">
    {{!-- Start RTE --}}
    {{{Header}}}
    {{!-- End RTE --}}
  </header>
  <ul class="o-addOnPacks__list {{#if IsEnhancement}}-mod{{/if}}">
    {{#if Sku.[1]}}
      {{#each Sku}}
        <li class="o-addOnPacks__listItem">
          {{> molecules-add-on-packs}}
        </li>
      {{/each}}
    {{else}}
      {{#each Sku}}
        <li class="o-addOnPacks__listItem -single">
          {{> molecules-add-on-packs}}
        </li>
      {{/each}}
    {{/if}}
  </ul>
</article>