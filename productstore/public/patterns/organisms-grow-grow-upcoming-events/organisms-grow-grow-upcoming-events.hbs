<div class="o-growUpcomingEvents p-6 border px-10 md:px-30 pt-12 md:pt-32 pb-20 bg-cover bg-center" style="
        {{#if Labels.BackgroundColor}}background-color: {{Labels.BackgroundColor}};{{/if}}
        {{#if Labels.BorderColor}}border-color: {{Labels.BorderColor}};{{/if}}
        {{#if Labels.BackgroundGradient}}background-image: {{Labels.BackgroundGradient}};{{/if}}
        {{#if Labels.BackGroundImage.Url}}background-image: url('{{Labels.BackGroundImage.Url}}');{{/if}}
    ">
  <h2 class="o-growUpcomingEvents__heading text-2xl font-bold text-dark border-b-2 pb-10 mb-8 md:mb-4" style="{{#if Labels.HeadingTextColor}}color: {{Labels.HeadingTextColor}};{{/if}}">
    {{Labels.HeaderText}}
  </h2>

  <ul role="list" class="o-growUpcomingEvents__list pl-2 pr-10 md:px-0">
    {{#each Data.Events as | event |}}
      <li role="listitem" class="o-growUpcomingEvents__listItem flex justify-between items-center">
        <div class="md:grid grid-cols-3 w-full py-9 md:py-12">
          <p class="o-growUpcomingEvents__date text-sm font-bold text-gray" style="{{#if ../Labels.TextColor}}color: {{../Labels.TextColor}};{{/if}}">
            {{event.Date}}
          </p>
          <p class="o-growUpcomingEvents__title text-sm text-gray uppercase" style="{{#if ../Labels.TextColor}}color: {{../Labels.TextColor}};{{/if}}">
            {{event.Title}}
          </p>
          <p class="o-growUpcomingEvents__location text-sm text-gray" style="{{#if ../Labels.TextColor}}color: {{../Labels.TextColor}};{{/if}}">
            {{event.Location}}
          </p>
        </div>
        <a href="{{event.Link.Url}}" target="{{event.Link.Target}}" class="o-growUpcomingEvents__link text-sm font-bold text-green" style="{{#if ../Labels.LinkTextColor}}color: {{../Labels.LinkTextColor}};{{/if}}">
          {{event.Link.Text}}
        </a>
      </li>
    {{/each}}
  </ul>

  <div class="o-growUpcomingEvents__seeAllEvents text-center mt-12 md:mt-20">
    <a href="{{Labels.CTA.Url}}" target="{{Labels.CTA.Target}}" class="o-growUpcomingEvents__seeAllEventsLink a-button border md:text-xs font-medium px-16 py-8 md:py-6" style="
                {{#if Labels.ButtonTextColor}}--buttonTextColor: {{Labels.ButtonTextColor}};{{/if}}
                {{#if Labels.ButtonBackgroundColor}}--buttonBackgroundColor: {{Labels.ButtonBackgroundColor}};{{/if}}
                {{#if Labels.ButtonBorderColor}}--buttonBorderColor: {{Labels.ButtonBorderColor}};{{/if}}
                {{#if Labels.ButtonHoverTextColor}}--buttonHoverTextColor: {{Labels.ButtonHoverTextColor}};{{/if}}
                {{#if Labels.ButtonHoverBackgroundColor}}--buttonHoverBackgroundColor: {{Labels.ButtonHoverBackgroundColor}};{{/if}}
                {{#if Labels.ButtonHoverBorderColor}}--buttonHoverBorderColor: {{Labels.ButtonHoverBorderColor}};{{/if}}
            ">
      {{Labels.CTA.Text}}
    </a>
  </div>
</div>