{{#OverlayCard}}
  <a class="m-overlayCard" href="{{Href}}" aria-label="{{AriaLabel}}" {{#if BgColor}}style="background-color:{{BgColor}};" {{/if}}>
    {{#if Images}}
      <div class="m-overlayCard__media">
        <div class="m-overlayCard__bg -img -desktop" style="background-image: url('{{Images.Desktop}}')" role="img" aria-label="{{Alt}}"></div>
        <div class="m-overlayCard__bg -img -mobile" style="background-image: url('{{Images.Mobile}}')" role="img" aria-label="{{Alt}}"></div>
      </div>
    {{/if}}

    <p class="m-overlayCard__content">
      <em class="m-overlayCard__title {{Title.Size}} {{Title.Weight}} {{Title.Transform}}" {{#if Title.Color}}style="color:{{Title.Color}};" {{/if}}>{{Title.Text}}</em>

      {{#if Description}}
        <span {{#if Description.Color}}style="color:{{Description.Color}};" {{/if}}>{{Description.Text}}</span>
      {{/if}}
    </p>
  </a>
{{/OverlayCard}}