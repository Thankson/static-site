<div class="o-categorySection {{CardSize}} {{IsCondensed}} {{IsPure}}" data-js="categoryCard" data-cardtype="{{CardType}}">
  {{#if CategoriesTitle}}
    <h2 id="featuredCategories" class="o-categorySection__title {{CenterTitle}}">
      {{CategoriesTitle}}
    </h2>
  {{/if}}
  <nav class="o-categorySection__nav" {{#if CategoriesTitle}}aria-labelledby="featuredCategories" {{/if}} {{#unless CategoriesTitle}}aria-label="{{AriaLabel}}" {{/unless}}>
    <ol class="o-categorySection__list">
      {{#if UseFlexLayout}}
        flex flex-wrap
      {{else}}
        {{AllowCustomRowLength}} grid-cols-{{ColsMobile}} md:grid-cols-{{ColsTablet}} lg:grid-cols-{{ColsDesktop}}
      {{/if}}">
      {{#each Categories}}
        <li class="o-categorySection__listItem -badgeSlot" data-testid="listItem-categorySectionItem">
          {{#> atoms-badge}}
            <div class="o-categorySection__widthControl">
              {{> molecules-cmn-category-card}}
            </div>
          {{/atoms-badge}}
        </li>

        </button>
      {{/each}}
    </ol>
  </nav>
</div>