<m-access-identify :handler="() => true" country="{{Country}}">
  <template v-slot:heading>
    {{{Title}}}
  </template>

  <template v-slot:description>
    {{{Description}}}
  </template>

  <template v-slot:email-phone-label>
    {{{EmailPhoneField.Label}}}
  </template>

  <template v-slot:email-phone-error>
    {{{EmailPhoneField.ErrorMessage}}}
  </template>

  <template v-slot:customer-id-description>
    {{{CustomerIdDescription}}}
  </template>

  <template v-slot:customer-id-label>
    {{{CustomerIdField.Label}}}
  </template>

  <template v-slot:customer-id-error>
    {{{CustomerIdField.ErrorMessage}}}
  </template>

  <template v-slot:api-error>
    {{{ApiErrorMessage}}}
  </template>
  <template v-slot:customer-id-error>
    {{{CustomerIdErrorMessage}}}
  </template>

  <template v-slot:button-label>
    {{Button.CTA}}
  </template>

  {{#if Note}}
    <template v-slot:note>
      {{{Note}}}
    </template>
  {{/if}}

  {{#if InfoLink.Text}}
    <template v-slot:info-link>
      <div class="inline-flex items-center">
        <a href="{{InfoLink.Href}}">
          {{InfoLink.Text}}
        </a>

        {{#if InfoLink.Tooltip}}
          <m-tooltip>
            {{InfoLink.Tooltip}}
          </m-tooltip>
        {{/if}}
      </div>
    </template>
  {{/if}}
</m-access-identify>