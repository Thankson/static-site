<shelf :visible="{{Visible}}" :show-heading="false">
  <div class="o-shelfCart">
    <h2 id="global-shelf-heading" class="o-shelfCart__heading {{#if Heading.Icon}}-hasIcon{{/if}}">
      {{#if Heading.Icon}}
        <a-icon class="o-shelfCart__icon">{{Heading.Icon}}</a-icon>
      {{/if}}
      <span role="text">
        {{Heading.Text}}

        {{#if Heading.Link}}
          <br />
          <span class="o-shelfCart__for">{{Heading.For}}</span>
        {{/if}}
      </span>

      {{#if Heading.Link}}
        <a href="{{Heading.Link.Url}}" class="o-shelfCart__link">{{{Heading.Link.Text}}}</a>
      {{/if}}
    </h2>

    {{#if Confirmation}}
      {{> molecules-shelf-confirm Confirmation}}

      {{#if Accessory}}
        {{> molecules-shelf-accessory Accessory}}
      {{/if}}
    {{else}}
      {{> molecules-product-info}}

      {{> molecules-refiner-image RefinerImage}}

      {{> molecules-cart-add-config AddToCart}}
    {{/if}}
  </div>
</shelf>