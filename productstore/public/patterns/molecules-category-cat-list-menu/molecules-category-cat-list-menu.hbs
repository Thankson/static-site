<div class="m-catListMenu">
  <h1 class="m-catListMenu__title -page">{{PageTitle}}</h1>
  {{#if NavTitle}}
    <nav class="m-catListMenu__nav">
      <h2 class="m-catListMenu__title -nav">{{NavTitle}}</h2>
      <ul class="m-catListMenu__list">
        {{#each Menu}}
          <li class="m-catListMenu__item  {{#if IsActive}}-active {{/if}}">
            <a href="{{Href}}" {{#if IsActive}} tabindex="-1" {{/if}} class="m-catListMenu__link">{{{Link}}}</a>
          </li>
        {{/each}}
      </ul>
    </nav>
  {{/if}}
</div>