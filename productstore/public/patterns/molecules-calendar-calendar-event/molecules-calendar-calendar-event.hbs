{{#CalendarEvent}}
  {{!-- Title Section --}}
  <p class="m-calendarEvent__title" {{#if Title.Color}} style="color: {{Title.Color}}" {{/if}}>
    {{Title.Text}}
  </p>

  {{!-- Link Section --}}
  <a href="{{Link.Url}}" class="m-calendarEvent__link" {{#if Link.Color}} style="color: {{Link.Color}}" {{/if}} data-testid="link-calendarEvent">
    {{Link.Text}} >
  </a>

  {{!-- Description Section --}}
  <p class="m-calendarEvent__desc" {{#if Description.Color}} style="color: {{Description.Color}}" {{/if}}>
    {{Description.Text}}
  </p>

  {{!-- Button Section (Conditional) --}}
  {{#if Button.Text}}
    <a href="{{Button.Url}}" class="m-calendarEvent__button" {{#if Button.Style}} style="background-color: {{Button.Style.BackgroundColor}};
                      color: {{Button.Style.TextColor}}" {{/if}} {{#if Button.Style.Download}} download {{/if}} data-testid="button-calendarEvent">
      {{Button.Text}}
    </a>
  {{/if}}
{{/CalendarEvent}}